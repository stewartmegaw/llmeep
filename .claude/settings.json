{
  "permissions": {
    "allow": [
      "Bash(./taskman/_tooling/tm)",
      "Bash(./taskman/_tooling/tm add *)",
      "Bash(./taskman/_tooling/tm go *)",
      "Bash(./taskman/_tooling/tm park *)",
      "Bash(./taskman/_tooling/tm done *)",
      "Bash(./taskman/_tooling/tm find *)",
      "Bash(./taskman/_tooling/tm standup)",
      "Bash(./taskman/_tooling/tm standup --period daily)",
      "Bash(./taskman/_tooling/tm standup --period workday)",
      "Bash(./taskman/_tooling/tm standup --period bidaily)",
      "Bash(./taskman/_tooling/tm standup --period weekly)",
      "Bash(./taskman/_tooling/tm standup --cron)",
      "Bash(./taskman/_tooling/tm check)",
      "Bash(./taskman/_tooling/tm check --quiet)",
      "Bash(./taskman/_tooling/tm check --staged *)",
      "Bash(./taskman/_tooling/tm check --notify)",

      "Bash(./notes/nm)",
      "Bash(./notes/nm add *)",
      "Bash(./notes/nm drop *)",
      "Bash(./notes/nm promote *)",
      "Bash(./notes/nm find *)",
      "Bash(./notes/nm prune)",
      "Bash(./notes/nm check)",
      "Bash(./notes/nm check --quiet)",

      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git rev-parse *)",
      "Bash(git check-ignore *)"
    ],
    "ask": [
      "Bash(./taskman/_tooling/tm reset *)",
      "Bash(./taskman/_tooling/tm check --notify --send)",
      "Bash(./taskman/_tooling/tm standup --send)",
      "Bash(./notes/nm prune --yes)"
    ]
  }
}
