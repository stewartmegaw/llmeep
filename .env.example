# Copy to .env and fill in. .env is gitignored — never commit real values.

# Telegram notification, sent by `tm done` (PLT-005).
# 1. message @BotFather, send /newbot, follow the prompts
# 2. add the bot to your group, send /start@yourbotname
# 3. run `taskman/tm check --telegram` — it will find the chat id
#
# Both must be set or notification is silently skipped. A failed send
# never fails a completion.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
