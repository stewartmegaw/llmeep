# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── Notifications ───────────────────────────────────────────────────────────
# `done` announces completions. The channel is deliberately external and
# replaceable: everything about how it presents itself — bot name, description,
# which room, who can see it — is configured in the service, not in this repo.
# Swapping channels is one line here and touches no records.
#
#   telegram | slack | webhook | none          (default: telegram)
NOTIFY=telegram

# NOTIFY=telegram
#   1. message @BotFather, send /newbot, follow the prompts
#   2. add the bot to your group, send /start@yourbotname
#   3. run `taskman/tm check --notify` — it will find the chat id
#      (add --send once configured to post a test message)
# The bot is outbound only: set its BotFather description to say so, and send
# /setcommands an empty list (DEC-007).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTIFY=slack — an incoming-webhook URL from a Slack app
SLACK_WEBHOOK_URL=

# NOTIFY=webhook — anything accepting a JSON POST of {"text": "..."}
NOTIFY_WEBHOOK_URL=

# ─── Standup ─────────────────────────────────────────────────────────────────
# `tm standup` reports what closed over a period. How long that period is:
#
#   daily | workday | bidaily | weekly          (default: weekly)
#
# `workday` is `daily` that skips weekends and covers them on Monday.
# The commit hook nudges once a period; it never sends. Only `--send` posts,
# and that reaches the whole team (DEC-015).
STANDUP_PERIOD=weekly

# Adding a channel is one function plus one dict entry in `taskman/tm` — see its
# `notify` section. There is no plugin loader, by design.
#
# A failed send never fails a completion.
