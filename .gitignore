# Local working memory — never committed, except its contract.
.notes/*
!.notes/README.md

# Agent tooling. Vendor adapters and the shared permission allowlist are committed
# (DEC-003); anything *.local.json never is. Same carve-out pattern as .notes/ above:
# ignore the directory, re-include the paths that belong in the repo. Add a pair here
# for each agent the team uses.
.claude/*
!.claude/skills/
!.claude/settings.json
*.local.json

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets. The Telegram bot token for `done` lives in .env (PLT-005).
# The platform/ subtree should add its own ignores rather than growing this file.
.env
.env.*
!.env.example
*.pem
*.key
