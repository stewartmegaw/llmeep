#!/usr/bin/env python3
"""adopt — install llmeep into an existing repository.

**The only way in** (`DEC-035`). Your code, your history and your README are
never touched: llmeep's machinery is copied in beside them and the record trees
are built empty, so nothing this repo records can arrive in yours.

Run it from the repo you want to adopt into:

    git clone --depth 1 <llmeep> /tmp/llmeep
    cd my-project && /tmp/llmeep/adopt

`tasks`, `notes` and `decisions` are ordinary words, so a repo may well have
one already. Everything llmeep owns therefore goes in a single directory —
`llmeep/` unless you say otherwise:

    /tmp/llmeep/adopt --into ops

That works because `tm` and `nm` derive their roots from where they sit
(`REPO = dirname(ROOT)`), so the install folder needs no configuration and can
be renamed afterwards. Only `.claude/` stays at the repo root, because that is
the only place an agent looks. Your own domain ontology lives wherever you keep
it; `tm ontology <path>` records where, and nothing is created for you.
"""

import json
import os
import re
import shutil
import subprocess
import sys
from datetime import date

# `adopt` sits at the repo root because it is the one file a stranger runs
# before any of this exists — pointing them a directory deep is friction on the
# only step that has to be effortless.
SRC = os.path.dirname(os.path.abspath(__file__))

# Where `--update` fetches from when this file is the installed copy rather than
# a checkout. Overridable so a fork, or a test, can point somewhere else.
DEFAULT_URL = "https://github.com/stewartmegaw/llmeep.git"

# The record trees. `platform/` is deliberately absent: an adopting repo already
# has its code, and it stays where it is.
TREES = ["tasks", "notes", "decisions", "ontology"]

# Of those, the ones that live under the install folder — which since `DEC-032`
# is all of them. `ontology/` used to sit at the repo root on the grounds that
# `ontology/domain/` was the adopter's, but the folder was three-quarters ours:
# principles, the core model and the domain guidance are all llmeep's, managed,
# and overwritten by `--update`. Claiming a repo-root `ontology/` to hold them
# put 464 lines of our documentation under a name that reads as the project's.
NESTED = ["tasks", "notes", "decisions", "ontology"]

# Everything llmeep owns goes in one folder, by default this one. A repo gets a
# single directory it can rename, rather than four it has to recognise.
DEFAULT_INTO = "llmeep"

# Agent adapters and the permission allowlist (DEC-003). These stay at the repo
# root even for a nested install, because that is the only place an agent looks.
AGENT = [".claude/skills/tm", ".claude/skills/nm", ".claude/settings.json"]

# The same adapters as files, for the manifest and for update — a directory has
# no checksum, and only these three carry paths that a nested install rewrites.
AGENT_FILES = [".claude/skills/tm/SKILL.md", ".claude/skills/nm/SKILL.md",
               ".claude/settings.json"]

# These follow the install instead. `tm` reads `.env` from its own REPO, which
# for `--into ops` is `ops/` — a root `.env.example` would document a file the
# tool never opens.
BESIDE = [".env.example", ".notes/README.md"]

IGNORES = [
    "# llmeep — local working memory, never committed except its contract.",
    "{p}.notes/*",
    "!{p}.notes/README.md",
    "{p}.env",
    "!{p}.env.example",
    # Feedback about llmeep itself (DEC-033) — about the tooling, not this repo,
    # so it never belongs in this repo's history or on its remote.
    "{p}feedback.md",
]


class Fail(Exception):
    pass


def rel(path, top):
    """Paths are reported as the adopter will see them — from their repo root."""
    return os.path.relpath(path, top) if top else path


def git(*args, cwd=None):
    out = subprocess.run(["git", *args], cwd=cwd or os.getcwd(),
                         capture_output=True, text=True)
    return out.stdout.strip()


def toplevel():
    top = git("rev-parse", "--show-toplevel")
    if not top:
        raise Fail("not inside a git repository — `git init` first")
    return top


def copy(src, dst, report, top=None):
    """Never overwrites. A path that already exists is reported and left alone,
    because the thing already there is the adopter's and this is their repo."""
    if os.path.exists(dst):
        report.append(("skip", rel(dst, top), "exists"))
        return False
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if os.path.isdir(src):
        shutil.copytree(src, dst)
    else:
        shutil.copy2(src, dst)
    report.append(("add", rel(dst, top), ""))
    return True


def append_ignores(top, prefix, report):
    """Appends only what is missing. An existing .gitignore is a file someone
    wrote on purpose; rewriting or reordering it would be a surprise."""
    path = os.path.join(top, ".gitignore")
    have = open(path).read().splitlines() if os.path.exists(path) else []
    want = [line.format(p=prefix) for line in IGNORES]
    missing = [w for w in want if w not in have and not w.startswith("#")]
    if not missing:
        report.append(("skip", ".gitignore", "already covers it"))
        return
    with open(path, "a") as fh:
        if have and have[-1].strip():
            fh.write("\n")
        fh.write(IGNORES[0] + "\n")
        for w in missing:
            fh.write(w + "\n")
    report.append(("edit", ".gitignore", f"{len(missing)} line(s) appended"))


def working_agreement(top, dest_root, into, report):
    """An adopter's `README.md` is already theirs and is not ours to touch, so
    the half of llmeep's README that explains the tooling is extracted to a file
    of its own. Extracted rather than maintained separately, because a second
    copy of a document is a copy that goes stale.

    Always at the repo root, even for a nested install. Inside the install it
    would need its markdown links relative to itself and its shell commands
    relative to the repo root — one file cannot be both, and rerooting it there
    broke every link in it (`PLT-yftg`).
    """
    src = os.path.join(SRC, "README.md")
    if not os.path.exists(src):
        return
    text = open(src).read()
    m = re.search(r"<!-- adopt:start.*?-->(.*?)<!-- adopt:end -->", text, re.S)
    if not m:       # markers gone: ship nothing rather than the wrong half
        report.append(("skip", "working agreement", "no adopt: markers in README"))
        return

    # `platform/` is llmeep's hole for a codebase. An adopting repo *is* the
    # codebase, so the bullet pointing at it would be a dead link and bad advice.
    body = re.sub(
        r"^\d+\. Put your codebase in .*$",
        "6. Your code stays where it is — in llmeep's terms this repo *is* the platform.",
        m.group(1).strip(), flags=re.M)
    body = "# How work is tracked here\n\n" + body + "\n"
    body += (
        "\n---\n\nInstalled by [llmeep](https://github.com/stewartmegaw/llmeep). "
        "This file describes the tooling only —\nwhat *this* project is belongs in "
        "`README.md`, and what it is made of belongs in a domain ontology of your own —\n"
        "optional, kept wherever you like, and pointed at with `tm ontology <path>`.\n"
    )

    if into:
        # Only the commands. Inside the install, a markdown link is relative to
        # this file and already correct, while a shell command is run from the
        # repo root and is not. Rerooting both is what broke every link last
        # time (`PLT-yftg`).
        body = reroot_code(body, into)
    dst = os.path.join(dest_root, working_name(into))
    if os.path.exists(dst):
        report.append(("skip", rel(dst, top), "exists"))
        return
    with open(dst, "w") as fh:
        fh.write(body)
    report.append(("add", rel(dst, top), "how the tooling works — link it from your README"))


MANIFEST = ".llmeep"
def working_name(into):
    """The working agreement lives with the install — `ops/README.md` for a
    nested one, which is where anyone opening `ops/` looks. A flat install has
    no directory of its own, and the repo root already has a README that belongs
    to the adopter, so there it needs a name of its own (`PLT-h6fq`)."""
    return "README.md" if into else "LLMEEP.md"


def version_of(src):
    """A clone of the default branch sits on a release tag, so the tag is the
    version. A clone of `main` is between releases and says so."""
    v = git("describe", "--tags", "--exact-match", cwd=src)
    return v or "unreleased"


def order(v):
    """Releases are `v1`, `v2`, … so ordering is one integer. Anything else —
    `unreleased`, a hand-set string — has no place in the sequence and returns
    None, which reads as "cannot compare" rather than as zero."""
    m = re.fullmatch(r"v(\d+)", v or "")
    return int(m.group(1)) if m else None


def sha(path):
    import hashlib
    with open(path, "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()[:16]


def managed(src):
    """What an update may replace: machinery, and the templates and model that
    ship with it. Records are absent by construction, and the one record that
    lives *inside* machinery — `history.tsv`, the permanent ledger of everything
    ever completed — is excluded by name in both subsystems.

    Returned relative to the install root, except `.claude/`, which sits at the
    repo root even for a nested install.
    """
    out = []
    for base in ("tasks/_tooling", "notes/_tooling"):
        root = src_of(base, src)
        for dirpath, _, names in os.walk(root):
            for n in sorted(names):
                if n == "history.tsv":
                    continue
                out.append(os.path.join(base, os.path.relpath(
                    os.path.join(dirpath, n), root)).replace(os.sep, "/"))
    out += ["ontology/principles.md", "ontology/core.md",
            "ontology/domain-ontology.md", "ontology/domain-template.md",
            "decisions/_template.md", ".env.example"]
    return sorted(p for p in out if os.path.isfile(src_of(p, src)))


def nested(rel_path):
    """Whether an install-relative path lives under the install folder.

    One thing sits outside it — `.claude/`, because that is the only place an
    agent looks. Everything llmeep ships goes in the one folder they can rename
    (`DEC-032`). The adopter's own domain ontology is not shipped at all: they
    keep it where they like and `.llmeep` records the path.
    """
    head = rel_path.split("/")[0]
    return head in NESTED or rel_path == ".env.example" or head == ".notes"


def src_of(rel_path, src):
    """Where a path sits in a clone of llmeep. The skeleton ships in the same
    shape it installs, so this is `dest_of` pointed at the source.

    Falls back to the flat position when the nested one is absent: `src` is not
    always a current release. It is a pre-`DEC-028` checkout when someone
    updates from an old clone, and an already-installed repo — flat or renamed —
    when `--update` reads what is there now.
    """
    if nested(rel_path):
        under = os.path.join(src, DEFAULT_INTO, rel_path)
        if os.path.exists(under) or not os.path.exists(os.path.join(src, rel_path)):
            return under
    return os.path.join(src, rel_path)


def dest_of(rel_path, top, dest_root):
    return os.path.join(dest_root if nested(rel_path) else top, rel_path)


BEGIN = "# llmeep:manifest — rewritten by --update; do not edit"
END = "# llmeep:manifest-end"


def read_manifest(path):
    """Parsed out of the file without executing it. A manifest that could only
    be read by running the script would make inspecting an install and trusting
    it the same act."""
    with open(path) as fh:
        text = fh.read()
    m = re.search(rf"{re.escape(BEGIN)}\n(.*?)\n{re.escape(END)}", text, re.S)
    if m:
        return json.loads("\n".join(l.lstrip("# ") for l in m.group(1).split("\n")))
    try:
        # v14–v17 wrote `.llmeep` as plain JSON, before it became the script
        # itself. Those installs still have to be updatable, and the update that
        # reads this is the one that replaces the file.
        return json.loads(text)
    except json.JSONDecodeError:
        raise Fail(f"{os.path.basename(path)} carries no manifest — is it a copy of `adopt`?")


def render_manifest(doc):
    body = json.dumps(doc, indent=2, sort_keys=True)
    return BEGIN + "\n" + "\n".join("# " + l for l in body.split("\n")) + "\n" + END


def install_self(top, dest_root, into, report, kept=(), ontology=None):
    """`.llmeep` is this script, carrying what it installed as a header. One
    file in the adopted repo is both the tooling entry point and the record of
    what is there, and `./.llmeep --update` needs no clone step first.

    Always at the repo root: it is run as `./.llmeep`, and a script you have to
    find is one nobody runs (`PLT-ty47`).
    """
    # For a file we wrote, record what we put there — post-reroot, since a
    # nested install rewrites paths and the destination legitimately differs
    # from the source.
    #
    # For a file we **kept** because it was the adopter's, record the *source*
    # checksum instead. Recording the destination would certify their file as
    # ours, so the next update would classify it unmodified and replace it:
    # protected once, silently overwritten the second time. Found on a real
    # repo whose `ontology/core.md` predated its adoption by two weeks
    # (`PLT-s9ea`).
    files = {}
    for r in managed(SRC) + AGENT_FILES + [working_name(into)]:
        d = dest_of(r, top, dest_root)
        if not os.path.isfile(d):
            continue
        src = src_of(r, SRC)
        files[r] = sha(src) if r in kept and os.path.isfile(src) else sha(d)
    doc = {"version": version_of(SRC), "on": date.today().isoformat(),
           "into": into, "files": files}
    # Where the adopter keeps their own domain ontology, set by `tm ontology`
    # and never by us. It has to survive an update that rewrites this block
    # wholesale, or every update silently unsets it and `tm` starts asking
    # again for an answer already given.
    if ontology is not None:
        doc["ontology"] = ontology

    with open(os.path.join(SRC, "adopt")) as fh:
        script = fh.read()
    script = re.sub(rf"{re.escape(BEGIN)}\n.*?\n{re.escape(END)}\n", "", script, flags=re.S)
    marker = '"""\n\nimport json'
    script = script.replace(marker, '"""\n\n' + render_manifest(doc) + "\n\nimport json", 1)

    path = os.path.join(top, MANIFEST)
    with open(path, "w") as fh:
        fh.write(script)
    os.chmod(path, 0o755)
    report.append(("add", rel(path, top),
                   f"{doc['version']}, {len(files)} managed file(s) — `./{MANIFEST} --update`"))


def find_install(top):
    """`.llmeep` sits at the repo root and says in its header whether the trees
    are nested. Read rather than searched for: the adopter should not have to
    remember what they called the directory."""
    path = os.path.join(top, MANIFEST)
    if not os.path.exists(path):
        raise Fail(
            f"no {MANIFEST} here — this repo was not installed by `adopt`, or predates it.\n"
            "  Copy tasks/_tooling/ and notes/_tooling/ over by hand this once; from the\n"
            "  next version `--update` takes over."
        )
    into = read_manifest(path).get("into", "")
    return (os.path.join(top, into) if into else top), into


def reroot_code(text, into):
    """Rewrite paths inside fenced code blocks only. Everything a reader clicks
    stays relative to the file it is in; everything they paste into a shell gets
    the install prefix."""
    out, fenced = [], False
    for line in text.split("\n"):
        if line.startswith("```"):
            fenced = not fenced
            out.append(line)
            continue
        out.append(reroot_text(line, into) if fenced else line)
    return "\n".join(out)


def reroot_text(text, into):
    """Rewrite llmeep's own paths for a nested install. One function, because
    every file that documents a path needs the same treatment, and each caller
    that reimplemented it became a bug (`PLT-wxr5`, `PLT-yftg`)."""
    # Since `DEC-028` the skeleton ships already rooted at `llmeep/`, so for any
    # other folder name this is a **rename**, not a prefix. The patterns below
    # only match a bare `tasks/`, which a shipped file no longer contains — miss
    # this and `--into ops` silently leaves every path pointing at `llmeep/`,
    # which is an allowlist matching nothing and a skill naming a missing file.
    if into != DEFAULT_INTO:
        text = re.sub(rf"(?<![\w/-])(\./)?{re.escape(DEFAULT_INTO)}/",
                      lambda m: (m.group(1) or "") + (f"{into}/" if into else ""), text)

    # And the bare form, for text written before the move or by hand. Only
    # when there is a prefix to add: with `into=""` these would splice an
    # empty segment and turn `./tasks/` into `.//tasks/`.
    if not into:
        return text
    trees = "|".join(NESTED)
    # `./tasks/…` first — the general pattern refuses to match after a dot,
    # which is what keeps it off `.notes/` and off already-rooted paths.
    text = re.sub(rf"\./({trees})/", rf"./{into}/\1/", text)
    text = re.sub(rf"(?<![\w./-])({trees})/", rf"{into}/\1/", text)
    return re.sub(r"(?<![\w/-])\.notes/", f"{into}/.notes/", text)


def reroot(top, into, report):
    """Everything llmeep ships writes its own paths from the repo root, because
    that is where they normally are. Nested, every one of them is wrong:

    - `settings.json` allowlists `Bash(./tasks/_tooling/tm …)`, which matches
      nothing, so an adopter is prompted for every command they were meant to
      stop being prompted for.
    - both `SKILL.md` files tell an agent to run `tasks/_tooling/tm`, which is
      not there — the agent follows the instructions and the command fails.

    Reported by a repo that adopted with `--into ops` and had to fix all three
    by hand (`PLT-wxr5`).
    """
    files = [os.path.join(top, ".claude", "settings.json"),
             os.path.join(top, ".claude", "skills", "tm", "SKILL.md"),
             os.path.join(top, ".claude", "skills", "nm", "SKILL.md")]
    for path in files:
        if not os.path.exists(path):
            continue
        with open(path) as fh:
            text = fh.read()
        before = text
        text = reroot_text(text, into)
        if text == before:
            continue
        with open(path, "w") as fh:
            fh.write(text)
        n = sum(1 for a, b in zip(before.split("\n"), text.split("\n")) if a != b)
        report.append(("edit", rel(path, top), f"{n} line(s) rerooted under {into}/"))


# The empty state of every record llmeep keeps, written rather than copied.
#
# This is the one place `adopt` knows the *shape* of a record rather than just
# its path, which is a coupling worth naming: `tm` and `nm` own these formats and
# this has to agree with them. The guard is `selftest`, which adopts and then
# drives the real tools against the result — a board with the wrong headings
# fails there immediately, because `tm add` has nowhere to put a line.
#
# The alternative was what came before: copy llmeep's records in and delete them
# again. That kept one writer of the format, and in exchange every release had
# to be cut clean and every new record type joined a delete list. This is the
# cheaper coupling (`DEC-035`).
BOARD = "# {ledger}\n\n## in progress\n\n\n## prioritised\n\n\n## backlog\n\n\n## recent\n"
TASK_HISTORY = "#date\tid\tledger\ttitle\twho\n"
NOTE_HISTORY = "#date\tid\ttext\tsrc\ttask\n"
ARCHIVE = "# notes\n"

# Directories with nothing in them yet. Git carries no empty directory, so each
# needs a `.gitkeep` or the adopter's first commit quietly loses it.
KEEP_DIRS = ["notes/raw", "tasks/platform/tasks", "tasks/business/tasks"]


def empty_records(root, report, top=None):
    """Build the record trees empty. Never overwrites: a re-run, or an adopter
    who already has a board, keeps what is there."""
    made = 0
    for ledger in ("platform", "business"):
        made += write_once(os.path.join(root, "tasks", ledger, "board.md"),
                           BOARD.format(ledger=ledger))
    made += write_once(os.path.join(root, "tasks", "_tooling", "history.tsv"), TASK_HISTORY)
    made += write_once(os.path.join(root, "notes", "_tooling", "history.tsv"), NOTE_HISTORY)
    made += write_once(os.path.join(root, "notes", "notes.md"), ARCHIVE)
    for d in KEEP_DIRS:
        made += write_once(os.path.join(root, d, ".gitkeep"), "")
    report.append(("add", rel(os.path.join(root, "tasks"), top),
                   f"{made} empty record file(s) — the boards are yours from the start"))


def write_once(path, body):
    if os.path.exists(path):
        return 0
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(body)
    return 1


def is_clone(path):
    """A full llmeep checkout: the trees to copy from, and the installer beside
    them. An adopted repo has the trees too, which is why the presence of
    `adopt` is the part that distinguishes them.

    Both layouts count. A release from `DEC-028` onward keeps the trees under
    `llmeep/`; everything before it kept them at the root. This runs against a
    clone of a version it may know nothing about, so it must recognise a
    checkout it has never seen rather than assume the current shape.
    """
    tooling = any(os.path.isdir(os.path.join(path, p, "tasks", "_tooling"))
                  for p in (DEFAULT_INTO, ""))
    return tooling and os.path.isfile(os.path.join(path, "adopt"))


def installed_copy():
    """True when running as the `.llmeep` installed in a repo, rather than as
    `adopt` in a checkout. The filename is the distinction, and it is exact —
    an adopted repo has `tasks/_tooling` too, so the trees prove nothing."""
    return os.path.basename(os.path.abspath(__file__)) == MANIFEST


def newest_release(url):
    """The highest `vN` tag the remote has, asked for by name.

    `latest` used to mean *the default branch*, which worked only while that
    branch was a cut release. `DEC-035` made a version a tag on `main`, and
    `DEC-037`-era `main` moved to being the default — so "latest" quietly became
    "whatever was committed most recently", and an install updating between tags
    was told its source was unreleased and refused (`PLT-qe3p`).

    A tag is what a release *is* now, so a release is what this asks for.
    """
    out = subprocess.run(["git", "ls-remote", "--tags", url],
                         capture_output=True, text=True)
    if out.returncode != 0:
        raise Fail(f"could not reach {url}\n  {out.stderr.strip().splitlines()[-1] if out.stderr.strip() else ''}")
    tags = {ref.rsplit("/", 1)[-1].removesuffix("^{}")
            for line in out.stdout.split("\n") if "\t" in line
            for ref in [line.split("\t")[1]]}
    versions = sorted((v for v in tags if order(v) is not None), key=order)
    if not versions:
        raise Fail(f"no release tags at {url} — nothing to update to")
    return versions[-1]


def fetch_release(want, report):
    """Clone the release into a temp directory and hand over to *its* `adopt`.

    The newer version knows how to install itself; this copy only knows how the
    world looked when it was written. Delegating is why an update can change the
    update process.

    The first network access in llmeep, so it says what it is fetching, and
    `--dry-run` never reaches here.
    """
    import tempfile
    url = os.environ.get("LLMEEP_URL") or DEFAULT_URL
    if want == "latest":
        want = newest_release(url)
    tmp = tempfile.mkdtemp(prefix="llmeep-")
    print(f"  fetching {want} from {url}")
    args = ["clone", "--depth", "1", "--branch", want]
    out = subprocess.run(["git", *args, url, tmp], capture_output=True, text=True)
    if out.returncode != 0 or not is_clone(tmp):
        raise Fail(f"could not fetch {url}\n  {out.stderr.strip().splitlines()[-1] if out.stderr.strip() else ''}")
    return tmp


# What a pre-`DEC-032` install has at its repo root, mapped to where the file
# now lives under the install folder. `domain/README.md` and `domain/_template.md`
# were llmeep's guidance about writing an ontology, never anyone's ontology, so
# they move with the rest rather than being left behind as the adopter's.
ONTOLOGY_WAS = {
    "ontology/principles.md": "ontology/principles.md",
    "ontology/core.md": "ontology/core.md",
    "ontology/domain/README.md": "ontology/domain-ontology.md",
    "ontology/domain/_template.md": "ontology/domain-template.md",
}


def migrate_ontology(top, dest_root, into, report, recorded, dry=False):
    """`DEC-032` moved `ontology/` under the install folder. An install from
    before it has llmeep's four files at the repo root, possibly alongside the
    adopter's own domain files in `ontology/domain/`.

    Ours are **deleted, not moved** — the copy loop installs fresh ones under
    `llmeep/ontology/` moments later, so moving them would only race that. But
    deleting is only safe for a file we actually shipped, which is what the
    manifest checksums are for: a root `ontology/core.md` the adopter has since
    edited, or that predated the adoption entirely, is theirs and stays put
    (`PLT-s9ea` is that exact case).

    Anything of theirs left in `ontology/domain/` stays where it is and becomes
    the recorded ontology path. Nobody's domain model gets moved by an update.
    """
    moved, kept, left = [], [], None
    # Two possible homes, because two layouts predate this one. Post-`DEC-028`
    # installs put `ontology/` at the repo root; the ones before it nested it,
    # which is where it belongs again — but under the old *names*, so those
    # still have to be swept or `domain/README.md` lingers beside the
    # `domain-ontology.md` that replaces it.
    bases = [top] if dest_root == top else [top, dest_root]
    for base in bases:
        for old, new in ONTOLOGY_WAS.items():
            path = os.path.join(base, old)
            if not os.path.isfile(path):
                continue
            here = rel(path, top)
            src = src_of(new, SRC)
            # Ours if it matches what we recorded at install, or failing that
            # (an install too old to have recorded it) what the source ships
            # today. Anything else is the adopter's and is not ours to delete.
            ours = recorded.get(old) == sha(path) or (
                os.path.isfile(src) and sha(src) == sha(path))
            (moved if ours else kept).append(here)
            if ours and not dry:
                os.remove(path)

    for base in bases:
        ont = os.path.join(base, "ontology")
        if not os.path.isdir(ont):
            continue
        theirs = [p for p in glob_tree(ont)
                  if os.path.relpath(p, base) not in ONTOLOGY_WAS
                  and os.path.basename(p) != ".gitkeep"]
        if theirs and left is None:
            # Their files are the reason the directory survives. Record the
            # deepest common home rather than guessing per file.
            left = rel(os.path.join(ont, "domain"), top) if os.path.isdir(
                os.path.join(ont, "domain")) else rel(ont, top)
        elif not theirs and not dry and base == top:
            # Empty once ours are gone, and only at the repo root — the install
            # folder's copy is about to be reinstalled into. Prune it, or the
            # adopter is left with a directory that means nothing.
            shutil.rmtree(ont, ignore_errors=True)

    for p in moved:
        report.append(("move", p, "llmeep's — reinstalled under the install folder"))
    for p in kept:
        report.append(("skip", p, "changed since install — left where it is"))
    if left:
        report.append(("edit", left, "your ontology — recorded in .llmeep, not moved"))
    return left


def glob_tree(root):
    out = []
    for dirpath, _, names in os.walk(root):
        out += [os.path.join(dirpath, n) for n in names]
    return out


def do_update(top, force, dry):
    """Replace the machinery, never the records.

    Three things make this trustworthy rather than merely convenient. The
    manifest's checksums separate a file we shipped from one the adopter has
    since edited, so local work is reported and skipped instead of clobbered.
    `history.tsv` is excluded by name in both subsystems, because it is a record
    living inside machinery and losing it would be unrecoverable. And a nested
    install is rerooted again afterwards, or the update quietly undoes the fix
    that made nesting work at all (`PLT-wxr5`).
    """
    dest_root, into = find_install(top)
    man = read_manifest(os.path.join(top, MANIFEST))
    have = man.get("version", "?")

    # The installed copy has nothing to copy from. Rather than diff against
    # itself, it fetches the release and lets that version do the work.
    if installed_copy():
        if dry:
            target = os.environ.get("LLMEEP_VERSION", "latest")
            print(f"\n  installed: {have}")
            print(f"  would fetch {target} and compare — nothing fetched with --dry-run\n")
            return 0
        clone = fetch_release(os.environ.get("LLMEEP_VERSION", "latest"), None)
        cmd = [sys.executable, os.path.join(clone, "adopt"), "--update"]
        return subprocess.run(cmd + (["--force"] if force else []), cwd=top).returncode

    want = version_of(SRC)
    if have == want and not force:
        raise Fail(f"already on {have} — `--force` to reinstall it anyway")
    if order(want) is not None and order(have) is not None and order(want) < order(have) \
            and not force:
        raise Fail(f"{want} is older than the installed {have} — `--force` to go back anyway")
    # An unreleased clone is somewhere between versions and cannot be placed in
    # the sequence. Onto a released install that is a step sideways at best, and
    # it would rewrite the manifest so the install no longer knows what it is.
    if order(want) is None and order(have) is not None and not force:
        raise Fail(
            f"this clone is {want}; the install is on {have}. Check out a release tag\n"
            "  in the clone, or `--force` if you mean to run unreleased code."
        )

    recorded = man.get("files", {})

    # Before the comparison: it clears llmeep's files out of a repo-root
    # `ontology/`, and the copy loop below is what puts them back under the
    # install folder. A dry run reports the move without performing it.
    report = []
    ontology = man.get("ontology")
    found = migrate_ontology(top, dest_root, into, report, recorded, dry)
    # Only when they have not already said where theirs lives. An update must
    # not overwrite an answer the adopter gave.
    if found and ontology is None:
        ontology = found
    if dry and report:
        print()
        for kind, path, note in report:
            print(f"  would {'keep' if kind == 'skip' else 'move'} {path}  — {note}")
        report = []
    fresh, modified, added = [], [], []
    for r in managed(SRC) + AGENT_FILES:
        d = dest_of(r, top, dest_root)
        if not os.path.isfile(d):
            added.append(r)
        elif r in recorded and sha(d) != recorded[r]:
            modified.append(r)
        else:
            fresh.append(r)

    print(f"\n  {have} → {want}\n")
    for r in sorted(added):
        print(f"  + {r}")
    for r in sorted(modified):
        print(f"  ! {r}  changed since install — {'replacing' if force else 'kept'}")
    print(f"  ~ {len(fresh)} unmodified file(s) replaced")
    if dry:
        print("\n  dry run. drop --dry-run to apply.")
        return 0

    for r in fresh + added + (modified if force else []):
        d = dest_of(r, top, dest_root)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        shutil.copy2(src_of(r, SRC), d)
    reroot(top, into, report)

    # Generated, so it cannot be copied — but it carries the commands and the
    # update instructions, and an install that never refreshes it keeps whatever
    # the version it adopted happened to say (`PLT-yftg`).
    name = working_name(into)
    wa, rec = os.path.join(dest_root, name), recorded.get(name)
    if os.path.isfile(wa) and rec and sha(wa) != rec and not force:
        print(f"  ! {name}  changed since install — kept")
    else:
        if os.path.isfile(wa):
            os.remove(wa)
        working_agreement(top, dest_root, into, report)

    # `IGNORES` grows with the machinery — `feedback.md` arrived after repos had
    # already adopted (`DEC-033`). Without this an existing install gets the file
    # and not the rule for it, and the first thing that happens is the adopter
    # committing our feedback into their history. Appends only what is missing,
    # so a run that has nothing to add says so and touches nothing.
    append_ignores(top, f"{into}/" if into else "", report)
    install_self(top, dest_root, into, report,
                 kept=() if force else modified, ontology=ontology)

    for kind, path, note in report:
        print(f"  {'~' if kind == 'edit' else '+' if kind != 'skip' else '!'} {path}  {note}")
    print(f"\n  ✓ updated to {want}. Records untouched — boards, notes, history, decisions.")
    if modified and not force:
        print(f"    {len(modified)} file(s) you had changed were kept. Diff them against")
        print(f"    {SRC} and re-run with --force when you are ready.")
    print("    Restart your agent session so it re-reads the skills.")
    return 0


def main(argv):
    # Nesting is the default, not the escape hatch. A repo gets one directory
    # it can recognise and rename, instead of four ordinary words it has to.
    into = DEFAULT_INTO
    if "--into" in argv:
        i = argv.index("--into")
        try:
            into = argv[i + 1].strip("/")
        except IndexError:
            raise Fail("--into needs a directory name")
    dry = "--dry-run" in argv

    top = toplevel()
    if "--update" in argv:
        return do_update(top, "--force" in argv, dry)
    if "--version" in argv:
        print(f"\n  {read_manifest(os.path.join(top, MANIFEST)).get('version', '?')}\n")
        return 0
    # Only meaningful when installing: the installed copy of this script lives
    # at the root of the repo it manages, so SRC == top is normal for --update.
    if os.path.abspath(SRC) == os.path.abspath(top):
        raise Fail("run this from the repo you are adopting into, not from llmeep itself")

    dest_root = os.path.join(top, into) if into else top
    prefix = f"{into}/" if into else ""

    # Every tree is nested now, so every clash is one nesting fixes. A repo that
    # already has its own `ontology/` is the case this used to wave through and
    # is now simply not a conflict: we no longer put anything at the repo root
    # for it to collide with (`DEC-032`).
    clashes = [t for t in TREES
               if nested(t) and os.path.exists(dest_of(t, top, dest_root))]
    if clashes and not into:
        raise Fail(
            f"{', '.join(clashes)} already exist(s) here.\n"
            "  Pick another folder:  adopt --into ops\n"
            "  `tm` and `nm` find their own roots, so nothing else changes."
        )
    if clashes:
        raise Fail(f"{', '.join(clashes)} already exist under {into}/ — pick another name")

    if dry:
        print(f"  would install into {rel(dest_root, top) if into else 'the repo root'}")
        for t in TREES:
            print(f"    + {prefix if nested(t) else ''}{t}/")
        for a in AGENT:
            print(f"    + {a}")
        for b in BESIDE:
            print(f"    + {prefix if nested(b) else ''}{b}")
        print(f"    + {prefix + 'README.md' if into else 'LLMEEP.md'}  (how the tooling works)")
        print("    ~ .gitignore, git config core.hooksPath")
        return 0

    report = []
    # `copy` never overwrites, so anything already there is the adopter's and is
    # left alone. Those paths must not be recorded as ours.
    #
    # **Machinery only, and the records are built empty.** This used to copy the
    # whole of `tasks/`, `notes/`, `decisions/` and `ontology/` — llmeep's own
    # boards, history and decisions included — and then delete them again by
    # shelling out to `tm reset --yes --all`. It worked, and it meant every
    # release had to be cut clean as a second line of defence, and every new
    # record type was one someone had to remember to add to the delete list.
    # Nothing llmeep records can reach an adopter now, because nothing llmeep
    # records is copied (`DEC-035`).
    skipped = set()
    for r in managed(SRC):
        if not copy(src_of(r, SRC), dest_of(r, top, dest_root), report, top):
            skipped.add(r)
    for a in AGENT:
        src = os.path.join(SRC, a)
        # Skips were recorded for the trees and not for these, so an adopter who
        # already had `.claude/settings.json` got it kept by `copy` and then
        # recorded under *their* checksum — `PLT-s9ea` exactly, on the one path
        # still installed at the repo root, where a pre-existing file is most
        # likely of all. The ontology case that found it originally is gone;
        # this one was always there behind it.
        if os.path.exists(src) and not copy(src, os.path.join(top, a), report, top):
            skipped.add(a)

    for b in BESIDE:
        if not copy(src_of(b, SRC), dest_of(b, top, dest_root), report, top):
            skipped.add(b)
    reroot(top, into, report)
    working_agreement(top, dest_root, into, report)
    append_ignores(top, prefix, report)
    empty_records(dest_root, report, top)
    # A managed file is the adopter's if it was skipped itself, if its tree was,
    # or if any directory we skipped contains it — `.claude/skills/tm` is a
    # skipped directory whose `SKILL.md` is what the manifest actually lists.
    kept = {r for r in managed(SRC) + AGENT_FILES
            if r in skipped or r.split("/")[0] in skipped
            or any(r.startswith(s + "/") for s in skipped)}
    install_self(top, dest_root, into, report, kept=kept)

    hooks = os.path.relpath(os.path.join(dest_root, "tasks", "_tooling", "hooks"), top)
    git("config", "core.hooksPath", hooks, cwd=top)
    report.append(("edit", "core.hooksPath", hooks))

    width = max(len(p) for _, p, _ in report)
    print()
    for kind, path, note in report:
        mark = {"add": "+", "skip": "!", "edit": "~"}[kind]
        print(f"  {mark} {path:<{width}}  {note}")
    print(f"\n  ✓ adopted. Your code, history and README are untouched.")
    # Skills are read when a session starts, so the one that just arrived is
    # invisible to the agent that ran this.
    print("    Restart your agent session first — it reads its skills at startup,")
    print("    so the two just installed are not loaded yet.")
    print(f"\n    Then:      {prefix}tasks/_tooling/tm add <the first thing you need to do>")
    # Phrased at the human and marked optional on purpose. This used to read
    # "And read: ... — describe your project there", which an agent parsing this
    # output took as its next instruction and acted on, writing a whole domain
    # ontology nobody asked for (`PLT-eb7v`). Nothing here requires one.
    print("\n    Optional, whenever you want it — not now, and not for the tooling to work:")
    print(f"    {prefix}ontology/domain-ontology.md explains writing one for your own project.")
    print(f"    Already have one? {prefix}tasks/_tooling/tm ontology <path> records where.")
    # Off, and described rather than offered. Anything here phrased as a step
    # gets performed by the agent reading this output (`PLT-eb7v`), and this one
    # would spend the adopter's tokens on every commit thereafter.
    print(f"\n    Off unless you switch it on, in {prefix}.env.example: FEEDBACK=on asks your")
    print("    agent to note what llmeep itself got wrong, after each commit. It costs")
    print("    tokens and sends nothing — the notes are a local, gitignored file.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        print(f"\n  ! {e}\n", file=sys.stderr)
        sys.exit(1)
