# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── Notifications ───────────────────────────────────────────────────────────
# `done` announces completions. The channel is deliberately external and
# replaceable: everything about how it presents itself — bot name, description,
# which room, who can see it — is configured in the service, not in this repo.
# Swapping channels is one line here and touches no records.
#
#   telegram (currently supported) | slack | webhook | none          (default: telegram)
NOTIFY=telegram

# NOTIFY=telegram
#   1. message @BotFather, send /newbot, follow the prompts
#   2. add the bot to your group, send /start@yourbotname
#   3. run `tasks/_tooling/tm check --notify` — it will find the chat id
#      (add --send once configured to post a test message)
# A group id is negative and a supergroup's starts -100; that is not a typo.
# `check --notify` lists every chat the bot can see, configured or not, so it
# is also how you move from a direct message to a team group later. Telegram
# silently changes a group's id when it becomes a supergroup — if sending stops
# working, re-run the check and take the new one.
# The bot is outbound only: set its BotFather description to say so, and send
# /setcommands an empty list (DEC-007).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Standup ─────────────────────────────────────────────────────────────────
# `tm standup` reports what closed over a period, and is the one thing here
# that pushes rather than waits to be asked. Nothing triggers it from inside the
# repo. Usually it is a person: whoever runs the call types
# `tm standup` and reads it out (DEC-017).
#
#   tasks/_tooling/tm standup --cron    # the line to schedule, if you want it unattended
#
#   daily | workday | bidaily | weekly          (default: daily)
#
# `workday` is `daily` that skips weekends and covers them on Monday.
# Unattended reporting is `tasks/_tooling/blueprints/standup.sh` — read it first.
STANDUP_PERIOD=daily
STANDUP_AT=09:00

# Adding a channel is one function plus one dict entry in `tasks/_tooling/tm` — see its
# `notify` section. There is no plugin loader, by design.
#
# A failed send never fails a completion.

# ─── Feedback to llmeep ──────────────────────────────────────────────────────
# Off, and it stays off unless you put it on. Turning it on asks your agent to
# spend a short review pass after each commit on one question: did llmeep's own
# machinery get in the way, and is something missing that its principles imply?
# What it notices goes in `feedback.md` beside this file.
#
#   tasks/_tooling/tm feedback           # what has been drafted
#   tasks/_tooling/tm feedback <text>    # add one by hand
#
# **This costs tokens** — a review pass per commit, on your account. That is the
# whole reason it is opt-in rather than on by default (DEC-033).
#
# **Nothing is ever sent.** `feedback.md` is gitignored and local: no network, no
# credentials, and nothing leaves this machine unless you send it yourself.
# Drafts are about llmeep and never about your project — no code, no domain
# terms, no task titles — so what you read is safe to pass on as it stands.
#
# This file is per-checkout and gitignored, so switching it on is your call and
# never spends a teammate's tokens.
#
#   on | off                                                      (default: off)
FEEDBACK=off

# ─── Code review ─────────────────────────────────────────────────────────────
# Off, and it stays off unless you list reviewers. When on, `tm review` has up
# to two LLMs read the commit before it is pushed; each returns bullet points
# where it is not satisfied, and a commit is only marked reviewed when every
# reviewer that answered has nothing left to say (DEC-039).
#
#   tasks/_tooling/tm review                     # review HEAD
#   tasks/_tooling/tm review --reply "<answer>"  # argue a point back
#
# **This spends your own API budget**, per commit, on whichever keys you set
# below — and it sends the commit's diff to them. The coding agent already holds
# your whole repository, so a reviewer reading the same material under your own
# key is the same context in the same hands; it is still your call to make.
#
# The `pre-push` hook refuses to push a commit with no valid mark, so the gate
# is not something an agent can forget. `git push --no-verify` still gets past
# it, and is recorded like any other bypass.
#
# Two reviewers is the design. Any objection from either counts — a second
# reviewer is there to catch more, not to overrule the first.
#
#   openai | xai, comma-separated                        (default: off)
# REVIEW=openai,xai
#
# Both speak the OpenAI chat shape, so `_BASE` reaches anything that copied it —
# Groq, OpenRouter, a local server. The model is required rather than defaulted:
# names move faster than this file, and a wrong default bills you for a call
# that was never going to work.
# REVIEW_OPENAI_KEY=
# REVIEW_OPENAI_MODEL=
# REVIEW_OPENAI_BASE=https://api.openai.com/v1
# REVIEW_XAI_KEY=
# REVIEW_XAI_MODEL=
# REVIEW_XAI_BASE=https://api.x.ai/v1
