#!/usr/bin/env python3
"""nm — notes. See notes/_tooling/ontology.md for the model.

Six commands: add, drop, promote, prune, find, notes.

`nm` is mechanical. Reading a transcript and deciding what matters is judgement,
which belongs to the agent (principle 7) — so there is no `process` command.
Processing is: the agent reads a capture, calls `nm add` for what it keeps, then
`nm drop` for the file. `nm` never parses a transcript.
"""

import json
import os
import re
import secrets
import subprocess
import sys
from datetime import date, timedelta

# HERE is the machinery and the ledger it appends to; ROOT is what a person
# reads; REPO is the tree around both. Mirrors tm exactly (DEC-019).
HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.environ.get("NM_ROOT") or os.path.dirname(HERE)
REPO = os.path.dirname(ROOT)
ARCHIVE = os.path.join(ROOT, "notes.md")
HISTORY = os.path.join(HERE, "history.tsv")
RAW = os.path.join(ROOT, "raw")
# One name, in one place. The rename from `taskman/` to `tasks/` swept the
# string `taskman/` and missed every literal written as a path *segment* — so
# `nm` went on pointing at a directory that no longer existed, and only
# `promote` said so out loud (`PLT-x9wv`).
TASKS = os.path.join(REPO, "tasks")
TM = os.path.join(TASKS, "_tooling", "tm")
TASK_HISTORY = os.path.join(TASKS, "_tooling", "history.tsv")

WINDOW = 200        # what `prune` narrows notes.md to; nothing else enforces it
RAW_STALE_DAYS = 30  # a capture unprocessed this long is probably never going to be
MAX_HITS = 3
TEXT_MAX = 200      # a note is a line, not a paragraph

ALPHABET = "23456789abcdefghjkmnpqrstuvwxyz"  # no 0/1/i/l/o
ID_LEN = 4
ID_RE = re.compile(r"^NTE-\S+$")
TAG_RE = re.compile(r"^(src:\S+|task:(PLT|BUS)-\S+)$")


class Fail(Exception):
    pass


# ---------------------------------------------------------------------- model


class Note:
    def __init__(self, nid, text, tags=None, on=None):
        self.id = nid
        self.text = text
        self.tags = tags or []
        self.on = on

    @property
    def source(self):
        for t in self.tags:
            if t.startswith("src:"):
                return t[4:]
        return None

    @property
    def task(self):
        for t in self.tags:
            if t.startswith("task:"):
                return t[5:]
        return None

    def render(self):
        line = f"{self.id:<9}{self.text}"
        if self.tags:
            # ljust plus an explicit separator: a long line gets no padding, and
            # without this the tag is concatenated onto the text.
            line = line.ljust(64) + "  " + "  ".join(self.tags)
        return line.rstrip()


class Archive:
    """The window: notes grouped under date headings, newest first.

    Read whole, so it stays bounded. Everything ever captured is in history.tsv,
    which is only ever grepped — the same split taskman uses for the board.
    """

    def __init__(self):
        self.notes = []
        if not os.path.exists(ARCHIVE):
            return
        on = None
        for raw in open(ARCHIVE):
            line = raw.rstrip("\n")
            m = re.match(r"^##\s+(\d{4}-\d{2}-\d{2})\s*$", line)
            if m:
                on = m.group(1)
                continue
            if not line.strip() or line.startswith("#"):
                continue
            tokens = line.split()
            nid = tokens.pop(0)
            tags = []
            while tokens and TAG_RE.match(tokens[-1]):
                tags.insert(0, tokens.pop())
            self.notes.append(Note(nid, " ".join(tokens), tags, on))

    def all_ids(self):
        return {n.id for n in self.notes}

    def find(self, nid):
        for n in self.notes:
            if n.id.lower() == nid.lower():
                return n
        return None

    def narrow(self, keep):
        """Drop the oldest beyond `keep`, returning them. Only `prune` calls
        this — narrowing is a deliberate act, never a side effect of a write."""
        self.notes.sort(key=lambda n: n.on, reverse=True)
        dropped, self.notes = self.notes[keep:], self.notes[:keep]
        return dropped

    def save(self):
        """Sorts, never truncates. Narrowing the window is `prune` — a named,
        dry-by-default act — not a side effect of adding a note. This used to
        drop the oldest entry on every write, silently, which also made
        `prune`'s window branch and `check`'s window guard unreachable."""
        self.notes.sort(key=lambda n: n.on, reverse=True)
        out, on = ["# notes"], None
        for note in self.notes:
            if note.on != on:
                on = note.on
                out += ["", f"## {on}", ""]
            out.append(note.render())
        with open(ARCHIVE, "w") as fh:
            fh.write("\n".join(out).rstrip() + "\n")


def history_rows():
    if not os.path.exists(HISTORY):
        return []
    rows = []
    for line in open(HISTORY):
        if line.startswith("#") or not line.strip():
            continue
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 3:
            rows.append(dict(zip(("date", "id", "text", "src", "task"), parts)))
    return rows


def history_append(note):
    """Append-only. Pruning the window loses nothing."""
    new = not os.path.exists(HISTORY)
    with open(HISTORY, "a") as fh:
        if new:
            fh.write("#date\tid\ttext\tsrc\ttask\n")
        fh.write("\t".join([note.on, note.id, note.text,
                            note.source or "", note.task or ""]) + "\n")


def history_relink(nid, task):
    """The one place history is rewritten: a promoted note gains its task id.

    Append-only protects against losing a capture. A link added later is new
    information about an existing row, not a second row — and a `find` that
    could not show where a note went would be missing the useful half.
    """
    if not os.path.exists(HISTORY):
        return
    out = []
    for line in open(HISTORY):
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 2 and parts[1] == nid:
            parts += [""] * (5 - len(parts))
            parts[4] = task
            line = "\t".join(parts) + "\n"
        out.append(line)
    with open(HISTORY, "w") as fh:
        fh.writelines(out)


# ----------------------------------------------------------------- utilities


def new_id(taken):
    for _ in range(100):
        nid = "NTE-" + "".join(secrets.choice(ALPHABET) for _ in range(ID_LEN))
        if nid not in taken:
            return nid
    raise Fail("could not allocate a free id")


def known_ids():
    return Archive().all_ids() | {r["id"] for r in history_rows()}


def slug(text):
    text = re.sub(r"[^a-z0-9._-]+", "-", (text or "").strip().lower())
    return text.strip("-") or None


def take_flag(args, flag):
    if flag not in args:
        return None, args
    i = args.index(flag)
    return (args[i + 1] if i + 1 < len(args) else None), args[:i] + args[i + 2:]


def summarise(text, width=60):
    text = re.sub(r"[*`_]", "", text).strip()
    return text if len(text) <= width else text[: width - 1].rstrip() + "…"


def search(term, limit=MAX_HITS):
    words = [w for w in re.split(r"\W+", term.lower()) if len(w) > 2]
    if not words:
        return []
    scored = []
    for row in history_rows():
        hay = f"{row['id']} {row['text']} {row.get('src', '')}".lower()
        hits = sum(1 for w in words if w in hay)
        if hits:
            scored.append((hits, row["date"], row))
    scored.sort(key=lambda s: (-s[0], s[1]))
    return [r for _, _, r in scored[:limit]]


# ------------------------------------------------------------------ commands


def cmd_add(args):
    """Capture to the archive. Reads stdin when given no text, so distilling a
    call is one call: several notes, one source, one command."""
    src, args = take_flag(args, "--from")
    text = " ".join(args).strip()
    lines = [text] if text else [l.strip() for l in sys.stdin.read().splitlines()]
    lines = [l for l in lines if l and not l.startswith("#")]
    if not lines:
        raise Fail("usage: nm add [--from <src>] <text...>   (or pipe lines on stdin)")

    archive, taken, added = Archive(), known_ids(), []
    today = date.today().isoformat()
    for line in lines:
        if len(line) > TEXT_MAX:
            raise Fail(f"note is {len(line)} characters; the cap is {TEXT_MAX}. "
                       "A note is a line — put the detail in a task or a decision.")
        note = Note(new_id(taken), line, [f"src:{slug(src)}"] if src else [], today)
        taken.add(note.id)
        archive.notes.insert(0, note)
        history_append(note)
        added.append(note)
    archive.save()
    for note in added:
        print(f"  {note.id}  {note.text}")
    plural = "note" if len(added) == 1 else "notes"
    print(f"\n  {len(added)} {plural}" + (f" · src:{slug(src)}" if src else ""))
    # Exclude everything just written, or a batch reports its own siblings.
    show_related(" ".join(n.text for n in added), exclude={n.id for n in added})


def cmd_drop(args):
    """Remove a note or a capture. One verb, because `drop` already means
    *get rid of this* on the task board and a second word for the same
    intention is a second thing to remember.

    Which one is not a guess — an `NTE-` id and a filename cannot be mistaken
    for each other, so this is dispatch on shape, not inference of intent
    (principle 7). Anything ambiguous would need two commands.

    Takes the history row with it. A note that should not exist should not
    exist anywhere, and the parallel is exact: dropping a task line leaves
    nothing in taskman's ledger either, because only `done` writes there. Git
    keeps both."""
    if not args:
        raise Fail("usage: nm drop <NTE-id | file>")
    target = args[0]

    if re.match(r"^NTE-", target, re.I):
        archive = Archive()
        note = archive.find(target)
        if not note:
            raise Fail(f"no note {target} in the archive — `nm find` if it was already dropped")
        if note.task:
            print(f"  ~ {note.id} points at {note.task}; the task is unaffected")
        archive.notes = [n for n in archive.notes if n is not note]
        archive.save()
        history_drop({note.id})
        print(f"  dropped {note.id}  {note.text}")
        print(f"  git keeps it — `git log -S {note.id}`")
        return

    name = os.path.basename(target)
    path = os.path.join(RAW, name)
    if not os.path.exists(path):
        raise Fail(f"no capture at raw/{name}")
    os.remove(path)
    print(f"  dropped raw/{name} — git keeps it")


def capture_names():
    """Pending captures. `raw/` is committed and survives its own emptiness by
    a `.gitkeep`, so a dotfile here is scaffolding, never a capture."""
    if not os.path.isdir(RAW):
        return []
    return [
        n for n in sorted(os.listdir(RAW))
        if not n.startswith(".") and os.path.isfile(os.path.join(RAW, n))
    ]


# What a person is shown. `WINDOW` is what is stored, and the two are bounded
# separately and by different numbers on purpose: an agent reads 200 lines
# cheaply and a person scanning a phone does not.
RENDER_LIST = 20

# The last line of a rendered archive, on the same grounds as the board's: the
# verbs work in conversation and someone who did not design them cannot know
# that (`PLT-gx39`).
NOTES_HINT = "*promote · drop · find · discuss*"


def notes_sections(limit=RENDER_LIST, keep_source=False):
    """The window as `(heading, [line, …])`, dates newest first, plus what the
    render has to say around it: how many captures are waiting, and how many
    notes the limit hid.

    **This was prose in the nm skill until `PLT-8fmt`** — the same fourth
    renderer `DEC-050` took out of the board and the standup, and the same three
    objections: it reached one agent, it could not be tested, and it was doing
    real work by hand. A `grep` of the task ledger for a `✓` is not formatting.
    """
    archive = Archive()
    archive.notes.sort(key=lambda n: n.on or "", reverse=True)
    shown = archive.notes if limit is None else archive.notes[:limit]
    shipped = shipped_tasks() if any(n.task for n in shown) else set()
    sections, on = [], None
    for note in shown:
        if note.on != on:
            on = note.on
            sections.append((on, []))
        sections[-1][1].append(note_line(note, shipped, keep_source))
    hidden = len(archive.notes) - len(shown)
    return sections, len(capture_names()), hidden


def note_line(note, shipped, keep_source=False):
    """`**id**  text`, then where it went.

    **Never a link.** A relative markdown link to a repo file renders as
    "unsupported link" over Remote Control — tested 2026-08-01, and captured as a
    note about itself.

    A promoted note carries its task, and a `✓` once that task has shipped: the
    note is then awaiting removal rather than hidden, because `prune` deletes it
    outright and the task now carries the record (`DEC-023`).

    `src:` is dropped unless asked for. Provenance matters when searching, not
    when reading.
    """
    line = f"**{note.id}**  {note.text}"
    if note.task:
        line += f" → {note.task}"
        if note.task in shipped:
            line += " ✓"
    if keep_source and note.source:
        line += f"  ·  from {note.source}"
    return line


def render_notes(sections, waiting, hidden):
    """Markdown for the conversation the agent is in. Never a code block: that
    scrolls sideways on a phone, which is where this is read.

    **A blank line after every `---`.** Without one the terminal renderer
    swallows the rule into the line below and prints a literal `---NTE-shmy` —
    tested 2026-08-02.
    """
    out = []
    if waiting:
        # First, because it is the actionable part and it is invisible in
        # `notes.md` — nothing in the archive says a capture is waiting.
        out += [f"{waiting} capture{'s' if waiting != 1 else ''} waiting in raw/", ""]
    if not sections:
        return "\n".join(out + ["nothing captured yet"])
    for on, body in sections:
        out += [f"### {on}", "---", ""]
        for line in body:
            out += [line, ""]
    if hidden:
        out += [f"…and {hidden} older — `nm find <term>`, or ask for all", ""]
    return "\n".join(out + ["---", "", NOTES_HINT])


def render_notes_plain(sections, waiting, hidden):
    """A terminal, where markdown is noise. Same content, same order, same
    bound: `cat notes/notes.md` is still there for the file as it is stored."""
    out = []
    if waiting:
        out.append(f"  {waiting} capture(s) waiting in raw/")
    for on, body in sections:
        out += ["", f"  {on}"]
        out += [f"    {re.sub(r'[*]{2}', '', line)}" for line in body]
    if not sections:
        out.append("  nothing captured yet")
    elif hidden:
        out.append(f"\n  …and {hidden} older — nm find <term>, or --all")
    return "\n".join(out)


def notes_export():
    """The window as data, for something that is not a person.

    Same reasoning as `tm board --json` (`PLT-6yjz`): an interface reaches into
    the repo rather than holding state of its own, so it needs the notes in a
    shape it can parse — and parsing `notes.md` at the far end would be a second
    implementation of the model, drifting the first time a tag is added.

    **No display bound here.** `RENDER_LIST` is what a person is shown on a
    phone; an interface has its own screen and decides for itself (`PLT-pudy`).
    """
    archive = Archive()
    archive.notes.sort(key=lambda n: n.on or "", reverse=True)
    shipped = shipped_tasks()
    return {
        "notes": [{"id": n.id, "text": n.text, "on": n.on, "source": n.source,
                   "task": n.task, "shipped": bool(n.task and n.task in shipped)}
                  for n in archive.notes],
        "waiting": len(capture_names()),
    }


def cmd_notes(args):
    """**The window, for the person on the other end of the conversation.**
    Bare it prints for a terminal; `--chat` renders markdown to pass on as it is,
    which mirrors `tm board` exactly (`DEC-019`, `DEC-050`).

    `--all` lifts the display bound, which is the "or ask for all" the render
    offers. `--src` keeps provenance on the line.
    """
    chat, all_of_it = "--chat" in args, "--all" in args
    keep_source = "--src" in args
    if [a for a in args if a not in ("--chat", "--all", "--src", "--json")]:
        raise Fail("usage: nm notes [--chat | --json] [--all] [--src]")
    if "--json" in args:
        if chat:
            raise Fail("--json and --chat are two different readers")
        print(json.dumps(notes_export(), indent=2))
        return 0
    sections, waiting, hidden = notes_sections(
        limit=None if all_of_it else RENDER_LIST, keep_source=keep_source)
    render = render_notes if chat else render_notes_plain
    print(render(sections, waiting, hidden))
    return 0


def cmd_unpromote(args):
    """**Undo a promotion, keeping the note.**

    The gap an adopter found by hitting it: `drop` on a promoted task leaves the
    note pointing at something that no longer exists, and the only ways out were
    destroying the note with its history row or editing a record by hand — which
    principle 2 names as the thing that breaks references. A command that makes
    a dangling pointer and leaves none to repair it is the machinery
    contradicting its own principle, so the missing verb is the defect
    (`PLT-f5e9`).

    The note goes back to being a note. It can be promoted again, which is the
    honest state: somebody decided the idea was not work after all.
    """
    if not args:
        raise Fail("usage: nm unpromote <NTE-id>")
    nid = args[0]
    archive = Archive()
    note = archive.find(nid)
    if not note:
        raise Fail(f"no note {nid}")
    if not note.task:
        raise Fail(f"{note.id} is not a task — nothing to undo")
    was = note.task
    note.tags = [t for t in note.tags if not t.startswith("task:")]
    archive.save()
    history_relink(note.id, "")   # the column is cleared, not removed
    print(f"\n  {note.id}  {note.text}")
    print(f"  no longer {was} — a note again, and promotable\n")
    return 0


def cmd_promote(args):
    """A note becomes a task. The note stays until that task ships — a task can
    be parked or dropped, and until it lands the note is the only record the
    idea existed. `prune` removes it afterwards (DEC-023)."""
    if not args:
        raise Fail("usage: nm promote <NTE-id> [-b] [-n] [-f <who>]")
    nid, rest = args[0], args[1:]
    archive = Archive()
    note = archive.find(nid)
    if not note:
        raise Fail(f"no note {nid} in the archive (pruned? try `nm find`)")
    if note.task:
        raise Fail(f"{note.id} is already {note.task}")
    if not os.access(TM, os.X_OK):
        raise Fail(f"cannot run {TM}")
    out = subprocess.run([TM, "add", "--id", *rest, note.text],
                         capture_output=True, text=True)
    tid = out.stdout.strip().splitlines()[-1].strip() if out.stdout.strip() else ""
    if out.returncode != 0 or not re.match(r"^(PLT|BUS)-\S+$", tid):
        raise Fail(f"tm add failed: {(out.stderr or out.stdout).strip()}")
    note.tags.append(f"task:{tid}")
    archive.save()
    history_relink(note.id, tid)
    print(f"  {note.id}  {note.text}")
    print(f"  → {tid}")


def shipped_tasks():
    """Task ids that have completed. Reads the task ledger directly — `check`
    already does, and the alternative is taskman calling into notes on `done`,
    which couples the two in the direction that actually matters."""
    path = TASK_HISTORY
    if not os.path.exists(path):
        return set()
    out = set()
    for line in open(path):
        if line.startswith("#") or not line.strip():
            continue
        parts = line.split("\t")
        if len(parts) >= 2:
            out.add(parts[1])
    return out


def history_drop(ids):
    """The only deletion from an append-only file, and it is deliberate: the
    rows removed describe ideas that became tasks that shipped, so taskman's
    ledger already holds the durable record. Rewrites in place rather than
    marking, because a tombstone is a second record of the thing we are
    removing precisely for being a second record."""
    kept = [l for l in open(HISTORY).read().splitlines()
            if not any(l.startswith(i + "\t") or f"\t{i}\t" in l for i in ids)]
    with open(HISTORY, "w") as fh:
        fh.write("\n".join(kept) + "\n")


def cmd_prune(args):
    """Dry unless --yes. Pruning captures discards work nobody did; pruning the
    archive normally only narrows the window, since history.tsv keeps
    everything — a shipped note is the exception and goes entirely.

    A note whose task shipped is removed outright, history row included. Once
    the task has a permanent row of its own, the note is a second record of one
    idea — and keeping it costs a per-commit check that its link still resolves.
    Git holds the deleted row like any other; `git log -S <id>` finds it
    (DEC-023)."""
    apply = "--yes" in args
    cutoff = date.today() - timedelta(days=RAW_STALE_DAYS)
    stale = []
    for name in capture_names():
        path = os.path.join(RAW, name)
        m = re.match(r"^(\d{4}-\d{2}-\d{2})", name)
        when = m.group(1) if m else date.fromtimestamp(
            os.path.getmtime(path)).isoformat()
        if when < cutoff.isoformat():
            stale.append((name, when))

    archive = Archive()
    done = shipped_tasks()
    # Scans history, not just the window. A note can fall out of the window
    # while its task is still open, and would then never be reachable again —
    # leaving one idea recorded in two ledgers forever, which is the whole
    # thing DEC-023 removes.
    shipped_ids = {r["id"] for r in history_rows() if r.get("task") in done and r.get("task")}
    shipped = [n for n in archive.notes if n.id in shipped_ids]
    over = max(0, len(archive.notes) - len(shipped) - WINDOW)

    if not stale and not over and not shipped_ids:
        print(f"  nothing to prune — {len(archive.notes)} note(s), "
              f"{len(capture_names())} capture(s)")
        return
    for name, when in stale:
        print(f"  raw/{name}  unprocessed since {when}")
    for note in shipped:
        print(f"  {note.id}  shipped as {note.task} — removed, git keeps it")
    for orphan in sorted(shipped_ids - {n.id for n in shipped}):
        print(f"  {orphan}  shipped, already out of the window — history row removed")
    if over:
        print(f"  archive is {len(archive.notes)}; {over} would leave the window "
              "(history.tsv keeps them)")
    if not apply:
        print("\n  dry run. pass --yes to apply.")
        return
    for name, _ in stale:
        os.remove(os.path.join(RAW, name))
    archive.notes = [n for n in archive.notes if n not in shipped]
    if over:
        archive.narrow(WINDOW)   # these stay in history.tsv; only the window narrows
    archive.save()
    if shipped_ids:
        history_drop(shipped_ids)
    print(f"\n  ✓ pruned {len(stale)} capture(s), "
          f"{len(shipped_ids)} shipped, {over} over the window")


def cmd_find(args):
    if not args:
        raise Fail("usage: nm find <term>")
    hits = search(" ".join(args), limit=50)
    if not hits:
        print("  nothing in history")
        return
    for row in hits:
        line = f"  {row['id']:<9}{summarise(row['text'], 44):<46}{row['date']}"
        if row.get("src"):
            line += f"  src:{row['src']}"
        if row.get("task"):
            line += f"  {row['task']}"
        print(line)


def show_related(term, exclude=()):
    """Automatic retrieval (principle 6): capturing something already captured
    should surface it. Silent when empty, capped at 3."""
    hits = [h for h in search(term, limit=MAX_HITS + len(exclude))
            if h["id"] not in exclude][:MAX_HITS]
    if not hits:
        return
    print("\n  related notes")
    for row in hits:
        print(f"    {row['id']:<9}{summarise(row['text'], 44):<46}{row['date']}")


def cmd_check(args):
    errors = []
    archive, seen = Archive(), {}
    for row in history_rows():
        if row["id"] in seen:
            errors.append(f"{row['id']} appears twice in history.tsv")
        seen[row["id"]] = True
    dates = [n.on for n in archive.notes]
    if dates != sorted(dates, reverse=True):
        errors.append("notes.md is not newest-first")
    warnings = []
    # Notes lifts away from tasks by design, so an absent ledger is legitimate.
    # A *present* one we cannot see is not: `promote` fails loudly, but `prune`
    # and the shipped ✓ read an empty set and do nothing at all, which is how a
    # broken path survived a rename and eleven releases (`PLT-x9wv`).
    if os.path.isdir(TASKS) and not os.path.exists(TM):
        errors.append(f"{os.path.relpath(TASKS, REPO)}/ is here but its tooling is not at "
                      f"{os.path.relpath(TM, REPO)} — promote, prune and shipped-note "
                      "marking all depend on it")
    if len(archive.notes) > WINDOW:
        warnings.append(f"notes.md holds {len(archive.notes)}, the window is {WINDOW} "
                        "— `nm prune` to narrow it")
    known_tasks = set()
    for ledger in ("platform", "business"):
        board = os.path.join(TASKS, ledger, "board.md")
        if os.path.exists(board):
            known_tasks |= set(re.findall(r"\b(?:PLT|BUS)-\S+", open(board).read()))
    th = TASK_HISTORY
    if os.path.exists(th):
        known_tasks |= set(re.findall(r"\b(?:PLT|BUS)-\S+", open(th).read()))
    for note in archive.notes:
        if not ID_RE.match(note.id):
            errors.append(f"malformed note id {note.id!r}")
        if len(note.text) > TEXT_MAX:
            errors.append(f"{note.id}: note is {len(note.text)} characters, "
                          f"the cap is {TEXT_MAX}")
        if note.task and note.task not in known_tasks:
            # **A warning, not an error** (`PLT-f5e9`). The model says a note
            # outlives the task it became — "a task can be parked or dropped,
            # and the note is the only record the idea existed" — and `drop`
            # writes nothing anywhere (`DEC-024`), so the id it leaves behind
            # points at nothing by design. The checker called that an error, and
            # because `pre-commit` runs it, a drop performed days earlier in
            # another checkout blocked *every* commit in the repository.
            #
            # Named with its repair rather than merely tolerated: a pointer to
            # nothing never ships, so `prune` never clears it and the note sits
            # there looking promoted for good.
            warnings.append(f"{note.id} points at {note.task}, which no longer exists "
                            f"— `nm unpromote {note.id}` to put it back")
    for w in warnings:
        print(f"  ~ {w}")
    for e in errors:
        print(f"  ! {e}", file=sys.stderr)
    if errors:
        return 1
    if "--quiet" not in args and not warnings:
        print("  ✓ notes consistent")
    return 0


USAGE = """nm — notes

  nm add [--from <src>] <text...>   capture to the archive; reads stdin for batch
  nm drop <NTE-id | file>           remove a note, or a processed capture
  nm promote <NTE-id> [-b] [-n]     turn a note into a task
  nm unpromote <NTE-id>             undo that, keeping the note
  nm prune [--yes]                  bound raw/ and the archive
  nm notes [--chat] [--all]         the window; --chat renders it to pass on as it is
  nm notes --json                   the window as data, for an interface
  nm find <term>                    search every note ever captured

  nm check                          validate records; used by hooks and CI

`cat notes/notes.md` is the file as stored. Distilling is the agent's job, not a command.
Model: notes/_tooling/ontology.md"""


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    commands = {"add": cmd_add, "drop": cmd_drop, "promote": cmd_promote,
                "unpromote": cmd_unpromote,
                "prune": cmd_prune, "find": cmd_find, "check": cmd_check,
                "notes": cmd_notes}
    cmd = commands.get(argv[0])
    if not cmd:
        print(f"unknown command: {argv[0]}\n\n{USAGE}", file=sys.stderr)
        return 2
    try:
        return cmd(argv[1:]) or 0
    except Fail as exc:
        print(f"  ! {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
