MARKER = "UNADOPTED.md"


def marker_path():
    return os.path.join(ROOT, MARKER)


def skeleton_nudge():
    """Present until `tm reset` runs. Without it, a new project silently
    inherits the skeleton's task history and `find` returns someone else's
    work as its own prior art.

    A named markdown file rather than a dotfile: this is the one marker whose
    entire audience is a human who has just cloned something and does not yet
    know what any of it is. Nothing parses it, so it costs nothing to make it
    say so in full."""
    if os.path.exists(marker_path()):
        print(f"\n  ~ these are the skeleton's own records — see tasks/{MARKER},"
              "\n    or run `tm reset` if you cloned this to start a project")


def cmd_reset(args):
    """Destructive, so it is a dry run unless --yes. Clears what is specific to
    a project; keeps what explains the design."""
    boards, sidecars = [], []
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail:
            continue
        n = len(board.in_progress) + len(board.open) + len(board.recent)
        boards.append((board, n))
        sidecars += sidecar_all(ledger)
    rows = len(history_rows())
    decisions = []
    dec_dir = os.path.join(REPO, "decisions")
    if "--all" in args and os.path.isdir(dec_dir):
        decisions = [
            os.path.join(dec_dir, f) for f in sorted(os.listdir(dec_dir))
            if f.startswith("DEC-")
        ]
        # The stubs go with the records they stand for. A cloner
        # inheriting llmeep's pruned-decision index is the same fault as
        # inheriting its decisions, one indirection along.
        if os.path.exists(dec_history()):
            decisions.append(dec_history())

    print("  clears:")
    for board, n in boards:
        print(f"    {board.ledger} board — {n} task line(s)")
    print(f"    history.tsv — {rows} row(s)")
    print(f"    sidecars — {len(sidecars)} item(s)")
    if decisions:
        print(f"    decisions — {len(decisions)} file(s)")
    print("\n  keeps: ontology, principles, templates, tm, hooks" +
          ("" if decisions else ", decisions"))
    if not decisions:
        print("    (decisions explain why the design is what it is — `--all` to drop them too)")

    if "--yes" not in args:
        print("\n  dry run. pass --yes to apply.")
        return

    for board, _ in boards:
        board.in_progress, board.prioritised, board.backlog, board.recent = [], [], [], []
        board.save()
    with open(HISTORY, "w") as fh:
        fh.write("#date\tid\tledger\ttitle\twho\n")
    for path in sidecars + decisions:
        shutil.rmtree(path) if os.path.isdir(path) else os.remove(path)
    if os.path.exists(marker_path()):
        os.remove(marker_path())
    print("\n  ✓ reset. the boards are yours now.")


# --------------------------------------------------------------------- checks
#
# `check` is not a fifth skill — it mutates nothing. It is the validator the
# hooks and CI both call, so the same rules run everywhere (PLT-001).


class Report:
    def __init__(self):
        self.errors, self.warnings = [], []

    def error(self, msg):
        self.errors.append(msg)

    def warn(self, msg):
        self.warnings.append(msg)

    def emit(self):
        for w in self.warnings:
            print(f"  ~ {w}")
        for e in self.errors:
            print(f"  ! {e}", file=sys.stderr)
        return 1 if self.errors else 0


def git(*args, cwd=None):
    try:
        out = subprocess.run(
            ["git", *args], cwd=cwd or REPO,
            capture_output=True, text=True, timeout=10,
        )
        return out.stdout if out.returncode == 0 else ""
    except Exception:
        return ""


def check_boards(rep):
    seen = {}
    for row in history_rows():
        if row["id"] in seen:
            rep.error(f"{row['id']} appears twice in history.tsv")
        seen[row["id"]] = "history"
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail as exc:
            rep.error(str(exc))
            continue
        seen_active = {}
        for task in board.in_progress:
            owner = task.assignee or "(unassigned)"
            if owner in seen_active:
                rep.error(f"{ledger}: {owner} has {seen_active[owner]} and {task.id} "
                          "both in progress — WIP is 1 per person")
            seen_active[owner] = task.id
        if len(board.recent) > WINDOW:
            rep.error(f"{ledger}: recent holds {len(board.recent)}, max is {WINDOW}")
        dates = [t.done_on for t in board.recent]
        if dates != sorted(dates, reverse=True):
            rep.error(f"{ledger}: recent is not newest-first")
        live = {t.id for t in board.in_progress + board.open}
        for task in board.in_progress + board.open + board.recent:
            if not ID_RE.match(task.id):
                rep.error(f"{ledger}: malformed id {task.id!r}")
            where = seen.get(task.id)
            if where and not (where == "history" and task in board.recent):
                rep.error(
                    f"{task.id} appears twice on the {ledger} board"
                    if where.endswith("board")
                    else f"{task.id} is on the {ledger} board but already in {where}"
                )
            elif where is None:
                seen[task.id] = f"{ledger} board"
            b = task.blocker
            if b and b not in live and b not in seen:
                rep.error(f"{task.id} is blocked by {b}, which does not exist")
            if task.has_detail and not sidecar_path(ledger, task.id):
                rep.error(f"{task.id} is tagged detail but has no sidecar")
            # A tag only stays a tag while it matches. `filed:tomorrow` fails
            # TAG_RE, so `_split_tags` leaves it on the end of the title and the
            # board still looks fine — the one failure mode of adding a dated
            # tag, and invisible without this.
            if re.search(r"\bfiled:\S*", task.title):
                rep.error(f"{task.id} has a malformed filed: date in its title — "
                          "the tag must read filed:YYYY-MM-DD to parse as one")


def check_sidecars(rep):
    for ledger in LEDGERS:
        d = os.path.join(ROOT, ledger, "tasks")
        if not os.path.isdir(d):
            continue
        try:
            board = Board(ledger)
        except Fail:
            continue
        tagged = {t.id for t in board.in_progress + board.open if t.has_detail}
        closed = {t.id for t in board.recent} | {r["id"] for r in history_rows()}
        for name in sorted(os.listdir(d)):
            if name.startswith("_") or name.startswith("."):
                continue
            path = os.path.join(d, name)
            if not (os.path.isdir(path) or name.endswith(".md")):
                continue
            parts = name.split("-")
            if len(parts) < 2:
                continue
            tid = f"{parts[0]}-{parts[1]}"
            doc = sidecar_doc(path)
            if doc is None:
                rep.error(f"{name}/: folder sidecar has no README.md — nothing to read, "
                          "and acceptance criteria cannot be found")
            else:
                with open(doc) as fh:
                    head = fh.read(400)
                m = re.search(r"^id:\s*(\S+)", head, re.M)
                if m and m.group(1) != tid:
                    rep.error(f"{name}: frontmatter id {m.group(1)} does not match its name")
            if tid not in tagged and tid not in closed:
                rep.error(f"{name}: no board line tagged detail, and not completed")

        for task in board.in_progress + board.open + board.recent:
            errors, warnings = title_problems(task.title)
            for e in errors:
                rep.error(f"{task.id}: {e}")
            for w in warnings:
                rep.warn(f"{task.id}: {w}")


def frontmatter_field(text, field):
    m = re.search(rf"^{field}:\s*(.*)$", text, re.M)
    return m.group(1).strip() if m else ""


# ------------------------------------------------------------------- decisions
#
# `find` searches history — "have we tried this?". `why` searches decisions —
# "why is it like this?". Different question, different corpus, so a separate
# verb rather than a flag on `find`: overloading it would make one command
# return two shapes of answer depending on an argument.

DEC_ID_RE = re.compile(r"\bDEC-\d+\b")


def dec_history(root=None):
    """Where pruned decisions leave their stub. Same shape and same argument as
    `history.tsv` for tasks: the record leaves the working tree, the fact that
    it existed does not. Without it `why` would stop finding anything pruned,
    which is the premise of `PLT-cajd` undone one release later."""
    return os.path.join(root or REPO, "decisions", "history.tsv")


DEC_HISTORY_HEADER = "#decided\tid\ttitle\tpruned\tnote\n"


def pruned_decisions(root=None):
    path = dec_history(root)
    if not os.path.exists(path):
        return []
    out = []
    with open(path) as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            parts += [""] * (5 - len(parts))
            out.append(dict(zip(("decided", "id", "title", "pruned", "note"), parts[:5])))
    return out


def decision_paths(root=None):
    d = os.path.join(root or REPO, "decisions")
    if not os.path.isdir(d):
        return []
    return [os.path.join(d, f) for f in sorted(os.listdir(d))
            if f.endswith(".md") and not f.startswith("_")]


def decision(path):
    with open(path) as fh:
        text = fh.read()
    return {
        "id": frontmatter_field(text, "id"),
        "title": frontmatter_field(text, "title"),
        # A record with no status is accepted; only supersession writes one.
        "status": frontmatter_field(text, "status") or "accepted",
        "decided": frontmatter_field(text, "decided"),
        "supersedes": _dec_list(text, "supersedes"),
        "superseded_by": _dec_list(text, "superseded_by"),
        "relates_to": _dec_list(text, "relates_to"),
        "path": path,
        "text": text,
    }


def decisions(root=None):
    return [decision(p) for p in decision_paths(root)]


def cited_by(did, all_decs):
    """Which *other* decisions name this one, and how. Supersession is already
    checked both ways by `check_decision_graph`; this is the reading of it, and
    the thing pruning will need — a record nothing cites is a different
    proposition from one three others build on (`PLT-4jg2`)."""
    out = []
    for d in all_decs:
        if d["id"] == did:
            continue
        for field in ("supersedes", "superseded_by", "relates_to"):
            if did in d[field]:
                out.append((d["id"], field))
    return out


def cited_outside(did, root=None):
    """Where the wider tree names it — ontology, README, skills, code comments.
    A decision cited only by other decisions is talking to itself; one cited
    from the machinery is load-bearing."""
    top = (git("rev-parse", "--show-toplevel") or (root or REPO)).strip()
    out = git("grep", "-l", "--", did, cwd=top)
    return sorted(p for p in out.split("\n")
                  if p and not p.startswith("decisions/")
                  and "/decisions/" not in p)


def dec_line(d):
    mark = {"accepted": " ", "superseded": "~", "proposed": "?"}.get(d["status"], "?")
    return f"{mark} {d['id']}  {d['decided'] or '':<10}  {d['title']}"


def stale_decisions(all_decs):
    """Records nothing references — not records that are superseded.

    Those are close to opposite. Measured on 2026-08-04: the two most-cited
    records in the corpus, `DEC-001` at 21 references and `DEC-006` at 12, are
    both superseded, while every record with no references at all was
    `accepted`. Pruning by status would have deleted the foundations and kept
    the orphans.

    **Unreferenced is necessary, not sufficient.** Whether the subject still
    exists is a judgement no tool can make, so this proposes and a person
    disposes (principle 7).
    """
    live = {d["id"] for d in all_decs}
    out = []
    for d in all_decs:
        if cited_by(d["id"], all_decs) or cited_outside(d["id"]):
            continue
        # A record its own chain still needs is referenced whether or not
        # anyone wrote it down: keep anything another live record supersedes.
        if any(x in live for x in d["supersedes"] + d["superseded_by"]):
            continue
        out.append(d)
    return out


def prune_decisions(candidates, yes):
    """Dry by default, `--yes` acts — the pattern `nm prune` and `tm reset`
    already set for anything that removes something."""
    if not candidates:
        print("  nothing stale — every record is referenced")
        return
    print(f"\n  {len(candidates)} record(s) nothing references:\n")
    for d in candidates:
        print("  " + dec_line(d))
    if not yes:
        print("\n  Unreferenced is not the same as finished with. Check the subject still"
              "\n  matters, then `tm why --stale --yes` to prune. A stub stays in"
              f"\n  {os.path.relpath(dec_history(), REPO)}, so `tm why` keeps finding them.")
        return

    path = dec_history()
    fresh = not os.path.exists(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as fh:
        if fresh:
            fh.write(DEC_HISTORY_HEADER)
        for d in candidates:
            note = (f"superseded by {', '.join(d['superseded_by'])}"
                    if d["superseded_by"] else "no references at prune time")
            fh.write("\t".join([d["decided"] or "", d["id"], d["title"],
                                date.today().isoformat(), note]) + "\n")
    for d in candidates:
        os.remove(d["path"])
    print(f"\n  ✓ pruned {len(candidates)}. Stubs in "
          f"{os.path.relpath(path, REPO)}; git keeps the full text.")


def cmd_why(args):
    """`why <term>` searches; `why DEC-016` explains one and its chain."""
    all_decs = decisions()
    if "--stale" in args:
        return prune_decisions(stale_decisions(all_decs), "--yes" in args)
    if not args:
        raise Fail("usage: tm why <term|DEC-000>   |   tm why --stale [--yes]")
    term = " ".join(args).strip()
    if not all_decs:
        print("  no decisions recorded")
        return

    m = DEC_ID_RE.fullmatch(term.upper())
    if m:
        want = next((d for d in all_decs if d["id"].upper() == term.upper()), None)
        if want:
            return show_decision(want, all_decs)
        gone = next((r for r in pruned_decisions()
                     if r["id"].upper() == term.upper()), None)
        if gone:
            return show_pruned(gone)
        raise Fail(f"no {term.upper()}")

    hits = [d for d in all_decs if term.lower() in d["text"].lower()]
    gone = [r for r in pruned_decisions()
            if term.lower() in f"{r['id']} {r['title']} {r['note']}".lower()]
    if not hits and not gone:
        print(f"  nothing in decisions for {term!r}")
        return
    # Superseded last: the current answer is the one you almost always want,
    # and the history is what you read when it surprises you.
    hits.sort(key=lambda d: (d["status"] == "superseded", d["id"]))
    for d in hits:
        print("  " + dec_line(d))
    for r in gone:
        print(f"  - {r['id']}  {r['decided'] or '':<10}  {r['title']}  (pruned)")
    if not hits:
        print(f"\n  {len(gone)} pruned record(s) only — git keeps the full text")
        return
    live = sum(1 for d in hits if d["status"] != "superseded")
    trailer = f"\n  {len(hits)} record(s), {len(hits) - live} superseded"
    if gone:
        trailer += f", {len(gone)} pruned"
    print(trailer + f" — `tm why {hits[0]['id']}` for one of them")


def show_pruned(row):
    """All that is left of a pruned record, and where to get the rest."""
    print(f"\n  {row['id']}  {row['title']}")
    print(f"  pruned {row['pruned']}" + (f" · decided {row['decided']}" if row["decided"] else ""))
    if row["note"]:
        print(f"  {row['note']}")
    print(f"\n  full text: git log --diff-filter=D -- '*{row['id']}*'")


def show_decision(d, all_decs):
    print(f"\n  {d['id']}  {d['title']}")
    meta = f"  {d['status']}"
    if d["decided"]:
        meta += f" · {d['decided']}"
    print(meta)

    by_id = {x["id"]: x for x in all_decs}

    def named(ids):
        return [f"{i} ({by_id[i]['title']})" if i in by_id else f"{i} (missing)"
                for i in ids]

    for label, ids in (("supersedes", d["supersedes"]),
                       ("superseded by", d["superseded_by"]),
                       ("relates to", d["relates_to"])):
        for line in named(ids):
            print(f"  {label:>14}: {line}")

    back = cited_by(d["id"], all_decs)
    if back:
        print("\n  cited by")
        for did, field in back:
            print(f"    {did}  {field.replace('_', ' ')}")

    outside = cited_outside(d["id"])
    if outside:
        print("\n  referenced in")
        for p in outside:
            print(f"    {p}")
    elif not back:
        # The signal pruning is for. Said plainly rather than scored.
        print("\n  nothing else references this record")

    top = (git("rev-parse", "--show-toplevel") or REPO).strip()
    print(f"\n  {os.path.relpath(d['path'], top)}")


def check_decisions(rep, root):
    """A decision is superseded, never rewritten. Typo-level edits pass; the
    threshold is deliberately generous — this catches rewrites, not tidying."""
    import difflib

    changed = git("diff", "--cached", "--name-only", "--", "decisions/").split()
    for path in changed:
        old = git("show", f"HEAD:{path}")
        if not old:
            continue  # newly added
        full = os.path.join(root, path)
        if not os.path.exists(full):
            continue
        with open(full) as fh:
            new = fh.read()
        if frontmatter_field(old, "superseded_by") != frontmatter_field(new, "superseded_by"):
            continue
        if frontmatter_field(old, "status") != frontmatter_field(new, "status"):
            continue
        a, b = old.split(), new.split()
        sm = difflib.SequenceMatcher(None, a, b)
        moved = sum(
            max(i2 - i1, j2 - j1)
            for tag, i1, i2, j1, j2 in sm.get_opcodes() if tag != "equal"
        )
        if moved > 25:
            rep.error(
                f"{path}: {moved} words changed without superseding it. "
                "Write a new decision that supersedes this one."
            )


def _dec_list(text, field):
    raw = frontmatter_field(text, field).strip("[] ")
    return [x.strip() for x in raw.split(",") if x.strip()]


def check_decision_graph(rep, root):
    """Supersession is a two-sided claim, and nothing until now checked the
    second side. A human cannot hold twenty cross-references in their head, so
    a hand-edit that half-supersedes something is silent and permanent — the
    record still reads as current from one direction.

    Runs over the whole folder, not the staged diff: the file that goes stale
    is the *other* one, which by definition is not in this commit."""
    d = os.path.join(root, "decisions")
    if not os.path.isdir(d):
        return
    docs = {}
    for name in sorted(os.listdir(d)):
        if not name.startswith("DEC-") or not name.endswith(".md"):
            continue
        text = open(os.path.join(d, name)).read()
        did = frontmatter_field(text, "id")
        if not did:
            rep.error(f"{name}: no id in frontmatter")
            continue
        if not name.startswith(did + "-"):
            rep.error(f"{name}: filename does not match id {did}")
        if did in docs:
            rep.error(f"{did} is used by two files — ids are never reused")
        docs[did] = text

    for did, text in docs.items():
        status = frontmatter_field(text, "status")
        by = _dec_list(text, "superseded_by")
        for other in _dec_list(text, "supersedes"):
            if other not in docs:
                rep.error(f"{did} supersedes {other}, which does not exist")
            elif did not in _dec_list(docs[other], "superseded_by"):
                rep.error(f"{did} supersedes {other}, but {other} does not say so — "
                          "supersession is recorded on both sides")
        for other in by:
            if other not in docs:
                rep.error(f"{did} is superseded by {other}, which does not exist")
            elif did not in _dec_list(docs[other], "supersedes"):
                rep.error(f"{did} says {other} supersedes it, but {other} does not say so")
        if by and status != "superseded":
            rep.error(f"{did} is superseded by {', '.join(by)} but status is {status!r}")
        if not by and status == "superseded":
            rep.error(f"{did} is marked superseded with nothing superseding it")


# llmeep's own trees, relative to wherever it was installed. Everything else in
# the repo is the platform — including a `platform/` directory, when there is
# one. `adopt` is listed because it sits at the root and is llmeep's, not yours.
SKELETON = ("tasks/", "notes/", "decisions/", "ontology/", ".notes/", ".claude/", "adopt")


def platform_changes(*extra):
    """The platform is **the repo minus llmeep's own paths**, not a directory.

    `platform/` only exists in a fresh clone. A repo that adopted llmeep keeps
    its code where it was, so a pathspec of `platform/` matched nothing and both
    nudges below passed unconditionally — silently, which is the worse half
    (`PLT-tdb5`).

    Root-level `.md` files and dotfiles are excluded as well. They are the
    README, the ignore file, the env sample: documentation and configuration
    that belongs to no subsystem. Counting them would fire this on every README
    edit, and a nudge that cries wolf on the most-edited file in a project is
    worse than no nudge at all.
    """
    top = (git("rev-parse", "--show-toplevel") or REPO).strip()
    # A nested install (`adopt --into ops`) puts the trees one level down, while
    # git reports paths from the top. Prefix the skeleton with wherever we sit.
    here = os.path.relpath(REPO, top)
    prefix = "" if here == "." else here + "/"
    # `.claude/` is never prefixed: agent adapters stay at the repo root even
    # for a nested install, because that is the only place an agent looks.
    ours = tuple(prefix + p for p in SKELETON) + (".claude/",)

    out = []
    for path in git("diff", "--cached", "--name-only", *extra).split():
        if path.startswith(ours):
            continue
        # Documentation and configuration sitting loose at the top of the repo —
        # or at the top of the install, which for a nested one holds the
        # generated README. Neither is anybody's platform.
        loose = path[len(prefix):] if path.startswith(prefix) else path
        if "/" not in loose and (loose.startswith(".") or loose.endswith(".md")):
            continue
        out.append(path)
    return out


MANIFEST = ".llmeep"
MANIFEST_RE = re.compile(
    r"# llmeep:manifest — rewritten by --update; do not edit\n(.*?)\n# llmeep:manifest-end",
    re.S)


def manifest(top):
    """`.llmeep` carries what `adopt` installed as a commented JSON header. Read
    by pattern rather than by running the script: inspecting an install and
    trusting it should not be the same act.

    Absent for a clone of the skeleton, which was never adopted into anything.
    An empty dict is the honest answer there, not an error.
    """
    path = os.path.join(top, MANIFEST)
    if not os.path.isfile(path):
        return {}
    with open(path) as fh:
        m = MANIFEST_RE.search(fh.read())
    if not m:
        return {}
    try:
        return json.loads("\n".join(l.lstrip("# ") for l in m.group(1).split("\n")))
    except json.JSONDecodeError:
        return {}


def ontology_path(top):
    """Where this repo keeps its domain ontology, as `tm ontology` recorded it.

    Three states, and the difference between the last two is the whole point:
    a path means check it, `""` means they were asked and said no, and `None`
    means nobody has ever been asked.
    """
    return manifest(top).get("ontology")


def check_ontology_currency(rep, root):
    """New platform files suggest a new concept. Only *added* files are
    considered — warning on every modification would be noise, and a noisy hook
    gets bypassed, taking every other check with it. Warns, never blocks.

    Until `DEC-032` this checked a hardcoded `ontology/domain/` that `adopt`
    created empty in every repo. In an adopted repo — where the platform *is*
    the codebase — that fired on every commit adding a source file and could not
    be satisfied except by writing an ontology nobody had asked for. llmeep's own
    `platform/` is empty, so llmeep never saw its own noise (`PLT-8t5w`).

    So the path is configured now, and an unconfigured repo gets asked once per
    triggering commit rather than told off. Both messages name the command that
    ends them, because a warning with no way to satisfy it is the one that
    teaches people to pass `--no-verify`.
    """
    added = platform_changes("--diff-filter=A")
    if not added:
        return
    top = (git("rev-parse", "--show-toplevel") or root).strip()
    where = ontology_path(top)
    if where == "":          # asked, declined. Never mention it again.
        return
    if where is None:
        rep.warn(
            f"{len(added)} new file(s) in the platform and no domain ontology is "
            "recorded — `tm ontology <path>` to point at yours, or `tm ontology --none`"
        )
        return
    if not os.path.exists(os.path.join(top, where)):
        rep.warn(f"the recorded ontology {where} is not there — `tm ontology <path>` to fix it")
        return
    # `cwd=top`, not the default `REPO`. Output paths are toplevel-relative from
    # anywhere, but a **pathspec** resolves against the working directory — so a
    # recorded `ontology` matched `llmeep/ontology/` from the install folder and
    # the check passed on llmeep's own files instead of theirs. Silently, which
    # is the half that matters.
    if git("diff", "--cached", "--name-only", "--", where, cwd=top).split():
        return
    rep.warn(
        f"{len(added)} new file(s) in the platform but {where} is unchanged — "
        "add or update the concept if this introduced one"
    )


def check_hooks(rep):
    """A hooks directory that has moved fails *silently* — git runs nothing and
    says nothing. So the one check that cannot rely on a hook is the one that
    asks whether the hooks are wired up at all."""
    # Relative to the git toplevel, not to REPO: git resolves core.hooksPath
    # from the top of the working tree, and llmeep may sit in a subdirectory of
    # a repo it was adopted into.
    top = (git("rev-parse", "--show-toplevel") or REPO).strip()
    want = os.path.relpath(os.path.join(HERE, "hooks"), top)
    have = (git("config", "core.hooksPath") or "").strip()
    if not have:
        rep.warn(f"no git hooks installed — `git config core.hooksPath {want}`")
    elif not os.path.isdir(os.path.join(top, have)):
        rep.warn(f"core.hooksPath={have} no longer exists — "
                 f"`git config core.hooksPath {want}`")


def check_untracked_work(rep, root):
    """Work landing with no task is the drift that makes the board useless.

    Warns rather than blocks, because commit time is already too late — the
    work is done. The real catch is the agent creating the task when the user
    says "let's build X". This is only the backstop."""
    touched = platform_changes()
    if not touched:
        return
    for ledger in LEDGERS:
        try:
            if Board(ledger).in_progress:
                return
        except Fail:
            pass
    rep.warn(
        f"{len(touched)} platform file(s) changed with no task in progress — "
        "`tm add <title>` then `tm go` if this was real work"
    )


def check_trailer(rep, msg_path):
    with open(msg_path) as fh:
        msg = fh.read()
    known = {r["id"] for r in history_rows()}
    for ledger in LEDGERS:
        try:
            known |= Board(ledger).all_ids()
        except Fail:
            pass
    for tid in re.findall(r"\bcloses\s+([A-Z]{3}-\S+)", msg):
        if tid.rstrip(".,;") not in known:
            rep.error(
                f'commit message says "closes {tid}" but no such task exists — '
                "the trailer is the only link between task and commit"
            )


def check_nudge(rep, root):
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail:
            continue
        for task in board.in_progress:
            rep.warn(f"{task.id} still in progress — run `tm done {task.id}` if that finished it")


# `--no-verify` skips pre-commit and commit-msg but NOT post-commit. So the
# trace cannot be "post-commit records success" — that would run on bypassed
# commits too, erasing the evidence. Instead pre-commit drops a token and
# post-commit checks whether it is there and fresh. Freshness rather than
# sha-matching, because --amend and merges legitimately change the parent.
TOKEN = "tm-precommit"
BYPASSED = "tm-bypassed"
TOKEN_TTL = 120  # seconds


def _gitpath(root, name):
    gitdir = (git("rev-parse", "--git-dir") or "").strip()
    return os.path.join(root, gitdir, name) if gitdir else None


def check_bypass(rep, root):
    """Report the standing trace, then arm the token for this commit."""
    log = _gitpath(root, BYPASSED)
    if log and os.path.exists(log):
        with open(log) as fh:
            shas = [s for s in fh.read().split() if s]
        if shas:
            recent = " ".join(s[:7] for s in shas[-3:])
            rep.warn(
                f"{len(shas)} commit(s) bypassed these checks ({recent}) — "
                f"run `tm check`, then clear .git/{BYPASSED}"
            )
    token = _gitpath(root, TOKEN)
    if token:
        with open(token, "w") as fh:
            fh.write((git("rev-parse", "HEAD") or "root").strip())


def record_verified(root):
    """post-commit: was this commit validated, or did it skip the gate?"""
    import time

    token, log = _gitpath(root, TOKEN), _gitpath(root, BYPASSED)
    if not token:
        return
    fresh = os.path.exists(token) and os.path.getmtime(token) > time.time() - TOKEN_TTL
    if os.path.exists(token):
        os.remove(token)
    if not fresh and log:
        head = (git("rev-parse", "HEAD") or "").strip()
        if head:
            with open(log, "a") as fh:
                fh.write(head + "\n")
            print(f"  ~ this commit skipped validation — recorded in .git/{BYPASSED}")


def check_notify(send=False):
    """Verify the configured channel, and walk its setup if it is missing.

    Does **not** send unless asked. A command called `check` must not put a
    message in front of a whole team every time someone validates config —
    same reasoning as `reset` being a dry run without `--yes`.

    Setup is inherently per-channel, so this dispatches; sending is not, so
    everything after configuration goes through `notify()`."""
    load_env()
    name = (os.environ.get("NOTIFY") or "telegram").strip().lower()
    if name == "none":
        print("  NOTIFY=none — completions are not announced anywhere.")
        return 0
    if name not in NOTIFIERS:
        print(f"  ! unknown NOTIFY={name!r}; known: {', '.join(NOTIFIERS)}")
        return 1
    if name != "telegram":
        return check_generic(name, send)
    return check_telegram(send)


def check_generic(name, send=False):
    """Non-Telegram channels need one URL and nothing else, so there is no
    wizard to run — either it is set or it is not."""
    var = {"slack": "SLACK_WEBHOOK_URL", "webhook": "NOTIFY_WEBHOOK_URL"}[name]
    env = os.path.join(REPO, ".env")
    if not os.environ.get(var):
        print(f"  NOTIFY={name} but {var} is not set.\n")
        print(f"  add it to {env}:\n")
        print(f"       {var}=https://...")
        return 1
    if not send:
        print(f"  ✓ {name} configured. `--send` to post a test message.")
        return 0
    if notify(task_probe(), "setup"):
        print(f"  ✓ sent a test message via {name}")
        return 0
    print(f"  ! send failed — check {var}")
    return 1


def print_chats(chats, current):
    """Group ids are negative and a supergroup's begins -100, which looks like a
    mistake until you have seen it once. Naming the type says it is not."""
    for cid, (kind, name) in chats.items():
        mark = " ← configured" if current is not None and str(cid) == str(current) else ""
        print(f"    {cid:<16} {kind:<10} {name}{mark}")


def print_no_chats(indent=""):
    print(f"{indent}  add the bot to your group and send /start@yourbotname —")
    print(f"{indent}  group privacy hides ordinary messages from bots until they")
    print(f"{indent}  are addressed. Then run this again, within the day: Telegram")
    print(f"{indent}  drops updates nobody has collected after about 24 hours.")


def task_probe():
    return Task("TEST", "taskman is wired up", done_on=date.today().isoformat())


def check_telegram(send=False):
    """Setup helper. Walks the two-step configuration rather than just failing,
    because the chat id is the part nobody can guess."""
    load_env()
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat = os.environ.get("TELEGRAM_CHAT_ID")
    env = os.path.join(REPO, ".env")

    if not token:
        print("  no TELEGRAM_BOT_TOKEN set.\n")
        print("  1. message @BotFather in Telegram, send /newbot")
        print("  2. pick a display name, then a username ending in 'bot'")
        print(f"  3. put the token it gives you in {env}:\n")
        print("       TELEGRAM_BOT_TOKEN=8123456789:AAH...")
        return 1

    try:
        with urllib.request.urlopen(
            f"https://api.telegram.org/bot{token}/getUpdates", timeout=10
        ) as fh:
            data = json.load(fh)
    except (urllib.error.URLError, OSError) as exc:
        print(f"  ! could not reach Telegram: {exc}")
        return 1
    if not data.get("ok"):
        print(f"  ! Telegram rejected the token: {data.get('description')}")
        return 1

    chats = {}
    for upd in data.get("result", []):
        c = ((upd.get("message") or upd.get("channel_post")
              or upd.get("my_chat_member") or {}).get("chat"))
        if c:
            chats[c["id"]] = (c.get("type", "?"),
                              c.get("title") or c.get("username") or c.get("first_name", "?"))

    if not chat:
        print("  token works. no TELEGRAM_CHAT_ID set yet.\n")
        if chats:
            print_chats(chats, None)
            print(f"\n  add the one you want to {env}:\n")
            print(f"       TELEGRAM_CHAT_ID={list(chats)[0]}")
        else:
            print_no_chats()
        return 1

    where = chats.get(int(chat), ("", chat))[1] if str(chat).lstrip("-").isdigit() else chat
    if not send:
        print(f"  ✓ telegram configured — {where}")
        # Always list what else the bot can see. A team group is usually made
        # after someone has already wired this up alone, and a check that goes
        # quiet once an id is set leaves them with nowhere to look (`PLT-4hck`).
        others = {k: v for k, v in chats.items() if str(k) != str(chat)}
        if others:
            print("\n  this bot can also see:")
            print_chats(others, chat)
            print(f"\n  to move, change TELEGRAM_CHAT_ID in {env}")
        else:
            print("\n  no other chats visible. To point this at a group instead,")
            print_no_chats(indent="  ")
        print("\n  `--send` to post a test message.")
        return 0
    if notify(task_probe(), "setup"):
        print(f"  ✓ sent a test message to {where}")
        return 0
    print("  ! send failed — check TELEGRAM_CHAT_ID is right")
    return 1


# Directories the layout promises but git cannot carry, because git tracks no
# empty directory. Each needs a `.gitkeep`, and each has gone missing from a cut
# before now.
# `ontology/domain` was here until `DEC-032`. There is no such directory now:
# llmeep ships guidance on writing a domain ontology, not a hole to put one in.
RELEASE_DIRS = [
    "notes/raw", "tasks/platform/tasks", "tasks/business/tasks",
]

LINK_RE = re.compile(r"\]\((?!https?:|#|mailto:)([^)]+)\)")


def dead_links(root):
    """Relative links that resolve on `main` and not in a cut tree. Every one of
    these so far pointed into `decisions/`, which `reset --all` empties — found
    four times by eye and once by this function, which is why it exists."""
    # From the git toplevel, not from REPO. Nested, REPO is the install folder,
    # and the files most likely to hold a stale path — the repo's own README and
    # `ontology/` — sit outside it. Scanning from REPO silently stopped checking
    # exactly the ones the move broke.
    top = (git("rev-parse", "--show-toplevel") or root).strip()
    out = []
    for path in git("ls-files", "*.md", cwd=top).split():
        full = os.path.join(top, path)
        if not os.path.exists(full):
            continue
        with open(full) as fh:
            text = fh.read()
        for target in LINK_RE.findall(text):
            target = target.split("#")[0]
            if not target:
                continue
            resolved = os.path.normpath(os.path.join(os.path.dirname(full), target))
            if not os.path.exists(resolved):
                out.append(f"{path} → {target}")
    return out


def check_release(rep, root):
    """A cut tree is one that has never existed on `main`: records emptied,
    decisions cleared, directories git could not carry. Nothing else validates
    that difference, so every defect in it was found after publishing — v2
    shipped this project's decisions, v3 broke ten links and lost two
    directories, v5 broke fifteen more.

    Run inside the cut, after both resets and before the commit. Never wired
    into a hook: cutting a version is deliberate and rare, and `check` keeps its
    no-side-effects contract (`DEC-009`)."""
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail:
            continue
        n = len(board.in_progress) + len(board.open) + len(board.recent)
        if n:
            rep.error(f"{ledger} board still has {n} task line(s) — run `tm reset --yes --all`")
    if len(history_rows()):
        rep.error("tasks history.tsv still has rows — run `tm reset --yes --all`")

    notes_hist = os.path.join(root, "notes", "_tooling", "history.tsv")
    if os.path.exists(notes_hist):
        with open(notes_hist) as fh:
            rows = [l for l in fh if l.strip() and not l.startswith("#")]
        if rows:
            rep.error(f"notes history.tsv still has {len(rows)} row(s) — run `nm reset --yes`")
    archive = os.path.join(root, "notes", "notes.md")
    if os.path.exists(archive):
        with open(archive) as fh:
            kept = [l for l in fh if l.strip() and not l.startswith("#")]
        if kept:
            rep.error(f"notes.md still holds {len(kept)} note(s) — run `nm reset --yes`")

    for sub in ("tasks", "notes"):
        if os.path.exists(os.path.join(root, sub, MARKER)):
            rep.error(f"{sub}/{MARKER} is still here — its reset has not run")

    dec = os.path.join(root, "decisions")
    if os.path.isdir(dec):
        left = [f for f in sorted(os.listdir(dec)) if f.startswith("DEC-")]
        if left:
            rep.error(f"decisions/ still holds {len(left)} record(s) — `tm reset --yes --all` "
                      "drops them; a release belongs to nobody yet")
        if not os.path.exists(os.path.join(dec, "_template.md")):
            rep.error("decisions/_template.md is missing — `--all` keeps the template")

    # All under the install root since `DEC-032` — nothing llmeep ships lands at
    # the repo root any more, so one base answers for every entry.
    for d in RELEASE_DIRS:
        if not os.path.isdir(os.path.join(root, d)):
            rep.error(f"{d}/ is absent — git carries no empty directory; it needs a .gitkeep")

    for link in dead_links(root):
        rep.error(f"dead link: {link}")


# What an agent carries. A skill is loaded whole the moment its subject comes
# up, so it is the only file here with a standing cost — and the one nobody
# notices growing, because every addition to it is individually justified.
#
# The ontology is not in this table on purpose. It is large (~8.6k tokens) and
# read on demand, when the model changes rather than when work happens. That
# distinction was got backwards once already: `PLT-c4zq` was filed believing the
# ontology was the file filling context, and measuring showed the skill was.
SKILL_BUDGET = 4000     # tokens; ~10% headroom over where measuring put it
CHARS_PER_TOKEN = 4     # rough and deliberately so — the point is drift, not precision


def context_cost():
    """Measured, never asserted. The README carried a cost table for weeks that
    understated the real figure by a third, because it was written once and the
    skill kept growing."""
    top = (git("rev-parse", "--show-toplevel") or REPO).strip()
    rows = []
    for label, path, when in (
        ("tm skill", os.path.join(top, ".claude/skills/tm/SKILL.md"), "tasks are mentioned"),
        ("nm skill", os.path.join(top, ".claude/skills/nm/SKILL.md"), "notes are mentioned"),
        ("platform board", os.path.join(ROOT, "platform/board.md"), "it lists or starts work"),
        ("business board", os.path.join(ROOT, "business/board.md"), "it lists or starts work"),
    ):
        if os.path.isfile(path):
            rows.append((label, os.path.getsize(path) // CHARS_PER_TOKEN, when))
    return rows


def check_context(rep):
    rows = context_cost()
    print("\n  what an agent carries\n")
    for label, tokens, when in rows:
        print(f"    {label:<16} ~{tokens:>5} tokens   when {when}")
    skills = {l: t for l, t, _ in rows if l.endswith("skill")}
    session = skills.get("tm skill", 0) + next(
        (t for l, t, _ in rows if l == "platform board"), 0)
    print(f"\n    a task session  ~{session:>5} tokens   the tm skill plus a board")
    for label, tokens in skills.items():
        if tokens > SKILL_BUDGET:
            rep.warn(f"{label} is ~{tokens} tokens, over the {SKILL_BUDGET} budget — "
                     "it loads whole, every time its subject comes up")


def cmd_check(args):
    if "--notify" in args:
        sys.exit(check_notify(send="--send" in args))
    root = REPO
    rep = Report()
    if "--context" in args:
        # Not part of plain `check`: it prints a table, and `check` runs in
        # hooks where output nobody reads is output that trains people to
        # ignore the rest.
        check_context(rep)
        sys.exit(rep.emit())
    if "--release" in args:
        check_release(rep, root)
    elif "--msg" in args:
        check_trailer(rep, args[args.index("--msg") + 1])
    elif "--nudge" in args:
        check_nudge(rep, root)
        record_verified(root)
    else:
        check_boards(rep)
        check_sidecars(rep)
        check_hooks(rep)
        if "--staged" in args:
            check_bypass(rep, root)
            check_decisions(rep, root)
            check_decision_graph(rep, root)
            check_untracked_work(rep, root)
            check_ontology_currency(rep, root)
    code = rep.emit()
    if code == 0 and not rep.warnings and "--quiet" not in args:
        print("  ✓ release tree is clean" if "--release" in args else "  ✓ records consistent")
    sys.exit(code)


