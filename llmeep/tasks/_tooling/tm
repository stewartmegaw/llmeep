#!/usr/bin/env python3
"""tm — taskman. See tasks/_tooling/ontology.md for the model.

Five commands: add, go, park, done, find. Listing is reading the board; reordering is
moving a line in it. Neither is a command.

The tool is deterministic and never interprets intent (principle 7). It takes
explicit flags; the agent invoking it decides what they should be.
"""

import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import date, timedelta

# Three distinct places, and they stopped being the same one when the machinery
# moved out of the records tree. HERE is where this script and its hooks live;
# ROOT is the ledgers it operates on; REPO is the working tree around both.
HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.environ.get("TM_ROOT") or os.path.dirname(HERE)
REPO = os.path.dirname(ROOT)
HISTORY = os.path.join(HERE, "history.tsv")
LEDGERS = {"platform": "PLT", "business": "BUS"}
WINDOW = 15
MAX_HITS = 3
TITLE_MAX = 120   # hard cap; past this the detail belongs in a sidecar
TITLE_SENTENCES = 2

# Unambiguous alphabet: no 0/1/i/l/o. 30^4 = 810k, and allocation also checks
# for a local collision, so a clash needs two branches to draw the same value.
ALPHABET = "23456789abcdefghjkmnpqrstuvwxyz"
ID_LEN = 4

# Heading → attribute. They stopped being the same string once a section name
# contained a space; deriving one from the other silently dropped the section.
#
# `prioritised` is the decided queue and `backlog` is the pool everything lands
# in. Only `prioritised` is ordered — position there is priority, and it is what
# a bare `go` and the standup both read. The pool has no order to defend, which
# is the point: filing something costs no ranking decision.
SECTIONS = {"in progress": "in_progress",
            "prioritised": "prioritised",
            "backlog": "backlog"}

TAG_RE = re.compile(r"^(detail|@[a-z0-9][a-z0-9._-]*|blocked:[A-Za-z]{3}-\S+"
                    r"|filed:\d{4}-\d{2}-\d{2})$")
ID_RE = re.compile(r"^(PLT|BUS)-\S+$")


class Fail(Exception):
    pass


# ---------------------------------------------------------------- board model


class Task:
    def __init__(self, tid, title, tags=None, done_on=None):
        self.id = tid
        self.title = title
        self.tags = tags or []
        self.done_on = done_on

    @property
    def blocker(self):
        for t in self.tags:
            if t.startswith("blocked:"):
                return t.split(":", 1)[1]
        return None

    @property
    def has_detail(self):
        return "detail" in self.tags

    @property
    def filed(self):
        """When `add` created the line, or None for anything filed before this
        existed. **Absence is permanent and legal** — back-filling it from git
        would write wrong dates (renames move the board, and the commit date is
        not the filing date), so an undated line stays undated forever."""
        for t in self.tags:
            if t.startswith("filed:"):
                return t.split(":", 1)[1]
        return None

    @property
    def assignee(self):
        for t in self.tags:
            if t.startswith("@"):
                return t[1:]
        return None

    def assign(self, who):
        self.unassign()
        if who:
            self.tags.insert(0, f"@{who}")

    def unassign(self):
        self.tags = [t for t in self.tags if not t.startswith("@")]

    def render(self):
        line = f"{self.id:<9}{self.title}"
        if self.tags:
            # ljust then an explicit separator: a title long enough to fill the
            # column gets no padding, and without this the tag is concatenated
            # onto the title — which _parse then reads back as part of it.
            line = line.ljust(56) + "  " + "  ".join(self.tags)
        return line.rstrip()

    def render_recent(self):
        line = f"{self.done_on}  {self.id:<9}{self.title}"
        if self.assignee:
            line = line.ljust(56) + f"  @{self.assignee}"
        return line.rstrip()


def title_problems(title):
    """A title is a handle, not a description.

    The character cap is enforced because it is mechanical. The sentence count
    only warns — counting terminal punctuation false-positives on "e.g." and
    version numbers, and a heuristic that blocks legitimate work is worse than
    one that mentions it.
    """
    errors, warnings = [], []
    if len(title) > TITLE_MAX:
        errors.append(f"title is {len(title)} characters; the cap is {TITLE_MAX}. "
                      "Shorten it and put the detail in a sidecar.")
    sentences = len([m for m in re.findall(r"[.!?](?:\s|$)", title)])
    if sentences > TITLE_SENTENCES:
        warnings.append(f"title reads as {sentences} sentences; {TITLE_SENTENCES} is the "
                        "guide. A sidecar holds what will not fit.")
    return errors, warnings


def slug(text):
    text = re.sub(r"[^a-z0-9._-]+", "-", (text or "").strip().lower())
    return text.strip("-") or None


def whoami():
    """Who the actor is. Derived, never asked for — one less thing to configure.

    `git config user.email`'s local part is short, stable and already unique
    within a team, which a display name is not. Returns None when git has no
    identity, in which case assignments are simply not made.
    """
    for source in (
        os.environ.get("TM_USER"),
        git_config("taskman.user"),
        (git_config("user.email") or "").split("@")[0],
        git_config("user.name"),
    ):
        if source and slug(source):
            return slug(source)
    return None


def git_config(key):
    try:
        out = subprocess.run(["git", "config", "--get", key],
                             cwd=ROOT, capture_output=True, text=True, timeout=5)
        return out.stdout.strip() if out.returncode == 0 else ""
    except Exception:
        return ""


class Board:
    """One ledger's live state. Sections are authoritative; order is priority
    within `prioritised`, which is the only section that has one."""

    def __init__(self, ledger):
        self.ledger = ledger
        self.path = os.path.join(ROOT, ledger, "board.md")
        self.in_progress, self.prioritised, self.backlog, self.recent = [], [], [], []
        self._load()

    @property
    def open(self):
        """Everything not yet started, decided work first. Read-only — appending
        to this would land in a throwaway list, so mutate a section directly."""
        return self.prioritised + self.backlog

    def _load(self):
        if not os.path.exists(self.path):
            raise Fail(f"no board at {self.path}")
        section = None
        with open(self.path) as fh:
            for raw in fh:
                line = raw.rstrip("\n")
                if line.startswith("## "):
                    section = line[3:].strip()
                    continue
                if not line.strip() or line.startswith("#"):
                    continue
                if section == "recent":
                    self.recent.append(self._parse_recent(line))
                elif section in SECTIONS:
                    getattr(self, SECTIONS[section]).append(self._parse(line))

    @staticmethod
    def _split_tags(tokens):
        tags = []
        while tokens and TAG_RE.match(tokens[-1]):
            tags.insert(0, tokens.pop())
        return tokens, tags

    def _parse(self, line):
        tokens = line.split()
        tid = tokens.pop(0)
        tokens, tags = self._split_tags(tokens)
        return Task(tid, " ".join(tokens), tags)

    def _parse_recent(self, line):
        tokens = line.split()
        done_on = tokens.pop(0)
        tid = tokens.pop(0)
        tokens, tags = self._split_tags(tokens)
        # Keep the assignee; drop `detail`/`blocked:` — a completed task has no
        # blocker, and its sidecar is found by id, not by a tag.
        tags = [t for t in tags if t.startswith("@")]
        return Task(tid, " ".join(tokens), tags, done_on=done_on)

    def all_ids(self):
        return {t.id for t in self.in_progress + self.open + self.recent}

    def find(self, tid):
        for bucket in (self.in_progress, self.prioritised, self.backlog, self.recent):
            for t in bucket:
                if t.id.lower() == tid.lower():
                    return t, bucket
        return None, None

    def is_blocked(self, task):
        """A blocker resolved once it is off the board and out of progress —
        either open section still counts as unfinished."""
        b = task.blocker
        if not b:
            return None
        live = {t.id for t in self.in_progress + self.open}
        return b if b in live else None

    def clear_blocker(self, tid):
        for t in self.in_progress + self.open:
            t.tags = [g for g in t.tags if g != f"blocked:{tid}"]

    def save(self):
        self.recent.sort(key=lambda t: t.done_on, reverse=True)
        del self.recent[WINDOW:]  # pruned entries survive in history.tsv
        out = [f"# {self.ledger}", "", "## in progress", ""]
        out += [t.render() for t in self.in_progress]
        out += ["", "## prioritised", ""]
        out += [t.render() for t in self.prioritised]
        out += ["", "## backlog", ""]
        out += [t.render() for t in self.backlog]
        out += ["", "## recent", ""]
        out += [t.render_recent() for t in self.recent]
        with open(self.path, "w") as fh:
            fh.write("\n".join(out).rstrip() + "\n")


# -------------------------------------------------------------------- history


def history_rows():
    if not os.path.exists(HISTORY):
        return []
    rows = []
    with open(HISTORY) as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 4:
                # `who` is appended last so rows written before assignees
                # existed still parse — zip simply stops short.
                rows.append(dict(zip(("date", "id", "ledger", "title", "who"), parts)))
    return rows


def history_append(task, ledger):
    """Append-only. Never rewritten, so a completion can never be lost."""
    if any(r["id"] == task.id for r in history_rows()):
        raise Fail(f"{task.id} is already in history — ids are never reused")
    new = not os.path.exists(HISTORY)
    with open(HISTORY, "a") as fh:
        if new:
            fh.write("#date\tid\tledger\ttitle\twho\n")
        row = [task.done_on, task.id, ledger, task.title]
        if task.assignee:
            row.append(task.assignee)
        fh.write("\t".join(row) + "\n")


def search(term, limit=MAX_HITS):
    words = [w for w in re.split(r"\W+", term.lower()) if len(w) > 2]
    if not words:
        return []
    scored = []
    for row in history_rows():
        hay = f"{row['id']} {row['title']}".lower()
        hits = sum(1 for w in words if w in hay)
        if hits:
            scored.append((hits, row["date"], row))
    scored.sort(key=lambda s: (-s[0], s[1]))  # strongest match, then newest
    return [r for _, _, r in scored[:limit]]


def history_line(row):
    title = summarise(row["title"], 42)
    sha = resolve_commit(row["id"])
    return f"{row['id']:<9}{title:<44}{row['date']}" + (f"  {sha}" if sha else "")


def resolve_commit(tid):
    try:
        out = subprocess.run(
            ["git", "log", f"--grep=closes {tid}", "--format=%h", "-1"],
            cwd=ROOT, capture_output=True, text=True, timeout=5,
        )
        return out.stdout.strip() or None
    except Exception:
        return None


def show_related(term):
    """Automatic retrieval (principle 6). Silent when empty, capped at 3 —
    output that is always present with weak matches gets skipped."""
    hits = search(term)
    if not hits:
        return
    print("\n  related history")
    for row in hits:
        print("    " + history_line(row))


# -------------------------------------------------------------------- sidecar


def sidecar_path(ledger, tid):
    """One file, or a folder when a task needs several — a spec plus a diagram,
    a rubric, sample data. Same `<id>-<slug>` name either way."""
    d = os.path.join(ROOT, ledger, "tasks")
    if not os.path.isdir(d):
        return None
    for name in sorted(os.listdir(d)):
        if not name.startswith(f"{tid}-"):
            continue
        path = os.path.join(d, name)
        if os.path.isdir(path) or name.endswith(".md"):
            return path
    return None


def sidecar_all(ledger):
    """Every sidecar in a ledger, file or folder. Same rule as `sidecar_path`,
    which is the point — anything that rule can find, `reset` has to clear."""
    d = os.path.join(ROOT, ledger, "tasks")
    if not os.path.isdir(d):
        return []
    out = []
    for name in sorted(os.listdir(d)):
        path = os.path.join(d, name)
        if name.startswith("_") or name.startswith("."):
            continue
        if os.path.isdir(path) or name.endswith(".md"):
            out.append(path)
    return out


def sidecar_doc(path):
    """The readable entry point. A folder's is its README.md — the same
    convention the rest of the skeleton uses for 'start here'."""
    if path and os.path.isdir(path):
        readme = os.path.join(path, "README.md")
        return readme if os.path.exists(readme) else None
    return path


def sidecar_extras(path):
    """Everything in a folder sidecar besides its README, for `go` to list."""
    if not (path and os.path.isdir(path)):
        return []
    return [f for f in sorted(os.listdir(path)) if f != "README.md"]


def unchecked_acceptance(path):
    """Acceptance is optional. Where it exists, it is the gate — with no
    reviewer, it is the only quality gate there is."""
    path = sidecar_doc(path)
    if not path:
        return []
    section, pending = False, []
    with open(path) as fh:
        for line in fh:
            if line.startswith("## "):
                section = line[3:].strip().lower() == "acceptance"
                continue
            if section and line.strip().startswith("- [ ]"):
                pending.append(summarise(line.strip()[5:]))
    return pending


def summarise(text, width=64):
    """Criteria are prose; a terminal list of them is a reminder, not the text."""
    text = re.sub(r"[*`_]", "", text).strip()
    return text if len(text) <= width else text[: width - 1].rstrip() + "…"


# --------------------------------------------------------------------- notify
#
# The notification channel is deliberately external and replaceable. Everything
# about how it presents itself — bot name, description, which room, who can see
# it — is configured in the service, not in this repo. The repo holds one line
# (`NOTIFY=`) and a secret, so swapping channels touches no records and no
# ontology. Telegram is one implementation, not the design.
#
# Adding a channel is a function plus a dict entry. That is the whole extension
# point: no plugin loader, no registry, no config schema.


def load_env():
    path = os.path.join(REPO, ".env")
    if not os.path.exists(path):
        return
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                os.environ.setdefault(k.strip(), v.strip().strip("'\""))


def post(url, data, headers=None):
    req = urllib.request.Request(url, data, headers or {})
    urllib.request.urlopen(req, timeout=5)


def notify_telegram(text):
    """Returns None when unconfigured, so `done` can say so without failing."""
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat = os.environ.get("TELEGRAM_CHAT_ID")
    if not token or not chat:
        return None
    post(f"https://api.telegram.org/bot{token}/sendMessage",
         urllib.parse.urlencode({"chat_id": chat, "text": text,
                                 "parse_mode": "HTML"}).encode())
    return "telegram"


def notify_slack(text):
    url = os.environ.get("SLACK_WEBHOOK_URL")
    if not url:
        return None
    post(url, json.dumps({"text": text}).encode(),
         {"Content-Type": "application/json"})
    return "slack"


def notify_webhook(text):
    """Anything that accepts a JSON POST. The full task is included so a
    receiver can render it however it likes rather than parse `text`."""
    url = os.environ.get("NOTIFY_WEBHOOK_URL")
    if not url:
        return None
    post(url, json.dumps({"text": text}).encode(),
         {"Content-Type": "application/json"})
    return "webhook"


NOTIFIERS = {
    "telegram": notify_telegram,
    "slack": notify_slack,
    "webhook": notify_webhook,
    "none": lambda text: None,
}


def html_escape(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def notify_text(text):
    """Dispatch to whichever channel is configured. Split out from `notify` so
    that anything with something to say — a completion, a standup — posts
    through one place and no caller learns the channel's name.

    Accepts a plain string, or sections for something with structure. The
    channel decides how a heading looks; the caller never learns which channel
    it got."""
    load_env()
    name = (os.environ.get("NOTIFY") or "telegram").strip().lower()
    send = NOTIFIERS.get(name)
    if send is None:
        print(f"  ! unknown NOTIFY={name!r}; known: {', '.join(NOTIFIERS)}")
        return False
    # Resolved here rather than at import: the renderers are defined further
    # down, beside the standup that produces the sections they take.
    renderers = {"telegram": render_telegram, "slack": render_slack}
    if isinstance(text, str):
        # Telegram is asked to parse HTML now, so a plain line has to be escaped
        # too — `done` posts a task title, and a title with `<` or `&` in it
        # would otherwise be rejected by the API rather than sent.
        body = html_escape(text) if name == "telegram" else text
    else:
        body = renderers.get(name, render_plain)(text)
    try:
        return send(body)
    except (urllib.error.URLError, OSError) as exc:
        # Never fail the caller because a notification failed.
        print(f"  ! {name} not sent: {exc}")
        return False


def notify(task, ledger):
    who = f"{task.assignee} · " if task.assignee else ""
    return notify_text(f"✓ {task.title} ({task.id})\n{ledger} · {who}{task.done_on}")


