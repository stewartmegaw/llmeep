# ------------------------------------------------------------------- standup

# Every period is a lookback length plus a key. The key is what "already
# reported this period" means; the lookback is what gets reported.
STANDUP_PERIODS = ("daily", "workday", "bidaily", "weekly")

# Minute and hour come from STANDUP_AT; the rest is the period. Cron is the
# only trigger, so nothing has to remember whether this period was reported —
# the schedule *is* that memory.
CRON_TAIL = {
    "daily": "* * *", "workday": "* * 1-5",
    "bidaily": "*/2 * *", "weekly": "* * 1",
}


def standup_period(override=None):
    load_env()
    # Daily by default. A week of closed tasks is a wall of text on a phone,
    # which is where this gets read, and the standup that prompts a decision is
    # the one about yesterday (`PLT-hfwz`).
    name = (override or os.environ.get("STANDUP_PERIOD") or "daily").strip().lower()
    if name not in STANDUP_PERIODS:
        raise Fail(f"unknown period {name!r}; known: {', '.join(STANDUP_PERIODS)}")
    return name


def standup_window(period, today=None):
    """`(start, key)` for the period ending today. `start` is exclusive.

    `(None, None)` means the period does not fire today — only `workday` does
    that, at a weekend.

    The window is a fixed lookback rather than "everything since the last
    standup". The last one may have been sent from a colleague's machine, so a
    since-then window would make the contents depend on who ran it. A little
    overlap when someone reports early is the cheaper fault.
    """
    today = today or date.today()
    if period == "daily":
        return today - timedelta(days=1), today.isoformat()
    if period == "workday":
        if today.weekday() >= 5:
            return None, None
        # Monday reaches back over the weekend; nothing fires during one.
        return today - timedelta(days=3 if today.weekday() == 0 else 1), today.isoformat()
    if period == "bidaily":
        # Buckets counted from the ordinal epoch, so two machines agree on
        # where the boundary falls without sharing any state.
        bucket = date.fromordinal((today.toordinal() // 2) * 2)
        return today - timedelta(days=2), f"{bucket.isoformat()}+2d"
    year, week, _ = today.isocalendar()
    return today - timedelta(days=7), f"{year}-W{week:02d}"


def standup_sections(period, today=None):
    """The report as (heading, lines), or None when there is nothing worth
    anyone's attention."""
    today = today or date.today()
    start, _ = standup_window(period, today)
    if start is None:
        return None
    done = [r for r in history_rows()
            if start.isoformat() < r["date"] <= today.isoformat()]
    live = []
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail:
            continue
        live.extend(board.in_progress)
    # Computed before the emptiness test: a period with nothing closed and
    # nothing running still has a standup worth holding if there is a queue or
    # anything captured. Silence is for a repo with no state at all.
    extras = standup_next() + standup_notes()
    if not done and not live and not extras:
        return None

    # (heading, [line, …]). Structure rather than a formatted string, because
    # this is read on a terminal, in Telegram and in Slack, and each wants its
    # own emphasis — the notifier is swappable and the standup must not care
    # which one it is talking to (`DEC-008`, `PLT-2mv7`).
    sections = [(f"{start.isoformat()} → {today.isoformat()}", [])]
    by_who = {}
    for row in done:
        by_who.setdefault(row.get("who") or "unassigned", []).append(row)
    for who in sorted(by_who):
        sections.append((who if who == "unassigned" else f"@{who}",
                         [f"✓ {r['title']}" for r in by_who[who]]))
    if not done:
        sections.append(("...no recent tasks completed", []))
    if live:
        # The point of the standup is not the trophy cabinet. Work that has sat
        # in progress across a period is the part someone should react to.
        sections.append(("IN PROGRESS",
                         [f"{ledger_tag(t)}  {t.title} — "
                          f"{'@' + t.assignee if t.assignee else 'unassigned'}"
                          for t in live]))
    return sections + extras


STANDUP_LIST = 8   # a standup is read aloud or on a phone; a full board is neither


def ledger_tag(task):
    """`PLT` / `BUS`, taken from the id rather than from which board it was read
    off. One list mixes both ledgers, and without the tag a business line is
    indistinguishable from a platform one — the reader has to already know.

    Reading it off the id means the tag cannot disagree with the task: a line on
    the wrong board is a `check` error, not a mislabelled standup."""
    return task.id.split("-")[0].upper()


def render_plain(sections):
    """The terminal, and any channel that wants no markup. Unchanged from what
    the standup printed before it grew renderers."""
    out = []
    for heading, body in sections:
        if out:
            out.append("")
        out.append(heading)
        out += [f"  {line}" for line in body]
    return "\n".join(out)


def render_telegram(sections):
    """HTML rather than MarkdownV2. MarkdownV2 demands `_ * [ ] ( ) ~ ` > # + -
    = | { } . !` be escaped anywhere they appear, and task titles here are full
    of `--force`, `.llmeep` and `ontology/domain/`; one missed escape and the
    API rejects the whole message. HTML needs three characters escaped and `<b>`
    is all this wants."""
    out = []
    for heading, body in sections:
        if out:
            out.append("")
        out.append(f"<b>{html_escape(heading)}</b>")
        out += [f"  {html_escape(line)}" for line in body]
    return "\n".join(out)


def render_slack(sections):
    out = []
    for heading, body in sections:
        if out:
            out.append("")
        out.append(f"*{heading}*")
        out += [f"  {line}" for line in body]
    return "\n".join(out)


def standup_next():
    """What the meeting is actually for. Completed work answers "what happened";
    the queue is the part anyone can still change their mind about, and it was
    the one thing a standup could not show.

    Reads `prioritised` only. The pool is unranked by definition, so listing the
    first eight of it would present arbitrary lines as a plan. When nothing is
    ranked, saying so is the more useful report — an empty queue behind a full
    pool is exactly the thing a standup should surface.

    Both ledgers share one list, tagged per line rather than split under two
    headings. The ordering across them is still a judgement someone made, and
    two sections would either duplicate the eight-line budget or force an
    arbitrary split of it.

    The pool follows under its own heading. Listing it *as the queue* would
    present arbitrary lines as a plan, which is what `DEC-027` refused; listing
    it under `BACKLOG` claims nothing about order and answers the question the
    queue cannot — what else is there? Each heading carries its full count, so
    a truncated section still says how much it is standing in for."""
    queued, pooled = [], []
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail:
            continue
        queued.extend(board.prioritised)
        pooled.extend(board.backlog)
    out = []
    if queued:
        out.append((f"PRIORITY ({len(queued)})", standup_lines(queued)))
    elif pooled:
        # An empty queue behind a full pool is the most actionable thing a
        # standup can say, so it gets a heading of its own rather than being
        # inferred from the absence of one.
        out.append(("PRIORITY (0)", ["· nothing prioritised"]))
    if pooled:
        # Newest first, matching `recent`. Sorting happens here and nowhere
        # else: the pool is unordered by design (`DEC-027`), so this is a view,
        # not an ordering — nothing writes the board back in this sequence.
        # Undated lines predate `filed:` and sort last, which is where the
        # oldest belong under DESC anyway.
        pooled.sort(key=lambda t: t.filed or "", reverse=True)
        out.append((f"BACKLOG ({len(pooled)})", standup_lines(pooled)))
    return out


def standup_lines(tasks):
    """Body lines for one list of tasks — capped, tagged, and honest about what
    the cap hid. The heading carries the full count, so the trailing "…and N
    more" is what makes the truncation visible in the lines themselves.

    The filing date sorts the pool and is never printed (`DEC-030`). It is a
    tiebreak for a list with no order of its own, not a fact anyone reads a
    standup to learn, and a date column beside eight titles invites being read
    as a deadline."""
    body = []
    for t in tasks[:STANDUP_LIST]:
        body.append(f"{ledger_tag(t)}  {t.title}"
                    + (f" — @{t.assignee}" if t.assignee else ""))
    if len(tasks) > STANDUP_LIST:
        body.append(f"…and {len(tasks) - STANDUP_LIST} more")
    return body


def standup_notes():
    """Captured but not yet acted on — the material a standup exists to turn
    into decisions.

    Reads `notes/` directly and shrugs when it is absent, the same way `nm`
    reads this ledger (`DEC-022`). The two subsystems stay liftable apart:
    neither requires the other, and each is better when both are there.
    """
    path = os.path.join(REPO, "notes", "notes.md")
    if not os.path.exists(path):
        return []
    notes = []
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if not line.startswith("NTE-"):
                continue
            body = line.split(None, 1)[1] if " " in line else ""
            body = re.sub(r"\s{2,}(src|task):\S+", "", body).strip()
            promoted = "task:" in line
            notes.append((body, promoted))
    unpromoted = [n for n in notes if not n[1]]
    if not unpromoted:
        return []
    body = [f"· {text}" for text, _ in unpromoted[:STANDUP_LIST]]
    if len(unpromoted) > STANDUP_LIST:
        body.append(f"…and {len(unpromoted) - STANDUP_LIST} more")
    return [("CAPTURED, NOT YET WORK", body)]


def standup_cron(period):
    """The crontab line for this period, pointing at the blueprint rather than
    at `tm`. A scheduled checkout is stale by definition — it has to fetch
    before it can report — and that fetch is the part only the operator can
    configure, so it lives in a script they own."""
    at = (os.environ.get("STANDUP_AT") or "09:00").strip()
    try:
        hour, minute = (int(part) for part in at.split(":"))
        if not (0 <= hour < 24 and 0 <= minute < 60):
            raise ValueError(at)
    except ValueError:
        raise Fail(f"STANDUP_AT={at!r} is not HH:MM")
    script = os.path.join(HERE, "blueprints", "standup.sh")
    log = os.path.join(REPO, ".notes", "standup.log")
    return (f"{minute} {hour} {CRON_TAIL[period]} REPO={REPO} {script}"
            f" >>{log} 2>&1")


def cmd_standup_cron(period):
    at = os.environ.get("STANDUP_AT") or "09:00"
    print(f"\n  {standup_cron(period)}\n")
    print(f"  {period} standup at {at}, on whatever machine is already always-on."
          "\n  It calls tasks/blueprints/standup.sh — read that first; it needs a"
          "\n  checkout and a .env of its own, and it fetches before it reports."
          "\n"
          "\n  Optional. Most standups are someone running `tm standup` before the"
          "\n  call and reading it out.")


def cmd_standup(args):
    override, args = take_flag(args, "--period")
    period = standup_period(override)
    if "--cron" in args:
        return cmd_standup_cron(period)
    sections = standup_sections(period)
    if sections is None:
        print(f"  nothing to report this {period} period")
        return
    print()
    for line in render_plain(sections).split("\n"):
        print(f"  {line}".rstrip())
    print()
    if "--send" not in args:
        print("  not sent — add --send to post it to the team")
        return
    channel = notify_text(sections)
    if channel:
        print(f"  sent via {channel}")
    elif channel is None:
        print("  ! not sent — no channel configured, see .env.example")
    else:
        print("  ! not sent — the channel rejected it; the reason is above")


def new_id(prefix, taken):
    for _ in range(100):
        tid = f"{prefix}-{''.join(secrets.choice(ALPHABET) for _ in range(ID_LEN))}"
        if tid not in taken:
            return tid
    raise Fail("could not allocate a free id")


def all_known_ids():
    ids = {r["id"] for r in history_rows()}
    for ledger in LEDGERS:
        try:
            ids |= Board(ledger).all_ids()
        except Fail:
            pass
    return ids


def take_flag(args, flag):
    """Pull `--flag value` out of argv, returning (value, remaining)."""
    if flag not in args:
        return None, args
    i = args.index(flag)
    value = args[i + 1] if i + 1 < len(args) else None
    return value, args[:i] + args[i + 2:]


def cmd_add(args):
    """`--id` prints only the allocated id, so another tool can consume it
    without parsing prose — `nm promote` is the caller."""
    quiet = "--id" in args
    ledger = "business" if "-b" in args else "platform"
    top = "-n" in args
    who, args = take_flag(args, "-f")
    title = " ".join(a for a in args if a not in ("-b", "-n", "--id")).strip()
    if not title:
        raise Fail('usage: tm add [-b] [-n] [-f <name>] <title...>')
    errors, warnings = title_problems(title)
    if not quiet:
        for w in warnings:
            print(f"  ~ {w}")
    if errors:
        raise Fail(errors[0])
    board = Board(ledger)
    if not quiet:
        show_related(title)  # before allocating, so a duplicate can be abandoned
    task = Task(new_id(LEDGERS[ledger], all_known_ids()), title)
    task.assign(slug(who))
    # Write-once, and only ever by the branch that created the line — which is
    # why this is exempt from the board's no-metadata rule. A field two sides
    # can both edit conflicts; one that is set at birth and never touched again
    # cannot, and the union rule for open lines already covers it.
    task.tags.append(f"filed:{date.today().isoformat()}")
    # Filing costs no ranking decision: everything lands in the pool, and
    # deciding it is next is the separate, deliberate act `-n` performs.
    if top:
        board.prioritised.insert(0, task)
    else:
        board.backlog.append(task)
    board.save()
    if quiet:
        print(task.id)
        return
    print(f"\n  {task.id}  {task.title}")
    assigned = f" · @{task.assignee}" if task.assignee else ""
    print(f"  {ledger} · {'top of prioritised' if top else 'backlog'}{assigned}")
    skeleton_nudge()


def cmd_go(args):
    """WIP-1 is per person, not per board.

    A single global in-progress slot assumes a single worker. Once tasks carry an
    assignee, two people each having one in progress is the normal case — so
    the limit follows the assignee.
    """
    named, rest = take_flag(args, "-f")  # -f <name>: start on someone's behalf
    who = slug(named) if named else whoami()
    tid = rest[0] if rest else None

    for ledger in LEDGERS:
        board = Board(ledger)
        # An unassigned task in progress predates assignees, or was started with
        # no git identity. Treat it as the caller's and assign it, rather than
        # leaving it invisible to everyone — which would let a second task start
        # and quietly break WIP-1.
        mine = [t for t in board.in_progress if t.assignee in (who, None)]
        if mine:
            current = mine[0]
            if tid and current.id.lower() != tid.lower():
                raise Fail(
                    f"{current.id} is already in progress — finish or park it first (WIP-1)"
                )
            if current.assignee is None and who:
                current.assign(who)
                board.save()
            return show_task(board, current, started=False)
    if tid:
        for ledger in LEDGERS:
            board = Board(ledger)
            task, bucket = board.find(tid)
            # Naming a task starts it from either section. Prioritising first
            # would be ceremony — saying `go PLT-9puy` *is* the decision, and
            # requiring the step would push people into the board to take it.
            if task and bucket in (board.prioritised, board.backlog):
                return start(board, task, who)
            if task:
                raise Fail(f"{task.id} is not open — it is in progress or completed")
        raise Fail(f"no open task {tid}")
    # Bare `go` reads the queue and nothing else. Picking out of an unordered
    # pool would be the tool choosing your next task, which is the judgement
    # the split exists to keep with a person (principle 7).
    for ledger in LEDGERS:
        board = Board(ledger)
        for task in board.prioritised:
            # Someone else's task is not yours to pick up; name it explicitly
            # if you mean to take it over.
            if task.assignee and task.assignee != who:
                continue
            if not board.is_blocked(task):
                return start(board, task, who)
    pooled = sum(len(Board(l).backlog) for l in LEDGERS)
    raise Fail("nothing startable — every prioritised task is blocked, assigned or absent"
               + (f"; {pooled} in the backlog, none prioritised" if pooled else ""))


def start(board, task, who=None):
    blocker = board.is_blocked(task)
    if blocker:
        raise Fail(f"{task.id} is blocked by {blocker} — finish that first")
    task.assign(who)
    (board.prioritised if task in board.prioritised else board.backlog).remove(task)
    board.in_progress.append(task)
    board.save()
    show_task(board, task, started=True)


def show_task(board, task, started):
    print(f"\n  {task.id}  {task.title}")
    who = f" · @{task.assignee}" if task.assignee else ""
    print(f"  {board.ledger}{who} · {'started' if started else 'in progress'}")
    blocker = board.is_blocked(task)
    if blocker:
        print(f"  ! blocked by {blocker}")
    path = sidecar_path(board.ledger, task.id)
    if path:
        rel = os.path.relpath(path, REPO)
        print(f"\n  detail: {rel}{'/' if os.path.isdir(path) else ''}")
        for extra in sidecar_extras(path):
            print(f"          {extra}")
        pending = unchecked_acceptance(path)
        if pending:
            print("  acceptance:")
            for item in pending:
                print(f"    [ ] {item}")
    show_related(task.title)
    skeleton_nudge()


def cmd_prioritise(args):
    """backlog → prioritised, at the bottom of the queue (`-n` for the top).

    By the reordering exemption this could be a hand edit — moving a line
    between two open sections breaks no invariant, and `go <id>` already starts
    anything from either, so the tool never traps you into needing it. It is a
    command because triage is the one board edit that happens in bulk: ranking
    a week's filings by hand is where a stray line ends up in `recent` with no
    date, which `check` catches but only after the fact.

    Hand editing stays entirely valid. This writes the same file the same way.
    """
    top = "-n" in args
    rest = [a for a in args if a != "-n"]
    if not rest:
        raise Fail("usage: tm prioritise <id> [-n]")
    for tid in rest:
        moved = False
        for ledger in LEDGERS:
            board = Board(ledger)
            task, bucket = board.find(tid)
            if not task:
                continue
            if bucket is board.prioritised:
                raise Fail(f"{task.id} is already prioritised")
            if bucket is not board.backlog:
                raise Fail(f"{task.id} is not in the backlog — "
                           "it is in progress or completed")
            board.backlog.remove(task)
            board.prioritised.insert(0, task) if top else board.prioritised.append(task)
            board.save()
            print(f"  {task.id}  {task.title}")
            print(f"  {ledger} · {'top' if top else 'bottom'} of prioritised")
            blocker = board.is_blocked(task)
            if blocker:
                # Worth ranking anyway — you are saying it is next once the
                # blocker clears — but a bare `go` will skip straight past it.
                print(f"  ! blocked by {blocker}; `go` will skip it until that closes")
            moved = True
            break
        if not moved:
            raise Fail(f"no task {tid}")


def cmd_park(args):
    """in progress → backlog. The one transition the tool forces you into.

    Moving a line between sections breaks no invariant, so by the reordering
    exemption this could be a hand edit. It is a command because **WIP-1 creates
    the need**: `go` refuses while something is in progress, so anyone switching
    tasks is pushed by the tool's own guard into editing the board — exactly
    what principle 2 exists to prevent. Nothing in `tm` blocks deleting a line,
    which is why dropping stays a hand edit.

    Returns to the *bottom* by default: a parked task is usually one you could
    not continue, and putting it back on top means the next bare `go` restarts
    it. `-n` for the case where it really is still next.
    """
    top = "-n" in args
    rest = [a for a in args if a != "-n"]
    tid = rest[0] if rest else None
    for ledger in LEDGERS:
        board = Board(ledger)
        if tid:
            task, bucket = board.find(tid)
            if task and bucket is not board.in_progress:
                raise Fail(f"{task.id} is not in progress")
        else:
            task = board.in_progress[0] if board.in_progress else None
        if not task:
            continue
        board.in_progress.remove(task)
        task.unassign()  # parked means available; assign again with `go`
        # Back to the queue, not the pool. Something you started was decided
        # work; parking says "not now", not "never ranked this".
        board.prioritised.insert(0, task) if top else board.prioritised.append(task)
        board.save()
        print(f"  {task.id}  {task.title}")
        print(f"  {ledger} · returned to {'top' if top else 'bottom'} of prioritised")
        return
    raise Fail(f"no task {tid} in progress" if tid else "nothing in progress")


def cmd_done(args):
    force = "--force" in args
    rest = [a for a in args if a != "--force"]
    tid = rest[0] if rest else None
    for ledger in LEDGERS:
        board = Board(ledger)
        task, bucket = (board.find(tid) if tid else (None, None))
        if not tid and board.in_progress:
            task, bucket = board.in_progress[0], board.in_progress
        if not task:
            continue
        if bucket is board.recent:
            raise Fail(f"{task.id} is already done")
        pending = unchecked_acceptance(sidecar_path(ledger, task.id))
        if pending and not force:
            print(f"  {task.id} has unmet acceptance criteria:")
            for item in pending:
                print(f"    [ ] {item}")
            sys.stdout.flush()  # so the list lands above the error, not below
            raise Fail("not done — check them off, or pass --force")
        bucket.remove(task)
        # A task completed straight from `open` was never assigned; the person
        # finishing it is the honest answer, and matches the commit author.
        finisher = task.assignee or whoami()
        task.tags = [f"@{finisher}"] if finisher else []
        task.done_on = date.today().isoformat()
        board.recent.insert(0, task)
        board.clear_blocker(task.id)
        board.save()
        history_append(task, ledger)
        sent = notify(task, ledger)
        print(f"  ✓ {task.id}  {task.title}")
        who = f" · {task.assignee}" if task.assignee else ""
        print(f"  {ledger}{who} · {task.done_on}"
              + (f" · {sent} sent" if sent else ""))
        print(f'\n  commit with:  closes {task.id}')
        return
    raise Fail(f"no task {tid}" if tid else "nothing in progress")


def cmd_find(args):
    if not args:
        raise Fail("usage: tm find <term>")
    hits = search(" ".join(args), limit=50)
    if not hits:
        print("  nothing in history")
        return
    for row in hits:
        print("  " + history_line(row))


