        self.assertIn("DEC-999", out.stdout + out.stderr)
        self.assertIn("does not exist", out.stdout + out.stderr)

    def test_a_citation_that_resolves_is_silent(self):
        """The shipped tree cites decisions constantly; every one of them has to
        pass or the check is unusable."""
        top = self.a_repo()
        self.assertEqual(self.tm(top, "check").returncode, 0,
                         "a fresh install already fails its own citation check")

    def test_the_placeholder_is_not_a_claim(self):
        """`DEC-000` is the template's blank and `tm why`'s example. It names
        nothing on purpose."""
        top = self.a_repo()
        self.cite(top, "Copy `DEC-000` and fill it in.")
        self.assertEqual(self.tm(top, "check").returncode, 0)

    def test_prose_about_work_may_name_a_missing_decision(self):
        """A task detail saying "this cites a decision nobody wrote" is a true
        statement, and making it an error would mean the only way to record the
        problem is to not record it."""
        top = self.a_repo()
        tid = self.tm(top, "add", "--id", "-n", "a thing").stdout.strip()
        self.tm(top, "go", tid)
        self.tm(top, "detail")
        detail = next(os.path.join(r, n)
                      for r, _, ns in os.walk(os.path.join(self.install_root(top),
                                                           "tasks", "platform", "tasks"))
                      for n in ns if n.startswith(tid))
        with open(detail, "a") as fh:
            fh.write("\n`DEC-999` was never written, which is the point.\n")
        self.assertEqual(self.tm(top, "check").returncode, 0,
                         "prose about a missing decision was treated as a claim")

    def test_the_source_tree_has_no_dangling_citation(self):
        """The defect itself, asserted where it lives. llmeep's own checkout has
        no manifest, so nothing is skipped and every citation in machinery and
        in the models must resolve against the decisions shipping beside them.

        It caught its own docstring on the first run, which is why nothing in
        that file names the missing one as an example: a check that cannot
        describe itself without failing itself needs an exemption, and the
        exemption is the bug."""
        src = self.working_copy()
        root = os.path.join(src, "llmeep")
        have = {n[:7] for n in os.listdir(os.path.join(root, "decisions"))
                if n.startswith("DEC-")}
        dangling = []
        for base in ("tasks/_tooling", "notes/_tooling", "ontology", "decisions"):
            for dirpath, _, names in os.walk(os.path.join(root, *base.split("/"))):
                for n in names:
                    path = os.path.join(dirpath, n)
                    with open(path, errors="ignore") as fh:
                        text = fh.read()
                    for dec in sorted(set(re.findall(r"DEC-\d{3}", text))):
                        if dec != "DEC-000" and dec not in have:
                            dangling.append(f"{os.path.relpath(path, root)} -> {dec}")
        self.assertEqual(dangling, [], dangling)


class TestUpgrade(Fixture):
    """The axis that was covered by nothing, and where all three bugs lived."""

    def setUp(self):
        super().setUp()
        available = release_tags()
        # Recent releases, plus one from before the layout changed. Without the
        # pinned one the whole migration path goes untested the moment two
        # newer versions exist.
        self.tags = available[:FROM_TAGS]
        if PRE_DEC028 in available and PRE_DEC028 not in self.tags:
            self.tags.append(PRE_DEC028)
        if not self.tags:
            self.skipTest("no release tags in this checkout — nothing to upgrade from")

    def upgrade(self, tag, *adopt_args):
        """Adopt an old release, do real work in it, then update to the working
        copy. `--force` because the working copy is unreleased and update is
        right to refuse that silently — `test_refuses_unreleased` asserts it."""
        src_old = self.clone_tag(tag)
        top = self.a_project(name=f"from-{tag}")
        self.adopt(src_old, top, *adopt_args)
        self.quieten(top)
        self.make_records(top)
        sh("git", "add", "-A", cwd=top)
        sh("git", "commit", "-qm", f"adopt {tag}", cwd=top)
        out = self.adopt(self.working_copy(), top, "--update", "--force")
        return top, out

    def test_upgrade_from_each_recent_release(self):
        """Default folder. Two releases back as well as one, because `--update`
        is allowed to skip versions."""
        for tag in self.tags:
            with self.subTest(tag=tag):
                top, _ = self.upgrade(tag)
                self.assert_healthy(top)
                self.assert_records_survived(top)

    def test_upgrade_of_a_named_folder_install(self):
        """`--into ops`. The v28 split lived in exactly this cell and nowhere
        else — a flat adopter would never have seen it."""
        for tag in self.tags:
            with self.subTest(tag=tag):
                top, _ = self.upgrade(tag, "--into", "ops")
                self.assertTrue(os.path.isdir(os.path.join(top, "ops", "tasks")),
                                "the install folder was renamed by an update")
                self.assert_healthy(top)
                self.assert_records_survived(top)

    def test_upgrade_stops_recording_their_readme_as_the_working_agreement(self):
        """Every release before `PLT-z3hf` wrote the adopter's repo-root README
        into the manifest under the working agreement's key. The upgrade has to
        correct that, or the record outlives the bug and the working agreement
        stays frozen at whatever version it was adopted at. Their README is
        edited first, because an untouched one is the case that happens to come
        out right for the wrong reason.

        The key is read off the install rather than assumed: `v26` predates
        `DEFAULT_INTO` and adopts flat, where the working agreement is
        `LLMEEP.md` and never had a name to collide with."""
        for tag in self.tags:
            with self.subTest(tag=tag):
                src_old = self.clone_tag(tag)
                top = self.a_project(name=f"wa-{tag}")
                self.adopt(src_old, top)
                self.quieten(top)
                with open(os.path.join(top, "README.md"), "a") as fh:
                    fh.write("\nA line the adopter added after adopting.\n")
                sh("git", "add", "-A", cwd=top)
                sh("git", "commit", "-qm", f"adopt {tag}", cwd=top)

                self.adopt(self.working_copy(), top, "--update", "--force")

                root = self.install_root(top)
                nested = os.path.abspath(root) != os.path.abspath(top)
                name = "README.md" if nested else "LLMEEP.md"
                ours = os.path.join(root, name)
                recorded = self.manifest(top)["files"].get(name)
                self.assertEqual(recorded, self.sha16(ours),
                                 f"the upgrade did not record the {name} it left behind")
                if nested:
                    self.assertNotEqual(recorded, self.sha16(os.path.join(top, "README.md")),
                                        "the upgrade left the adopter's README recorded "
                                        "as the working agreement")

    def test_upgrade_leaves_one_ontology(self):
        """Called out separately from assert_no_duplicates because this is the
        regression, and a named test is what a future reader greps for."""
        if PRE_DEC028 not in release_tags():
            self.skipTest(f"{PRE_DEC028} absent — nothing to migrate from")
        top, out = self.upgrade(PRE_DEC028, "--into", "ops")
        for name in self.OURS:
            self.assertTrue(os.path.isfile(os.path.join(top, "ops", "ontology", name)),
                            f"ontology/{name} did not land in the install folder")

    def test_upgrade_keeps_the_adopters_domain_files(self):
        """The migration deletes llmeep's copies and reinstalls them one level
        down. Everything it must *not* touch is the adopter's own model, which
        for most repos is the only reason `ontology/` exists at all."""
        for tag in self.tags:
            with self.subTest(tag=tag):
                top, _ = self.upgrade(tag)
                theirs = self.their_domain_file(top)
                self.assertIsNotNone(theirs,
                                     "the adopter's domain file was moved or deleted")
                with open(theirs) as fh:
                    self.assertIn("our own domain model", fh.read(),
                                  "the adopter's domain file was overwritten")

    def test_latest_resolves_a_release_tag_not_the_branch_tip(self):
        """`PLT-qe3p`. `latest` cloned the *default branch*, which was fine
        while that branch was a cut release. `DEC-035` made a version a tag on
        `main` and the default moved there, so `latest` silently became
        "whatever was committed most recently" — and an install updating
        between tags was told its source was unreleased and refused."""
        tags = release_tags()
        if not tags:
            self.skipTest("no release tags in this checkout")
        # A source with every tag, whose branch tip is deliberately past the
        # newest one — exactly the state `main` is in between releases.
        src = self.path("src-untagged-tip")
        sh("git", "clone", "--quiet", REPO, src, check=True)
        sh("git", "checkout", "-q", "-B", "main", tags[0], cwd=src, check=True)
        with open(os.path.join(src, "after-the-tag.txt"), "w") as fh:
            fh.write("committed after the release\n")
        sh("git", "add", "-A", cwd=src)
        sh("git", "commit", "-qm", "after the tag", cwd=src)

        top = self.a_project()
        self.adopt(self.working_copy(), top)   # an install that has the fix
        self.quieten(top)
        out = sh(sys.executable, os.path.join(top, ".llmeep"), "--update", "--force",
                 cwd=top, env=dict(os.environ, LLMEEP_URL=src))
        blob = out.stdout + out.stderr
        # "unreleased → v37" is the *installed* version being reported and is
        # fine; the failure to catch is the refusal, which names the clone.
        self.assertNotIn("this clone is unreleased", blob,
                         "latest resolved the branch tip instead of a release tag")
        self.assertIn(f"fetching {tags[0]}", blob,
                      f"latest did not resolve to {tags[0]}")

    def test_a_worktree_finds_the_main_checkouts_env(self):
        """`PLT-2wcx`. A worktree is a separate working tree of the same repo and
        `.env` is gitignored, so a worktree never has one — which made `--send`
