class TestChromeDocs(Fixture):
    """`PLT-6yjz`. The records are the point of the repo, so someone who cannot
    read a decision has to take the board on faith. Reading is therefore wider
    than writing — and its boundary is a catalogue rather than a path, so a
    reader can only ever open what the catalogue chose."""

    DRIVER = """import json, os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "llmeep", "ui", "api"))
import server
what = sys.argv[2]
if what == "catalogue":
    print(json.dumps(server.catalogue()))
elif what == "board":
    print(json.dumps({"updated": server.records_changed()}))
elif what == "notes":
    print(json.dumps(json.loads(server.nm("notes", "--json"))))
elif what == "tools":
    print(json.dumps(sorted(server.TOOLS)))
elif what.startswith("bytes:"):
    import hashlib
    try:
        entry, full = server.locate(what[6:])
        raw = open(full, "rb").read()
        print(json.dumps({"ok": {"sha": hashlib.sha256(raw).hexdigest()[:16],
                                 "type": entry["type"], "kind": entry["kind"]}}))
    except Exception as exc:
        print(json.dumps({"error": str(exc)}))
else:
    try:
        print(json.dumps({"ok": server.read_doc(what)}))
    except Exception as exc:
        print(json.dumps({"error": str(exc)}))
"""
    def adopted(self, name, *args):
        top = self.a_project(name=name)
        self.adopt(self.working_copy(), top, *args)
        self.quieten(top)
        return top

    def run_driver(self, top, arg):
        script = self.path("drive_docs.py")
        with open(script, "w") as fh:
            fh.write(self.DRIVER)
        env = dict(os.environ, LLMEEP_REPO=top, LLMEEP_AUTH_HANDLED="yes")
        out = sh(sys.executable, script, self.working_copy(), arg, cwd=top, env=env)
        self.assertTrue(out.stdout.strip(), out.stderr)
