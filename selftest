class TestRefreshHook(Fixture):
    """`PLT-ks8p`. The app pushes what it commits (`DEC-053`), which makes it a
    writer on a branch other people write to — and a checkout that never fetches
    drifts until its next commit is a merge nobody asked for. This is the inbound
    half: one endpoint anything can fire, and the records settled by the model
    rather than by git's opinion of them."""

    DRIVER = """import json, os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "llmeep", "ui", "api"))
import server
payload = json.loads(sys.argv[2])
try:
    print(json.dumps({"ok": server.refresh(payload)}))
except Exception as exc:
    print(json.dumps({"error": str(exc)}))
"""

    def a_pair(self, name):
        """A bare remote, this container's checkout, and a second clone standing
        in for whoever else pushes."""
        bare = self.path(f"{name}-origin.git")
        sh("git", "init", "-q", "--bare", bare)
        top = self.a_project(name=name)
        sh("git", "remote", "add", "origin", bare, cwd=top)
        branch = sh("git", "rev-parse", "--abbrev-ref", "HEAD", cwd=top).stdout.strip()
        sh("git", "push", "-q", "-u", "origin", branch, cwd=top)
        self.adopt(self.working_copy(), top)
        self.quieten(top)
        sh("git", "add", "-A", cwd=top)
        sh("git", "commit", "-qm", "adopt", cwd=top)
        sh("git", "push", "-q", cwd=top)

        other = self.path(f"{name}-other")
        sh("git", "clone", "-q", bare, other)
        sh("git", "-C", other, "config", "user.name", "someone")
        sh("git", "-C", other, "config", "user.email", "someone@example.com")
        return top, bare, other

    def their_tm(self, other, *args):
        return sh(os.path.join(other, "llmeep", "tasks", "_tooling", "tm"), *args, cwd=other)

    def they_push(self, other, message):
        sh("git", "add", "-A", cwd=other)
        out = sh("git", "commit", "-qm", message, cwd=other)
        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
        push = sh("git", "push", "-q", cwd=other)
        self.assertEqual(push.returncode, 0, push.stdout + push.stderr)

    def hook(self, top, payload=None):
        script = self.path("drive_hook.py")
        with open(script, "w") as fh:
            fh.write(self.DRIVER)
        env = dict(os.environ, LLMEEP_REPO=top, LLMEEP_AUTH_HANDLED="yes")
        out = sh(sys.executable, script, self.working_copy(),
                 json.dumps(payload or {}), cwd=top, env=env)
        self.assertTrue(out.stdout.strip(), out.stderr)
        result = json.loads(out.stdout.strip().split("\n")[-1])
        self.assertNotIn("error", result, result)
        return result["ok"]

    def board(self, top):
        with open(os.path.join(self.install_root(top),
