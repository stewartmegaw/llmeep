        self.work(top, "y = 2")
        self.assertIn(self.NUDGE, self.commit(top, "some work").both)

    def test_a_closes_trailer_satisfies_the_nudge(self):
        """The documented order — `add`, `go`, work, `done`, commit — left
        nothing in progress by commit time, so the correctly-ordered commit was
        the one being warned about, every time."""
