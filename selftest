        tid = self.filed(top, "which section does this belong in")
        self.commit(top, "base")
        said = self.diverge(top,
                            theirs=lambda: self.tm(top, "prioritise", tid),
                            ours=lambda: self.tm(top, "add", "something else"))
        self.assertIn(tid, self.section(top, "prioritised"), self.board(top))
        self.assertNotIn(tid, self.section(top, "backlog"))
