        line = next(l for l in self.board(top).split("\n") if l.startswith(yours))
        self.assertNotIn("@", line, "a task returned to the queue kept its assignee")
        self.assertNotIn("since:", line, "it kept the anchor from being started")
        self.assertIn("in progress on the other side", said)
        self.assertEqual(self.tm(top, "check").returncode, 0, self.board(top))

