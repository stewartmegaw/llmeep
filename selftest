        self.work(top, "w = 4")
        before = sh("git", "rev-list", "--count", "HEAD", cwd=top).stdout.strip()
        out = self.commit(top, "do the work\n\ncloses PLT-zzzz")
        self.assertIn(self.NUDGE, out.both, "a bogus trailer silenced the nudge")
        self.assertIn("no such task exists", out.both)
        after = sh("git", "rev-list", "--count", "HEAD", cwd=top).stdout.strip()
        self.assertEqual(before, after, "a commit with a bogus trailer landed")

