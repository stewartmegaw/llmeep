                            theirs=lambda: self.tm(top, "go", yours),
                            ours=lambda: self.tm(top, "go", mine))
        self.assertEqual(self.section(top, "in progress"), [mine], self.board(top))
        self.assertEqual(self.section(top, "prioritised")[0], yours,
