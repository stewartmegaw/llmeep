#!/usr/bin/env python3
"""selftest — does the thing an adopter runs still work?

`tm check` validates records: boards parse, ids are unique, links resolve. It
has never checked *behaviour*, and on 2026-08-04 three bugs shipped through that
gap in two releases — one of which stopped any adopter fetching the release at
all (`PLT-brek`).

All three had the same cause. Everything was tested as a fresh clone or a fresh
adoption, and neither ever upgrades anything, so the update path — the only code
that must understand two versions at once — was covered by nothing.

So this is a matrix, not a checklist: **layout** against **transition**.

    python3 selftest              # everything
    python3 selftest -k update    # one axis
    python3 selftest -v

Standard library only, no network, and every repo it builds lives in a temp
directory that is removed afterwards. It never touches the repo it is run from.

Upgrade cases clone release tags of this repository, which pins what they are
upgrading *from*. A checkout with no tags skips them and says so rather than
failing — a shallow CI clone is not a broken suite.

Deliberately not wired into the pre-commit hook: it is the first slow thing
here, and a slow hook gets bypassed, taking `check` with it.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unittest

REPO = os.path.dirname(os.path.abspath(__file__))

# What upgrade cases start from. Two back, so a release is exercised against the
# one before it and the one before that — `--update` is allowed to skip versions
# and nothing else proves it can.
FROM_TAGS = 2

# The last release that nested `ontology/` inside the install folder. The
# `DEC-028` migration only has anything to do when upgrading across that
# boundary, so this is pinned rather than tracking the newest tags — which
# drift away from it with every release and quietly stop testing it.
PRE_DEC028 = "v26"

# The last release with no `tm feedback` at all. Pinned for the same reason as
# above: `release_tags()[0]` is now a release that *has* the command, so a test
# reaching for "the newest tag" stopped exercising the too-old path the moment
# v34 shipped — silently, and it did.
PRE_FEEDBACK = "v33"


def sh(*args, cwd=None, env=None, check=False):
    e = dict(os.environ, **(env or {}))
    e.setdefault("NOTIFY", "none")      # belt and braces; every repo also gets a .env
    out = subprocess.run(args, cwd=cwd, capture_output=True, text=True, env=e)
    if check and out.returncode != 0:
        raise AssertionError(f"{' '.join(args)} failed in {cwd}:\n{out.stdout}\n{out.stderr}")
    return out


def release_tags():
    """Newest first. Empty for a checkout without tags."""
    out = sh("git", "tag", "--list", "v*", cwd=REPO).stdout.split()
    return sorted((t for t in out if t[1:].isdigit()),
                  key=lambda t: int(t[1:]), reverse=True)


class Fixture(unittest.TestCase):
    """A throwaway repo, and the assertions every case shares."""

    def setUp(self):
        self.tmp = tempfile.mkdtemp(prefix="llmeep-selftest-")
        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)

    def path(self, *parts):
        return os.path.join(self.tmp, *parts)

    # ---------------------------------------------------------------- builders

    def a_project(self, name="project", extra_dirs=()):
        """Someone else's repo: their code, their history, their README."""
        top = self.path(name)
        os.makedirs(os.path.join(top, "src"))
        with open(os.path.join(top, "src", "app.py"), "w") as fh:
            fh.write("print('theirs')\n")
        with open(os.path.join(top, "README.md"), "w") as fh:
            fh.write("# their project\n")
        for d in extra_dirs:
            os.makedirs(os.path.join(top, d), exist_ok=True)
            with open(os.path.join(top, d, "keep.md"), "w") as fh:
                fh.write("theirs\n")
        self.git_init(top)
        return top

    def git_init(self, top):
        sh("git", "init", "-q", ".", cwd=top, check=True)
        sh("git", "config", "user.email", "selftest@example.com", cwd=top, check=True)
        sh("git", "config", "user.name", "selftest", cwd=top, check=True)
        sh("git", "add", "-A", cwd=top)
        sh("git", "commit", "-qm", "initial", cwd=top)

    def clone_tag(self, tag):
        """A checkout of a released version, to install or upgrade from."""
        dest = self.path(f"src-{tag}")
        sh("git", "clone", "--quiet", "--branch", tag, REPO, dest, check=True)
        return dest

    def working_copy(self):
        """This repo as it stands, uncommitted changes included — the version
        under test. Copied rather than cloned so a change is covered before it
        is committed, which is the whole point of running this before a cut."""
        dest = self.path("src-working")
        if not os.path.isdir(dest):
            shutil.copytree(REPO, dest,
                            ignore=shutil.ignore_patterns(".git", "__pycache__", "*.pyc"))
        return dest

    def adopt(self, src, top, *args, expect_ok=True):
        out = sh(sys.executable, os.path.join(src, "adopt"), *args, cwd=top)
        if expect_ok and out.returncode != 0:
            raise AssertionError(f"adopt {' '.join(args)} failed:\n{out.stdout}\n{out.stderr}")
        return out

    def install_root(self, top):
        """Where the record trees landed — the repo root for a flat install."""
        for candidate in ("llmeep", "ops"):
            if os.path.isdir(os.path.join(top, candidate, "tasks", "_tooling")):
                return os.path.join(top, candidate)
        return top

    def manifest(self, top):
        """`.llmeep`'s header, parsed the way anything reading an install has to
        — out of the file, without running it."""
        with open(os.path.join(top, ".llmeep")) as fh:
            m = re.search(r"# llmeep:manifest[^\n]*\n(.*?)\n# llmeep:manifest-end",
                          fh.read(), re.S)
        self.assertIsNotNone(m, ".llmeep carries no manifest header")
        return json.loads("\n".join(l.lstrip("# ") for l in m.group(1).split("\n")))

    def ontology_root(self, top):
        """Where `ontology/` is *before* an update. Pre-`DEC-028` installs keep
        it inside the install folder and later ones at the repo root, so a
        fixture writing the adopter's own file cannot assume the answer.

        Useless for asserting *afterwards*: `DEC-032` puts llmeep's ontology in
        the install folder and leaves theirs wherever it was, so both candidates
        exist and this cannot tell you whose is whose. Use `their_domain_file`.
        """
        nested = os.path.join(self.install_root(top), "ontology")
        return nested if os.path.isdir(nested) else os.path.join(top, "ontology")

    def their_domain_file(self, top):
        """The adopter's own domain file, wherever the migration left it — which
        is wherever it already was, that being the whole point."""
        for base in (top, self.install_root(top)):
            p = os.path.join(base, "ontology", "domain", "orders.md")
            if os.path.isfile(p):
                return p
        return None

    def quieten(self, top):
        """No test may reach Telegram. `done` notifies, and a suite that posts to
        the team channel is a suite nobody runs twice."""
        with open(os.path.join(self.install_root(top), ".env"), "w") as fh:
            fh.write("NOTIFY=none\n")

    # -------------------------------------------------------------- assertions

    def tm(self, top, *args):
        return sh(os.path.join(self.install_root(top), "tasks", "_tooling", "tm"),
                  *args, cwd=top)

    def nm(self, top, *args):
        return sh(os.path.join(self.install_root(top), "notes", "_tooling", "nm"),
                  *args, cwd=top)

    def assert_tooling_runs(self, top):
        """The one assertion that would have caught the update crash: the tools
        run, from where they were actually installed."""
        for name, out in (("tm check", self.tm(top, "check")),
                          ("nm check", self.nm(top, "check"))):
            self.assertEqual(out.returncode, 0, f"{name} failed:\n{out.stdout}\n{out.stderr}")

    # llmeep's own ontology files, which since `DEC-032` belong under the
    # install folder and nowhere else. Named rather than checking the directory,
    # because a repo-root `ontology/` holding the *adopter's* files is correct
    # and must not be mistaken for a duplicate.
    OURS = ("principles.md", "core.md", "domain-ontology.md", "domain-template.md")

    def assert_no_duplicates(self, top):
        """Exactly one of each tree. The v28 update installed a second
        `ontology/` at the root and orphaned the adopter's behind it; `DEC-032`
        then moved ours in for good, so the root copy is the one that must go."""
        root = self.install_root(top)
        for tree in ("tasks", "notes", "decisions", "ontology"):
            here = os.path.isdir(os.path.join(root, tree))
            there = root != top and os.path.isdir(os.path.join(top, tree))
            self.assertTrue(here, f"{tree}/ missing from the install")
            if tree != "ontology":
                self.assertFalse(there, f"{tree}/ exists at the root *and* in the install")
        for name in self.OURS:
            self.assertTrue(os.path.isfile(os.path.join(root, "ontology", name)),
                            f"ontology/{name} missing from the install")
            if root != top:
                self.assertFalse(os.path.isfile(os.path.join(top, "ontology", name)),
                                 f"ontology/{name} is llmeep's and was left at the repo root")

    def assert_paths_resolve(self, top):
        """Everything that names a path names one that is there. An allowlist
        matching nothing prompts for every command; a skill naming the wrong
        path sends an agent at a file that does not exist."""
        import json
        import re
        settings = os.path.join(top, ".claude", "settings.json")
        if os.path.exists(settings):
            with open(settings) as fh:
                allow = json.load(fh).get("permissions", {}).get("allow", [])
            for entry in allow:
                m = re.search(r"Bash\(\.?/?(\S+/(?:tm|nm))[ )]", entry)
                if m:
                    self.assertTrue(os.path.exists(os.path.join(top, m.group(1))),
                                    f"settings.json allows {m.group(1)}, which does not exist")
        for skill in ("tm", "nm"):
            p = os.path.join(top, ".claude", "skills", skill, "SKILL.md")
            if not os.path.exists(p):
                continue
            with open(p) as fh:
                refs = set(re.findall(r"([\w./-]*(?:tasks|notes)/_tooling/(?:tm|nm))\b",
                                      fh.read()))
            for ref in refs:
                self.assertTrue(os.path.exists(os.path.join(top, ref)),
                                f"{skill}/SKILL.md names {ref}, which does not exist")
        hooks = sh("git", "config", "core.hooksPath", cwd=top).stdout.strip()
        if hooks:
            self.assertTrue(os.path.isdir(os.path.join(top, hooks)),
                            f"core.hooksPath={hooks} does not exist")

    def assert_healthy(self, top):
        self.assert_tooling_runs(top)
        self.assert_no_duplicates(top)
        self.assert_paths_resolve(top)

    # ------------------------------------------------------------------ records

    def make_records(self, top):
        """Real work, of every kind an update must not lose."""
        out = self.tm(top, "add", "A task that must survive")
        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
        root = self.install_root(top)
        with open(os.path.join(root, "notes", "raw", "capture.md"), "w") as fh:
            fh.write("something worth keeping\n")
        domain = os.path.join(self.ontology_root(top), "domain")
        os.makedirs(domain, exist_ok=True)
        with open(os.path.join(domain, "orders.md"), "w") as fh:
            fh.write("# our own domain model\n")

    def assert_records_survived(self, top):
        root = self.install_root(top)
        with open(os.path.join(root, "tasks", "platform", "board.md")) as fh:
            self.assertIn("A task that must survive", fh.read(), "the board lost a task")
        self.assertTrue(os.path.exists(os.path.join(root, "notes", "raw", "capture.md")),
                        "a raw capture was lost")
        domain = self.their_domain_file(top)
        self.assertIsNotNone(domain, "the adopter's own domain file was lost")
        with open(domain) as fh:
            self.assertIn("our own domain model", fh.read(),
                          "the adopter's domain file was overwritten")


class TestFreshInstall(Fixture):
    """Layout axis, no transition. This half was always covered; it is here so a
    failure says which axis broke rather than only that something did."""

    def test_adopt_builds_records_rather_than_clearing_them(self):
        """`DEC-035`. Nothing llmeep records is copied, so nothing llmeep
        records can arrive — which is what let the release ceremony go. Asserted
        on content, not on a `reset` having run, because there is no longer a
        reset to run."""
        top = self.a_project()
        self.adopt(self.working_copy(), top)
        root = self.install_root(top)

        with open(os.path.join(root, "tasks", "platform", "board.md")) as fh:
            board = fh.read()
        for heading in ("## in progress", "## prioritised", "## backlog", "## recent"):
            self.assertIn(heading, board, f"a fresh board is missing {heading}")
        self.assertNotIn("PLT-", board, "llmeep's own tasks arrived in a fresh install")

        with open(os.path.join(root, "tasks", "_tooling", "history.tsv")) as fh:
            rows = [l for l in fh if l.strip() and not l.startswith("#")]
        self.assertEqual(rows, [], "llmeep's task history arrived in a fresh install")

        with open(os.path.join(root, "notes", "notes.md")) as fh:
            self.assertNotIn("NTE-", fh.read(), "llmeep's notes arrived in a fresh install")

        left = [f for f in os.listdir(os.path.join(root, "decisions")) if f.startswith("DEC-")]
        self.assertEqual(left, [], "llmeep's decisions arrived in a fresh install")

        # And the built board is a board the tool can actually drive — the guard
        # on `adopt` knowing the record format at all.
        self.quieten(top)
        self.assertEqual(self.tm(top, "add", "the first thing").returncode, 0)
        with open(os.path.join(root, "tasks", "platform", "board.md")) as fh:
            after = fh.read()
        self.assertIn("the first thing", after.split("## backlog")[1],
                      "a filed task did not land in the backlog of a built board")
        self.assert_healthy(top)

    def test_a_dirty_source_cannot_reach_an_adopter(self):
        """The property the whole change buys: what the clone contains stopped
        mattering. llmeep's own checkout is as dirty a source as exists — full
        boards, full history, thirty-odd decisions — and it is what every other
        case here installs from."""
        src = self.working_copy()
        with open(os.path.join(src, "llmeep", "tasks", "platform", "board.md")) as fh:
            self.assertIn("PLT-", fh.read(), "the source under test has no records to leak")
        top = self.a_project()
        self.adopt(src, top)
        self.quieten(top)
        self.assert_healthy(top)

    def test_adopt_default_folder(self):
        top = self.a_project()
        self.adopt(self.working_copy(), top)
        self.quieten(top)
        self.assertTrue(os.path.isdir(os.path.join(top, "llmeep", "tasks")))
        self.assert_healthy(top)

    def test_adopt_into_named_folder(self):
        top = self.a_project()
        self.adopt(self.working_copy(), top, "--into", "ops")
        self.quieten(top)
        self.assertTrue(os.path.isdir(os.path.join(top, "ops", "tasks")))
        self.assert_healthy(top)

    def test_adopt_beside_their_own_tasks_directory(self):
        """The case nesting exists for: a repo that already calls something
        `tasks/`. Theirs must survive untouched."""
        top = self.a_project(extra_dirs=("tasks", "notes"))
        self.adopt(self.working_copy(), top)
        self.quieten(top)
        with open(os.path.join(top, "tasks", "keep.md")) as fh:
            self.assertEqual(fh.read(), "theirs\n")
        self.assert_tooling_runs(top)
        self.assert_paths_resolve(top)

    def test_their_code_and_readme_are_untouched(self):
        top = self.a_project()
        readme, app = os.path.join(top, "README.md"), os.path.join(top, "src", "app.py")
        with open(readme) as fh:
            before = fh.read()
        self.adopt(self.working_copy(), top)
        with open(readme) as fh:
            self.assertEqual(fh.read(), before)
        with open(app) as fh:
            self.assertEqual(fh.read(), "print('theirs')\n")


class TestFeedback(Fixture):
    """`DEC-033`. Every assertion here is about what an adopter who never asked
    for this is protected from — a default that spends their tokens, and a file
    about our tooling turning up in their history."""

    def install(self):
        top = self.a_project()
        self.adopt(self.working_copy(), top)
        self.quieten(top)
        return top

    def switch_on(self, top):
        with open(os.path.join(self.install_root(top), ".env"), "a") as fh:
            fh.write("FEEDBACK=on\n")

    def drafts(self, top):
        return os.path.join(self.install_root(top), "feedback.md")

    def test_off_by_default_and_the_command_refuses(self):
        """Off is not a suggestion. If `tm feedback` wrote while off, the switch
        would be a convention an agent could miss, and what is behind it costs
        the adopter money."""
        top = self.install()
        out = self.tm(top, "feedback")
        self.assertEqual(out.returncode, 0)
        self.assertIn("off", out.stdout)

        out = self.tm(top, "feedback", "llmeep made me do this twice")
        self.assertNotEqual(out.returncode, 0, "wrote a draft with the switch off")
        self.assertFalse(os.path.exists(self.drafts(top)),
                         "a repo that never opted in has a feedback file")

    def test_on_writes_a_dated_entry(self):
        """The `## YYYY-MM-DD` split is the contract `PLT-6tpx` reads from
        outside the repo, so it is asserted rather than assumed."""
        top = self.install()
        self.switch_on(top)
        self.assertEqual(self.tm(top, "feedback", "go hid the acceptance").returncode, 0)
        with open(self.drafts(top)) as fh:
            body = fh.read()
        self.assertRegex(body, r"(?m)^## \d{4}-\d{2}-\d{2}$")
        self.assertIn("go hid the acceptance", body)
        self.assertIn("1 draft", self.tm(top, "feedback").stdout)

    def test_drafts_never_enter_the_adopters_history(self):
        """It is about our tooling, not their project. Committed, it would reach
        a team it is not addressed to and then a remote."""
        top = self.install()
        self.switch_on(top)
        self.tm(top, "feedback", "a note about llmeep")
        self.assertEqual(
            sh("git", "check-ignore", "-q",
               os.path.relpath(self.drafts(top), top), cwd=top).returncode, 0,
            "feedback.md is not gitignored in an adopted repo")

    def test_nothing_reaches_the_commit_path(self):
        """`DEC-033` puts the trigger in the agent, not a hook. A committing
        adopter with the switch on must see no new gate and no new output."""
        top = self.install()
        self.switch_on(top)
        self.tm(top, "feedback", "a note about llmeep")
        sh("git", "add", "-A", cwd=top)
        out = sh("git", "commit", "-m", "ordinary work", cwd=top)
        self.assertEqual(out.returncode, 0,
                         f"committing broke with feedback on:\n{out.stdout}\n{out.stderr}")
        self.assertNotIn("feedback", (out.stdout + out.stderr).lower(),
                         "the commit path grew feedback output")


class TestSweep(Fixture):
    """The collecting half of `DEC-033`. A draft is written where the friction
    happened and sent by nobody, so everything here is about a maintainer being
    able to read other people's repos back — and being told when they cannot."""

    def adopted(self, name, *args, drafts=()):
        top = self.a_project(name=name)
        self.adopt(self.working_copy(), top, *args)
        with open(os.path.join(self.install_root(top), ".env"), "w") as fh:
            fh.write("NOTIFY=none\nFEEDBACK=on\n")
        for text in drafts:
            out = self.tm(top, "feedback", text)
            self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
        return top

    def sweep(self, sweeper, *paths):
        """Always llmeep's own `./sweep`, never anything in the install — the
        collecting half does not ship, which `test_the_sweep_never_ships`
        asserts from the other direction."""
        env = dict(os.environ, FEEDBACK_REPOS=":".join(paths), NOTIFY="none")
        return sh(sys.executable, os.path.join(self.working_copy(), "sweep"),
                  cwd=sweeper, env=env)

    def test_reads_every_configured_repo_and_attributes_each_draft(self):
        one = self.adopted("one", drafts=("the first thing that annoyed me",))
        two = self.adopted("two", drafts=("the second thing", "and a third"))
        out = self.sweep(one, one, two)
        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
        self.assertIn("the first thing that annoyed me", out.stdout)
        self.assertIn("and a third", out.stdout)
        self.assertIn("one (1)", out.stdout)
        self.assertIn("two (2)", out.stdout)

    def test_finds_a_nested_install_under_its_own_name(self):
        """`--into ops` is a supported install, so the sweeper cannot assume
        `llmeep/`. `.llmeep` records the folder; that is what it is for."""
        theirs = self.adopted("theirs", "--into", "ops", drafts=("from a nested install",))
        mine = self.adopted("mine")
        self.assertIn("from a nested install", self.sweep(mine, theirs).stdout)

    def test_a_path_that_is_gone_is_reported_not_skipped(self):
        """The reason this is a list and not a glob. A pattern matching nothing
        is indistinguishable from a repo you moved last week."""
        mine = self.adopted("mine")
        out = self.sweep(mine, self.path("no-such-repo"))
        self.assertIn("no-such-repo", out.stdout)
        self.assertIn("not there", out.stdout)

    def test_a_repo_without_llmeep_is_reported_separately(self):
        """Distinct from both *gone* and *quiet*: the path is fine and the
        install is not there, which is a different thing to go and fix."""
        mine = self.adopted("mine")
        plain = self.a_project(name="plain")
        out = self.sweep(mine, plain)
        self.assertIn("no llmeep install", out.stdout)

    def test_quiet_is_not_the_same_as_unreadable(self):
        """An installed repo that drafted nothing contributes nothing and is
        not a problem. If these read alike, a broken sweep looks like a quiet
        week and nobody investigates."""
        mine = self.adopted("mine")
        quiet = self.adopted("quiet")
        out = self.sweep(mine, quiet)
        self.assertIn("nothing drafted", out.stdout)
        self.assertNotIn("!", out.stdout)

    def test_a_draft_landing_on_an_existing_decision_is_surfaced(self):
        """The valuable case, not the discardable one: it means the decision
        never persuaded anyone, or has stopped being true. Written against a
        decision this test owns, so llmeep's real corpus can change freely."""
        mine = self.adopted("mine")
        theirs = self.adopted("theirs", drafts=("the standup should fire from a commit hook",))
        with open(os.path.join(self.working_copy(), "llmeep", "decisions",
                               "DEC-001-scheduler.md"), "w") as fh:
            fh.write("---\nid: DEC-001\ntitle: A scheduler triggers the standup,"
                     " not a commit hook\nstatus: accepted\ndecided: 2026-08-01\n"
                     "---\n\n# DEC-001\n")
        out = self.sweep(mine, theirs)
        self.assertIn("DEC-001", out.stdout)
        self.assertIn("the standup should fire from a commit hook", out.stdout,
                      "the draft was dropped rather than paired with the decision")

    def test_an_install_too_old_to_draft_is_not_read_as_quiet(self):
        """`PLT-a92c`. Every install since long before this feature has a
        `tasks/_tooling/tm`, so presence alone says nothing about whether a repo
        *can* produce a draft. Read as quiet, the most likely breakage in the
        whole pipe is the one that looks healthiest."""
        if PRE_FEEDBACK not in release_tags():
            self.skipTest(f"{PRE_FEEDBACK} not in this checkout")
        top = self.a_project(name="stale")
        self.adopt(self.clone_tag(PRE_FEEDBACK), top)
        out = self.sweep(self.adopted("mine"), top)
        self.assertIn("too old", out.stdout)
        self.assertNotIn("nothing drafted", out.stdout)

    def test_a_repo_that_never_opted_in_says_so(self):
        """The other half of the same defect, and the commoner one: current
        llmeep, switch never touched. It can draft and never will, which is not
        the same as having nothing to say."""
        mine = self.adopted("mine")
        off = self.adopted("off")
        with open(os.path.join(self.install_root(off), ".env"), "w") as fh:
            fh.write("NOTIFY=none\n")
        out = self.sweep(mine, off)
        self.assertIn("off there", out.stdout)

    def test_a_repo_with_drafts_is_never_scolded_about_its_switch(self):
        """Drafts are proof the repo can and did. Reporting the switch
        underneath them would be telling someone to fix what just worked."""
        mine = self.adopted("mine")
        theirs = self.adopted("theirs", drafts=("something worth reading",))
        with open(os.path.join(self.install_root(theirs), ".env"), "w") as fh:
            fh.write("NOTIFY=none\n")
        out = self.sweep(mine, theirs)
        self.assertIn("something worth reading", out.stdout)
        self.assertNotIn("off there", out.stdout)

    def test_another_repos_env_never_reaches_this_process(self):
        """The switch is read out of their `.env`; the rest of that file is
        their notification channel and its token. Importing it would let a
        sweep post through somebody else's bot."""
        mine = self.adopted("mine")
        theirs = self.adopted("theirs")
        with open(os.path.join(self.install_root(theirs), ".env"), "w") as fh:
            fh.write("NOTIFY=telegram\nTELEGRAM_BOT_TOKEN=not-ours\n")
        out = self.sweep(mine, theirs)
        self.assertNotIn("not-ours", out.stdout + out.stderr)

    def test_the_sweep_never_ships(self):
        """`PLT-gpq8`, and the assertion that would have caught it. A client
        project read the collecting half out of its own install and offered its
        owner to point it at a fork — a feature addressed to us, surfacing in a
        repo with no business knowing it exists."""
        top = self.adopted("theirs")
        for dirpath, dirnames, names in os.walk(top):
            dirnames[:] = [d for d in dirnames if d != ".git"]
            for n in names:
                path = os.path.join(dirpath, n)
                try:
                    with open(path) as fh:
                        body = fh.read()
                except (OSError, UnicodeDecodeError):
                    continue
                for term in ("FEEDBACK_REPOS", "--sweep", "cmd_sweep"):
                    self.assertNotIn(
                        term, body,
                        f"{os.path.relpath(path, top)} tells an adopter about "
                        f"the collecting half ({term})")

    def test_the_sweep_has_no_transport_at_all(self):
        """It prints. Sending went with the move — the notifier lives in `tm`,
        and reaching it from here would mean either a second channel dispatcher
        or a *post this text* command in the executable every client installs,
        which is the surface this whole change removes."""
        path = os.path.join(self.working_copy(), "sweep")
        with open(path) as fh:
            imports = [l.strip() for l in fh
                       if l.startswith(("import ", "from ")) or "import " in l]
        for line in imports:
            for mod in ("urllib", "socket", "http", "smtplib", "requests"):
                self.assertNotIn(mod, line,
                                 f"the sweep imports {mod} — it grew a transport")
        # And behaviourally: a flag it does not have must change nothing.
        mine = self.adopted("mine")
        theirs = self.adopted("theirs", drafts=("something worth reading",))
        env = dict(os.environ, FEEDBACK_REPOS=theirs, NOTIFY="none")
        plain = sh(sys.executable, path, cwd=mine, env=env)
        flagged = sh(sys.executable, path, "--send", cwd=mine, env=env)
        self.assertEqual(plain.stdout, flagged.stdout)

    def test_no_configured_repos_is_an_error_not_an_empty_report(self):
        """A sweep reading nothing must not look like a sweep finding nothing —
        the blueprint runs unattended and that difference is the whole signal."""
        mine = self.adopted("mine")
        out = sh(sys.executable, os.path.join(self.working_copy(), "sweep"),
                 cwd=mine, env=dict(os.environ, FEEDBACK_REPOS="", NOTIFY="none"))
        self.assertNotEqual(out.returncode, 0)
        self.assertIn("FEEDBACK_REPOS", out.stdout + out.stderr)


class TestUpgrade(Fixture):
    """The axis that was covered by nothing, and where all three bugs lived."""

    def setUp(self):
        super().setUp()
        available = release_tags()
        # Recent releases, plus one from before the layout changed. Without the
        # pinned one the whole migration path goes untested the moment two
        # newer versions exist.
        self.tags = available[:FROM_TAGS]
        if PRE_DEC028 in available and PRE_DEC028 not in self.tags:
            self.tags.append(PRE_DEC028)
        if not self.tags:
            self.skipTest("no release tags in this checkout — nothing to upgrade from")

    def upgrade(self, tag, *adopt_args):
        """Adopt an old release, do real work in it, then update to the working
        copy. `--force` because the working copy is unreleased and update is
        right to refuse that silently — `test_refuses_unreleased` asserts it."""
        src_old = self.clone_tag(tag)
        top = self.a_project(name=f"from-{tag}")
        self.adopt(src_old, top, *adopt_args)
        self.quieten(top)
        self.make_records(top)
        sh("git", "add", "-A", cwd=top)
        sh("git", "commit", "-qm", f"adopt {tag}", cwd=top)
        out = self.adopt(self.working_copy(), top, "--update", "--force")
        return top, out

    def test_upgrade_from_each_recent_release(self):
        """Default folder. Two releases back as well as one, because `--update`
        is allowed to skip versions."""
        for tag in self.tags:
            with self.subTest(tag=tag):
                top, _ = self.upgrade(tag)
                self.assert_healthy(top)
                self.assert_records_survived(top)

    def test_upgrade_of_a_named_folder_install(self):
        """`--into ops`. The v28 split lived in exactly this cell and nowhere
        else — a flat adopter would never have seen it."""
        for tag in self.tags:
            with self.subTest(tag=tag):
                top, _ = self.upgrade(tag, "--into", "ops")
                self.assertTrue(os.path.isdir(os.path.join(top, "ops", "tasks")),
                                "the install folder was renamed by an update")
                self.assert_healthy(top)
                self.assert_records_survived(top)

    def test_upgrade_leaves_one_ontology(self):
        """Called out separately from assert_no_duplicates because this is the
        regression, and a named test is what a future reader greps for."""
        if PRE_DEC028 not in release_tags():
            self.skipTest(f"{PRE_DEC028} absent — nothing to migrate from")
        top, out = self.upgrade(PRE_DEC028, "--into", "ops")
        for name in self.OURS:
            self.assertTrue(os.path.isfile(os.path.join(top, "ops", "ontology", name)),
                            f"ontology/{name} did not land in the install folder")

    def test_upgrade_keeps_the_adopters_domain_files(self):
        """The migration deletes llmeep's copies and reinstalls them one level
        down. Everything it must *not* touch is the adopter's own model, which
        for most repos is the only reason `ontology/` exists at all."""
        for tag in self.tags:
            with self.subTest(tag=tag):
                top, _ = self.upgrade(tag)
                theirs = self.their_domain_file(top)
                self.assertIsNotNone(theirs,
                                     "the adopter's domain file was moved or deleted")
                with open(theirs) as fh:
                    self.assertIn("our own domain model", fh.read(),
                                  "the adopter's domain file was overwritten")

    def test_upgrade_adds_ignore_rules_that_did_not_exist_at_install(self):
        """A repo adopted before `DEC-033` has no rule for `feedback.md`. If the
        update ships the feature without the rule, the first thing that happens
        is our tooling's feedback committed into their history."""
        top, _ = self.upgrade(self.tags[0])
        self.assertEqual(
            sh("git", "check-ignore", "-q", "llmeep/feedback.md", cwd=top).returncode, 0,
            "an updated install does not ignore feedback.md")

    def test_upgrade_records_where_their_ontology_is(self):
        """Having found their files, the update must say so in `.llmeep` — or
        `tm` keeps asking a question the repo has already answered."""
        for tag in self.tags:
            with self.subTest(tag=tag):
                top, _ = self.upgrade(tag)
                where = self.manifest(top).get("ontology")
                self.assertIsNotNone(where, "the update recorded no ontology path")
                # Asserted by what is *at* the path rather than by the string,
                # which differs per layout and would only be restating the code.
                self.assertTrue(
                    os.path.isfile(os.path.join(top, where, "orders.md")),
                    f"the recorded ontology {where} does not hold their model")

    def test_upgrade_carries_a_recorded_ontology_forward(self):
        """An update rewrites the manifest block wholesale. An answer the
        adopter gave with `tm ontology` has to survive that, or every update
        silently unsets it. Forced same-version reinstall, because the command
        that records the answer only exists from this version on."""
        top = self.a_project()
        self.adopt(self.working_copy(), top)
        self.quieten(top)
        out = self.tm(top, "ontology", "docs/model")
        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
        sh("git", "add", "-A", cwd=top)
        sh("git", "commit", "-qm", "adopt", cwd=top)
        self.adopt(self.working_copy(), top, "--update", "--force")
        self.assertEqual(self.manifest(top).get("ontology"), "docs/model",
                         "the update discarded the recorded ontology path")

    def test_dry_run_changes_nothing(self):
        """It must describe the same run without performing any of it."""
        src_old = self.clone_tag(self.tags[0])
        top = self.a_project()
        self.adopt(src_old, top, "--into", "ops")
        self.quieten(top)
        self.make_records(top)
        before = self.tree_state(top)
        out = self.adopt(self.working_copy(), top, "--update", "--force", "--dry-run")
        self.assertEqual(before, self.tree_state(top),
                         "--dry-run modified the working tree")
        self.assertIn("dry run", out.stdout.lower())

    def test_refuses_unreleased_without_force(self):
        """The guard the upgrade cases step around on purpose. If it stops
        working they would silently start testing nothing."""
        src_old = self.clone_tag(self.tags[0])
        top = self.a_project()
        self.adopt(src_old, top)
        out = self.adopt(self.working_copy(), top, "--update", expect_ok=False)
        self.assertNotEqual(out.returncode, 0,
                            "update accepted an unreleased clone without --force")

    def test_a_refused_update_writes_nothing(self):
        """The v27 crash replaced seventeen files and *then* died, which is
        worse than refusing outright. A refusal must happen before the first
        write — asserted through the going-backwards guard, the one refusal
        that can be triggered without breaking a source on purpose.

        This does not prove the update is atomic. It is not: it copies file by
        file with no rollback, so a failure *after* the guards still leaves a
        half-state (`PLT-fqcz`). What this pins is that the guards come first.
        """
        if len(self.tags) < 2:
            self.skipTest("needs two release tags to go backwards between")
        newer, older = self.tags[0], self.tags[1]
        top = self.a_project()
        self.adopt(self.clone_tag(newer), top)
        self.quieten(top)
        self.make_records(top)
        before = self.tree_state(top)

        out = self.adopt(self.clone_tag(older), top, "--update", expect_ok=False)
        self.assertNotEqual(out.returncode, 0,
                            f"update accepted {older} over {newer} without --force")
        self.assertEqual(before, self.tree_state(top),
                         "a refused update still modified the install")
        self.assert_tooling_runs(top)

    def test_a_kept_file_is_not_recorded_as_ours(self):
        """A path llmeep manages, holding the adopter's own file, must never be
        recorded in the manifest as something llmeep wrote.

        `copy` never overwrites and the update keeps a modified file — but
        `install_self` then recorded the *destination* checksum for both, which
        certified their file as ours. The next update saw a checksum matching
        the record, called it unmodified, and replaced it: protected once,
        silently overwritten the second time.

        Asserted on the manifest at install, because reproducing the overwrite
        end to end needs `--force`, and `--force` legitimately means "replace my
        changes" — a test using it would assert the wrong thing. Found on a real
        repo whose `ontology/core.md` predated its adoption by two weeks
        (`PLT-s9ea`).

        That original path stopped being reachable at `DEC-032`: llmeep's
        ontology installs under the install folder now, so a repo-root
        `ontology/core.md` collides with nothing. The mechanism is unchanged and
        still has to hold, so this moved to `.claude/settings.json` — a managed
        file that genuinely can pre-exist, being the one thing still installed at
        the repo root.
        """
        top = self.a_project()
        target = ".claude/settings.json"
        mine = os.path.join(top, *target.split("/"))
        os.makedirs(os.path.dirname(mine), exist_ok=True)
        with open(mine, "w") as fh:
            fh.write('{"permissions": {"allow": ["Bash(theirs, not llmeep\'s)"]}}\n')
        self.git_init(top)

        src = self.working_copy()
        self.adopt(src, top)

        with open(mine) as fh:
            self.assertIn("theirs, not llmeep's", fh.read(),
                          "adopt overwrote a file that was already there")

        import hashlib
        recorded = self.manifest(top)["files"]

        def sha16(path):
            with open(path, "rb") as fh:
                return hashlib.sha256(fh.read()).hexdigest()[:16]

        self.assertNotEqual(
            recorded.get(target), sha16(mine),
            "the manifest records their file's checksum as ours — a later "
            "update will call it unmodified and replace it")
        self.assertEqual(
            recorded.get(target), sha16(os.path.join(src, *target.split("/"))),
            "a kept file should record what llmeep ships, so it always "
            "compares as modified")

    def tree_state(self, top):
        """Every tracked-ish path and its size, for comparing before and after.
        Sizes rather than hashes: fast, and enough to catch a file replaced."""
        state = {}
        for dirpath, dirnames, names in os.walk(top):
            dirnames[:] = [d for d in dirnames if d != ".git"]
            for n in names:
                p = os.path.join(dirpath, n)
                state[os.path.relpath(p, top)] = os.path.getsize(p)
        return state


