    def test_upgrade_carries_a_recorded_ontology_forward(self):
        """An update rewrites the manifest block wholesale. An answer the
        adopter gave with `tm ontology` has to survive that, or every update
        silently unsets it. Forced same-version reinstall, because the command
        that records the answer only exists from this version on."""
        top = self.a_project()
