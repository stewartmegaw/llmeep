        out = self.adopt(self.working_copy(), top, "--dry-run")
        self.assertNotIn("USER_TYPE", out.stdout)
        self.assertFalse(os.path.exists(os.path.join(self.install_root(top), ".env")))

    def adopt_at_a_terminal(self, top, *answers):
        """`adopt` under a pty, which is the only way `sys.stdin.isatty()` is
        true — and the branch a person actually hits. Everything else here runs
        the pipe path, so without this the interactive half is unexercised."""
        pty = __import__("pty")
        src = self.working_copy()
        pid, fd = pty.fork()
        if pid == 0:                                     # child: becomes adopt
            os.chdir(top)
            os.execv(sys.executable, [sys.executable, os.path.join(src, "adopt")])
        os.write(fd, ("\n".join(answers) + "\n").encode())
        out = b""
        try:
            while True:
                chunk = os.read(fd, 4096)
                if not chunk:
                    break
                out += chunk
        except OSError:                     # the pty raises rather than EOFing
            pass
        os.waitpid(pid, 0)
        return out.decode(errors="replace")

    @unittest.skipUnless(hasattr(os, "fork"), "no pty on this platform")
    def test_at_a_terminal_it_asks_and_writes_the_answers(self):
        """Answerable by name or by number, because both are what people type
        at a numbered list."""
        top = self.a_project()
        out = self.adopt_at_a_terminal(top, "non-coder", "2")
        self.assertIn("Who reads what the agent writes?", out)
        env = self.env(top)
        self.assertIn("USER_TYPE=non-coder", env, f"answer not written:\n{out}")
        self.assertIn("FEEDBACK=on", env, f"numbered answer not taken:\n{out}")
        self.quieten(top)
        self.assertIn("non-coder", self.tm(top, "audience").stdout)

    @unittest.skipUnless(hasattr(os, "fork"), "no pty on this platform")
    def test_at_a_terminal_enter_declines_and_writes_nothing(self):
        """Unset is a real state for both keys, so declining has to be possible
        without typing a word — otherwise the prompt is a forced choice."""
        top = self.a_project()
        self.adopt_at_a_terminal(top, "", "")
        self.assertIsNone(self.env(top), "declining both still wrote a .env")

    def test_notifications_are_named_but_never_configured_here(self):
        """The third thing an adopter needs to know, and the one that is not a
        question: setting it up needs a token from a service, which an install
        cannot go and fetch."""
