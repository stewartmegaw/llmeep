        self.commit(top, "base")

        def theirs():
            self.tm(top, "go", tid)
            self.tm(top, "done", "--force")

        said = self.diverge(top, theirs=theirs,
                            ours=lambda: self.tm(top, "prioritise", tid))
        self.assertIn(tid, self.section(top, "recent"), self.board(top))
        self.assertNotIn(tid, self.section(top, "prioritised"))
