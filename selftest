        which is the surface this whole change removes."""
        path = os.path.join(self.working_copy(), "sweep")
        with open(path) as fh:
            imports = [l.strip() for l in fh
                       if l.startswith(("import ", "from ")) or "import " in l]
        for line in imports:
            for mod in ("urllib", "socket", "http", "smtplib", "requests"):
                self.assertNotIn(mod, line,
                                 f"the sweep imports {mod} — it grew a transport")
        # And behaviourally: a flag it does not have must change nothing.
        mine = self.adopted("mine")
        theirs = self.adopted("theirs", drafts=("something worth reading",))
        env = dict(os.environ, FEEDBACK_REPOS=theirs, NOTIFY="none")
        plain = sh(sys.executable, path, cwd=mine, env=env)
        flagged = sh(sys.executable, path, "--send", cwd=mine, env=env)
        self.assertEqual(plain.stdout, flagged.stdout)

