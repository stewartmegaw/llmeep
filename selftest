        self.assertFalse(os.path.exists(os.path.join(wt, os.path.basename(root), ".env")),
                         "the worktree has its own .env; the test proves nothing")
        env = {k: v for k, v in os.environ.items() if k != "NOTIFY"}
        out = sh(os.path.join(wt, os.path.basename(root), "tasks", "_tooling", "tm"),
