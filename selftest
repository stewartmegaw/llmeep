    def test_the_signature_is_the_gate(self):
        """The app has no login and this route is the one thing a push hook must
        reach, so the signature is the whole gate — and it fails closed when no
        secret is set rather than trusting whatever arrives."""
        top, _, _ = self.a_pair("signed")
        script = self.path("drive_sig.py")
        with open(script, "w") as fh:
            fh.write("""import hashlib, hmac, json, os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "llmeep", "ui", "api"))
import server
body = b'{"ref": "refs/heads/master"}'
out = {"no_secret": server.hook_authentic(body, "sha256=whatever")}
os.environ["HOOK_SECRET"] = "a long random string"
good = "sha256=" + hmac.new(b"a long random string", body, hashlib.sha256).hexdigest()
out["right"] = server.hook_authentic(body, good)
out["wrong"] = server.hook_authentic(body, "sha256=" + "0" * 64)
out["absent"] = server.hook_authentic(body, None)
out["other_body"] = server.hook_authentic(b'{"ref": "refs/heads/other"}', good)
print(json.dumps(out))
""")
        env = dict(os.environ, LLMEEP_REPO=top, LLMEEP_AUTH_HANDLED="yes")
        env.pop("HOOK_SECRET", None)
        out = sh(sys.executable, script, self.working_copy(), cwd=top, env=env)
        self.assertTrue(out.stdout.strip(), out.stderr)
        checked = json.loads(out.stdout.strip().split("\n")[-1])
        self.assertFalse(checked["no_secret"], "it authenticated with no secret configured")
        self.assertTrue(checked["right"], "a correct signature was rejected")
        self.assertFalse(checked["wrong"], "a wrong signature was accepted")
        self.assertFalse(checked["absent"], "a missing signature was accepted")
        self.assertFalse(checked["other_body"],
                         "a signature for different bytes was accepted")


class TestResolve(Fixture):
    """`PLT-u7c3`. `board.md` is one file everyone touches — the cost `DEC-001`
    accepted — and the ontology's **Merging boards** table carried the rules as
    instructions to an agent, with the warning that a textual merge "will
    silently drop task lines, leave two tasks in progress, or drop a history row
    — all of which look fine in the diff".

    Six of those rules are deterministic. These assert them, and assert that the
    seventh says out loud what it chose."""

    def a_repo(self):
        top = self.a_project()
        self.adopt(self.working_copy(), top)
        self.quieten(top)
        sh("git", "add", "-A", cwd=top)
        sh("git", "commit", "-qm", "adopt", cwd=top)
        return top

    def commit(self, top, message):
        sh("git", "add", "-A", cwd=top)
        out = sh("git", "commit", "-m", message, cwd=top)
        self.assertEqual(out.returncode, 0, f"{out.stdout}\n{out.stderr}")

    def branch(self, top, name):
        sh("git", "checkout", "-q", "-b", name, cwd=top)

    def switch(self, top, name):
        sh("git", "checkout", "-q", name, cwd=top)

    def trunk(self, top):
        return sh("git", "rev-parse", "--abbrev-ref", "HEAD", cwd=top).stdout.strip()

    def filed(self, top, title, *flags):
        return self.tm(top, "add", "--id", *flags, title).stdout.strip()

    def board(self, top):
        with open(os.path.join(self.install_root(top),
                               "tasks", "platform", "board.md")) as fh:
            return fh.read()

    def section(self, top, name):
        """Ids in one section of the board on disk. `recent` leads with the
        completion date, which is the trap the resolver fell into."""
        out, current = [], None
        for line in self.board(top).split("\n"):
            if line.startswith("## "):
                current = line[3:].strip()
            elif line.strip() and current == name:
                tokens = line.split()
                out.append(tokens[1] if name == "recent" else tokens[0])
        return out

    def diverge(self, top, theirs, ours):
        """Run `theirs` on a branch and `ours` on the trunk, then merge so the
        two conflict. Returns `tm resolve`'s output."""
        main = self.trunk(top)
        self.branch(top, "other")
        theirs()
        self.commit(top, "their work")
        self.switch(top, main)
        ours()
        self.commit(top, "our work")
        merge = sh("git", "-c", "user.name=t", "-c", "user.email=t@t",
                   "merge", "-m", "merge other", "other", cwd=top)
        self.conflicted = merge.returncode != 0
        out = self.tm(top, "resolve")
        self.assertEqual(out.returncode, 0, out.stdout + out.stderr)
        return out.stdout

    def test_no_merge_says_so(self):
        top = self.a_repo()
        self.assertIn("no merge to settle", self.tm(top, "resolve").stdout)

    def test_a_clean_merge_is_the_case_that_matters(self):
        """The one git is happy with. A drop on one side and a prioritise on the
        other touch different lines, so git takes both edits, asks nobody, and
        the dropped task is back — with nothing in the diff looking wrong. That
        is why this reads three commits and not only index stages."""
        top = self.a_repo()
        tid = self.filed(top, "filed then dropped")
        self.commit(top, "base")
        said = self.diverge(top,
                            theirs=lambda: self.tm(top, "drop", tid),
                            ours=lambda: self.tm(top, "prioritise", tid))
        self.assertFalse(self.conflicted, "git conflicted; this case is the clean merge")
        self.assertIn("HEAD is a merge commit and it got these wrong", said)
        self.assertNotIn(tid, self.board(top), "a dropped task came back through a merge")
        self.assertEqual(self.tm(top, "check").returncode, 0, self.board(top))

    def test_both_sides_additions_survive(self):
        """The cheap case and by far the commonest: two people filed tasks. A
        textual merge drops one of them and the diff looks fine."""
        top = self.a_repo()
        self.tm(top, "add", "-n", "the shared one")
        self.commit(top, "base")
        ids = {}
        self.diverge(top,
                     theirs=lambda: ids.update(theirs=self.filed(top, "filed on theirs")),
                     ours=lambda: ids.update(ours=self.filed(top, "filed on ours")))
        pool = self.section(top, "backlog")
        self.assertIn(ids["ours"], pool)
        self.assertIn(ids["theirs"], pool)
        self.assertEqual(len(pool), 2, self.board(top))
        self.assertEqual(self.tm(top, "check").returncode, 0, self.board(top))

    def test_a_ranking_outranks_the_absence_of_one(self):
        """Someone prioritised it while someone else left it in the pool."""
