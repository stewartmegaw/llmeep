        two = self.filed(top, "closed on ours", "-n")
        self.commit(top, "base")

        def close(tid):
            self.tm(top, "go", tid)
            self.tm(top, "done", "--force")

        said = self.diverge(top, theirs=lambda: close(one), ours=lambda: close(two))
        with open(os.path.join(self.install_root(top),
                               "tasks", "_tooling", "history.tsv")) as fh:
            rows = [l for l in fh.read().split("\n") if l.strip() and not l.startswith("#")]
        self.assertEqual(len(rows), 2, rows)
        self.assertEqual(rows, sorted(rows, key=lambda l: l.split("\t")[0]))
        self.assertIn("history.tsv", said)

    def test_a_conflict_outside_the_records_is_left_alone(self):
        """What a conflict in somebody's source code means is not something this
        knows, and resolving it would be the guard's whole point undone."""
        top = self.a_repo()
        self.tm(top, "add", "-n", "a task to make the board conflict too")
        self.commit(top, "base")

        def theirs():
            with open(os.path.join(top, "src", "app.py"), "w") as fh:
                fh.write("theirs = 1\n")
            self.tm(top, "add", "filed on theirs")

        def ours():
            with open(os.path.join(top, "src", "app.py"), "w") as fh:
                fh.write("ours = 2\n")
