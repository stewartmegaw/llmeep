        a decision taken from them."""
        top, _ = self.install()
        out = self.tm(top, "audience")
        self.assertIn("not declared", out.stdout)
        self.assertIn("off", self.tm(top, "feedback").stdout)

    def test_an_answer_reaches_the_tools_and_stays_out_of_git(self):
        """`.env` is the destination because it is per-person and gitignored.
        Written anywhere committed, one adopter's answer becomes everyone's."""
        top, _ = self.install()
        root = self.install_root(top)
        with open(os.path.join(root, ".env"), "w") as fh:
            fh.write("USER_TYPE=non-coder\nFEEDBACK=on\n")
        self.assertIn("non-coder", self.tm(top, "audience").stdout)
        self.assertEqual(
            sh("git", "check-ignore", "-q",
               os.path.relpath(os.path.join(root, ".env"), top), cwd=top).returncode, 0,
            ".env is not gitignored, so an answer would be committed")

