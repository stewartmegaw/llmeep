    def test_it_writes_records_and_never_the_index(self):
        """`DEC-005` keeps git in the agent's hands: every git call in `tm` is a
        read, so staging and committing stay with whoever ran this."""
        top = self.a_repo()
        self.tm(top, "add", "-n", "the shared one")
        self.commit(top, "base")
        self.diverge(top,
                     theirs=lambda: self.tm(top, "add", "filed on theirs"),
                     ours=lambda: self.tm(top, "add", "filed on ours"))
        # `git diff --cached` lists a conflicted path whatever anyone does — the
        # index holds its three stages. The property is that the path is *still
        # unmerged* afterwards, so finishing the merge is the caller's act.
