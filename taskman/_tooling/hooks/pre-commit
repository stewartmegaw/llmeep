#!/bin/sh
# Validates records before the commit lands. Blocks on errors.
# Logic lives in the executables — hooks are thin (DEC-003).
ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/taskman/_tooling/tm" check --staged --quiet || exit 1
[ -x "$ROOT/notes/nm" ] && { "$ROOT/notes/nm" check --quiet || exit 1; }
exit 0
