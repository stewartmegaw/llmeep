#!/usr/bin/env python3
"""tm — taskman. See taskman/ontology.md for the model.

Four commands: add, go, done, find. Listing is reading the board; reordering is
moving a line in it. Neither is a command.

The tool is deterministic and never interprets intent (principle 7). It takes
explicit flags; the agent invoking it decides what they should be.
"""

import os
import re
import secrets
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import date

ROOT = os.environ.get("TM_ROOT") or os.path.dirname(os.path.abspath(__file__))
HISTORY = os.path.join(ROOT, "history.tsv")
LEDGERS = {"platform": "PLT", "business": "BUS"}
WINDOW = 15
MAX_HITS = 3

# Unambiguous alphabet: no 0/1/i/l/o. 30^4 = 810k, and allocation also checks
# for a local collision, so a clash needs two branches to draw the same value.
ALPHABET = "23456789abcdefghjkmnpqrstuvwxyz"
ID_LEN = 4

TAG_RE = re.compile(r"^(detail|blocked:[A-Za-z]{3}-\S+)$")
ID_RE = re.compile(r"^(PLT|BUS)-\S+$")


class Fail(Exception):
    pass


# ---------------------------------------------------------------- board model


class Task:
    def __init__(self, tid, title, tags=None, done_on=None):
        self.id = tid
        self.title = title
        self.tags = tags or []
        self.done_on = done_on

    @property
    def blocker(self):
        for t in self.tags:
            if t.startswith("blocked:"):
                return t.split(":", 1)[1]
        return None

    @property
    def has_detail(self):
        return "detail" in self.tags

    def render(self):
        line = f"{self.id:<9}{self.title}"
        if self.tags:
            line = f"{line:<58}{'  '.join(self.tags)}"
        return line.rstrip()

    def render_recent(self):
        return f"{self.done_on}  {self.id:<9}{self.title}".rstrip()


class Board:
    """One ledger's live state. Sections are authoritative; order is priority."""

    def __init__(self, ledger):
        self.ledger = ledger
        self.path = os.path.join(ROOT, ledger, "board.md")
        self.doing, self.open, self.recent = [], [], []
        self._load()

    def _load(self):
        if not os.path.exists(self.path):
            raise Fail(f"no board at {self.path}")
        section = None
        with open(self.path) as fh:
            for raw in fh:
                line = raw.rstrip("\n")
                if line.startswith("## "):
                    section = line[3:].strip()
                    continue
                if not line.strip() or line.startswith("#"):
                    continue
                if section == "recent":
                    self.recent.append(self._parse_recent(line))
                elif section in ("doing", "open"):
                    getattr(self, section).append(self._parse(line))

    @staticmethod
    def _split_tags(tokens):
        tags = []
        while tokens and TAG_RE.match(tokens[-1]):
            tags.insert(0, tokens.pop())
        return tokens, tags

    def _parse(self, line):
        tokens = line.split()
        tid = tokens.pop(0)
        tokens, tags = self._split_tags(tokens)
        return Task(tid, " ".join(tokens), tags)

    def _parse_recent(self, line):
        tokens = line.split()
        done_on = tokens.pop(0)
        tid = tokens.pop(0)
        tokens, _ = self._split_tags(tokens)
        return Task(tid, " ".join(tokens), done_on=done_on)

    def all_ids(self):
        return {t.id for t in self.doing + self.open + self.recent}

    def find(self, tid):
        for bucket in (self.doing, self.open, self.recent):
            for t in bucket:
                if t.id.lower() == tid.lower():
                    return t, bucket
        return None, None

    def is_blocked(self, task):
        """A blocker resolved once it is out of open and doing."""
        b = task.blocker
        if not b:
            return None
        live = {t.id for t in self.doing + self.open}
        return b if b in live else None

    def clear_blocker(self, tid):
        for t in self.doing + self.open:
            t.tags = [g for g in t.tags if g != f"blocked:{tid}"]

    def save(self):
        self.recent.sort(key=lambda t: t.done_on, reverse=True)
        del self.recent[WINDOW:]  # pruned entries survive in history.tsv
        out = [f"# {self.ledger}", "", "## doing", ""]
        out += [t.render() for t in self.doing]
        out += ["", "## open", ""]
        out += [t.render() for t in self.open]
        out += ["", "## recent", ""]
        out += [t.render_recent() for t in self.recent]
        with open(self.path, "w") as fh:
            fh.write("\n".join(out).rstrip() + "\n")


# -------------------------------------------------------------------- history


def history_rows():
    if not os.path.exists(HISTORY):
        return []
    rows = []
    with open(HISTORY) as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 4:
                rows.append(dict(zip(("date", "id", "ledger", "title"), parts)))
    return rows


def history_append(task, ledger):
    """Append-only. Never rewritten, so a completion can never be lost."""
    if any(r["id"] == task.id for r in history_rows()):
        raise Fail(f"{task.id} is already in history — ids are never reused")
    new = not os.path.exists(HISTORY)
    with open(HISTORY, "a") as fh:
        if new:
            fh.write("#date\tid\tledger\ttitle\n")
        fh.write(f"{task.done_on}\t{task.id}\t{ledger}\t{task.title}\n")


def search(term, limit=MAX_HITS):
    words = [w for w in re.split(r"\W+", term.lower()) if len(w) > 2]
    if not words:
        return []
    scored = []
    for row in history_rows():
        hay = f"{row['id']} {row['title']}".lower()
        hits = sum(1 for w in words if w in hay)
        if hits:
            scored.append((hits, row["date"], row))
    scored.sort(key=lambda s: (-s[0], s[1]))  # strongest match, then newest
    return [r for _, _, r in scored[:limit]]


def history_line(row):
    title = summarise(row["title"], 42)
    sha = resolve_commit(row["id"])
    return f"{row['id']:<9}{title:<44}{row['date']}" + (f"  {sha}" if sha else "")


def resolve_commit(tid):
    try:
        out = subprocess.run(
            ["git", "log", f"--grep=closes {tid}", "--format=%h", "-1"],
            cwd=ROOT, capture_output=True, text=True, timeout=5,
        )
        return out.stdout.strip() or None
    except Exception:
        return None


def show_related(term):
    """Automatic retrieval (principle 6). Silent when empty, capped at 3 —
    output that is always present with weak matches gets skipped."""
    hits = search(term)
    if not hits:
        return
    print("\n  related history")
    for row in hits:
        print("    " + history_line(row))


# -------------------------------------------------------------------- sidecar


def sidecar_path(ledger, tid):
    d = os.path.join(ROOT, ledger, "tasks")
    if not os.path.isdir(d):
        return None
    for name in sorted(os.listdir(d)):
        if name.startswith(f"{tid}-") and name.endswith(".md"):
            return os.path.join(d, name)
    return None


def unchecked_acceptance(path):
    """Acceptance is optional. Where it exists, it is the gate — with no
    reviewer, it is the only quality gate there is."""
    if not path:
        return []
    section, pending = False, []
    with open(path) as fh:
        for line in fh:
            if line.startswith("## "):
                section = line[3:].strip().lower() == "acceptance"
                continue
            if section and line.strip().startswith("- [ ]"):
                pending.append(summarise(line.strip()[5:]))
    return pending


def summarise(text, width=64):
    """Criteria are prose; a terminal list of them is a reminder, not the text."""
    text = re.sub(r"[*`_]", "", text).strip()
    return text if len(text) <= width else text[: width - 1].rstrip() + "…"


# ------------------------------------------------------------------- telegram


def load_env():
    path = os.path.join(os.path.dirname(ROOT), ".env")
    if not os.path.exists(path):
        return
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                os.environ.setdefault(k.strip(), v.strip().strip("'\""))


def notify(task, ledger):
    load_env()
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat = os.environ.get("TELEGRAM_CHAT_ID")
    if not token or not chat:
        return False
    text = f"✓ {task.id}  {task.title}\n{ledger} · {task.done_on}"
    data = urllib.parse.urlencode({"chat_id": chat, "text": text}).encode()
    try:
        urllib.request.urlopen(
            f"https://api.telegram.org/bot{token}/sendMessage", data, timeout=5
        )
        return True
    except (urllib.error.URLError, OSError) as exc:
        # Never fail a completion because a notification failed.
        print(f"  ! telegram not sent: {exc}")
        return False


# ------------------------------------------------------------------- commands


def new_id(prefix, taken):
    for _ in range(100):
        tid = f"{prefix}-{''.join(secrets.choice(ALPHABET) for _ in range(ID_LEN))}"
        if tid not in taken:
            return tid
    raise Fail("could not allocate a free id")


def all_known_ids():
    ids = {r["id"] for r in history_rows()}
    for ledger in LEDGERS:
        try:
            ids |= Board(ledger).all_ids()
        except Fail:
            pass
    return ids


def cmd_add(args):
    ledger = "business" if "-b" in args else "platform"
    top = "-n" in args
    title = " ".join(a for a in args if a not in ("-b", "-n")).strip()
    if not title:
        raise Fail('usage: tm add [-b] [-n] <title...>')
    board = Board(ledger)
    show_related(title)  # before allocating, so a duplicate can be abandoned
    task = Task(new_id(LEDGERS[ledger], all_known_ids()), title)
    board.open.insert(0, task) if top else board.open.append(task)
    board.save()
    print(f"\n  {task.id}  {task.title}")
    print(f"  {ledger} · {'top of' if top else 'bottom of'} open")
    skeleton_nudge()


def cmd_go(args):
    tid = args[0] if args else None
    for ledger in LEDGERS:
        board = Board(ledger)
        if board.doing:
            current = board.doing[0]
            if tid and current.id.lower() != tid.lower():
                raise Fail(
                    f"{current.id} is already in doing — finish it first (WIP-1)"
                )
            return show_task(board, current, started=False)
    if tid:
        for ledger in LEDGERS:
            board = Board(ledger)
            task, bucket = board.find(tid)
            if task and bucket is board.open:
                return start(board, task)
            if task:
                raise Fail(f"{task.id} is not open")
        raise Fail(f"no open task {tid}")
    for ledger in LEDGERS:
        board = Board(ledger)
        for task in board.open:
            if not board.is_blocked(task):
                return start(board, task)
    raise Fail("nothing startable — every open task is blocked, or there are none")


def start(board, task):
    blocker = board.is_blocked(task)
    if blocker:
        raise Fail(f"{task.id} is blocked by {blocker} — finish that first")
    board.open.remove(task)
    board.doing.append(task)
    board.save()
    show_task(board, task, started=True)


def show_task(board, task, started):
    print(f"\n  {task.id}  {task.title}")
    print(f"  {board.ledger} · {'started' if started else 'in progress'}")
    blocker = board.is_blocked(task)
    if blocker:
        print(f"  ! blocked by {blocker}")
    path = sidecar_path(board.ledger, task.id)
    if path:
        print(f"\n  detail: {os.path.relpath(path, os.path.dirname(ROOT))}")
        pending = unchecked_acceptance(path)
        if pending:
            print("  acceptance:")
            for item in pending:
                print(f"    [ ] {item}")
    show_related(task.title)
    skeleton_nudge()


def cmd_done(args):
    force = "--force" in args
    rest = [a for a in args if a != "--force"]
    tid = rest[0] if rest else None
    for ledger in LEDGERS:
        board = Board(ledger)
        task, bucket = (board.find(tid) if tid else (None, None))
        if not tid and board.doing:
            task, bucket = board.doing[0], board.doing
        if not task:
            continue
        if bucket is board.recent:
            raise Fail(f"{task.id} is already done")
        pending = unchecked_acceptance(sidecar_path(ledger, task.id))
        if pending and not force:
            print(f"  {task.id} has unmet acceptance criteria:")
            for item in pending:
                print(f"    [ ] {item}")
            sys.stdout.flush()  # so the list lands above the error, not below
            raise Fail("not done — check them off, or pass --force")
        bucket.remove(task)
        task.tags, task.done_on = [], date.today().isoformat()
        board.recent.insert(0, task)
        board.clear_blocker(task.id)
        board.save()
        history_append(task, ledger)
        sent = notify(task, ledger)
        print(f"  ✓ {task.id}  {task.title}")
        print(f"  {ledger} · {task.done_on}" + (" · telegram sent" if sent else ""))
        print(f'\n  commit with:  closes {task.id}')
        return
    raise Fail(f"no task {tid}" if tid else "nothing in doing")


def cmd_find(args):
    if not args:
        raise Fail("usage: tm find <term>")
    hits = search(" ".join(args), limit=50)
    if not hits:
        print("  nothing in history")
        return
    for row in hits:
        print("  " + history_line(row))


# ---------------------------------------------------------------------- inbox


def telegram_get(method, **params):
    import json

    load_env()
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    if not token:
        raise Fail("no TELEGRAM_BOT_TOKEN — see `tm check --telegram`")
    url = f"https://api.telegram.org/bot{token}/{method}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    try:
        with urllib.request.urlopen(url, timeout=15) as fh:
            data = json.load(fh)
    except (urllib.error.URLError, OSError) as exc:
        raise Fail(f"could not reach Telegram: {exc}")
    if not data.get("ok"):
        raise Fail(f"Telegram: {data.get('description')}")
    return data.get("result", [])


def telegram_reply(chat_id, text, reply_to=None):
    load_env()
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    params = {"chat_id": chat_id, "text": text}
    if reply_to:
        params["reply_to_message_id"] = reply_to
    try:
        urllib.request.urlopen(
            f"https://api.telegram.org/bot{token}/sendMessage",
            urllib.parse.urlencode(params).encode(), timeout=10,
        )
    except (urllib.error.URLError, OSError):
        pass  # a failed confirmation must not lose the task


OFFSET = "tm-telegram-offset"


def cmd_inbox(args):
    """Drain queued /add messages into tasks.

    Pull rather than push: no daemon, no webhook, no public endpoint. Telegram
    holds the queue until this runs, so capture is instant even though landing
    on the board is not. Run it from cron for near-real-time — same code.

    Not automatic on `add`/`go`: those must never make a network call, or the
    history search stops being free and offline use breaks.
    """
    root = os.path.dirname(ROOT)
    off_path = _gitpath(root, OFFSET)
    offset = 0
    if off_path and os.path.exists(off_path):
        with open(off_path) as fh:
            offset = int(fh.read().strip() or 0)

    updates = telegram_get("getUpdates", offset=offset + 1, timeout=0)
    load_env()
    allowed = os.environ.get("TELEGRAM_CHAT_ID", "").strip()
    added, last = [], offset

    for upd in updates:
        last = max(last, upd.get("update_id", 0))
        msg = upd.get("message") or upd.get("channel_post") or {}
        text = (msg.get("text") or "").strip()
        chat = str((msg.get("chat") or {}).get("id", ""))
        # Only the configured chat may file tasks — anyone can find a bot.
        if allowed and chat != allowed:
            continue
        m = re.match(r"^/(?:add|task)(?:@\S+)?\s+(.+)$", text, re.S)
        if not m:
            continue
        rest = m.group(1).split()
        ledger = "business" if "-b" in rest else "platform"
        top = "-n" in rest
        title = " ".join(a for a in rest if a not in ("-b", "-n")).strip()
        if not title:
            continue
        board = Board(ledger)
        task = Task(new_id(LEDGERS[ledger], all_known_ids()), title)
        board.open.insert(0, task) if top else board.open.append(task)
        board.save()
        added.append((task, ledger))
        telegram_reply(chat, f"✓ {task.id}  {task.title}\n{ledger} · "
                             f"{'top of' if top else 'bottom of'} open",
                       msg.get("message_id"))

    if off_path and last > offset:
        with open(off_path, "w") as fh:
            fh.write(str(last))

    if not added:
        print("  nothing queued")
        return
    for task, ledger in added:
        print(f"  {task.id}  {task.title}")
        print(f"  {ledger} · added from telegram")
    print(f"\n  {len(added)} task(s). commit the board to share them.")


# ---------------------------------------------------------------------- reset

MARKER = ".skeleton"


def marker_path():
    return os.path.join(ROOT, MARKER)


def skeleton_nudge():
    """Present until `tm reset` runs. Without it, a new project silently
    inherits the skeleton's task history and `find` returns someone else's
    work as its own prior art."""
    if os.path.exists(marker_path()):
        print("\n  ~ these are the skeleton's own records — `tm reset` if you cloned"
              "\n    this to start a project")


def cmd_reset(args):
    """Destructive, so it is a dry run unless --yes. Clears what is specific to
    a project; keeps what explains the design."""
    boards, sidecars = [], []
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail:
            continue
        n = len(board.doing) + len(board.open) + len(board.recent)
        boards.append((board, n))
        d = os.path.join(ROOT, ledger, "tasks")
        if os.path.isdir(d):
            sidecars += [
                os.path.join(d, f) for f in sorted(os.listdir(d))
                if f.endswith(".md") and not f.startswith("_")
            ]
    rows = len(history_rows())
    decisions = []
    dec_dir = os.path.join(os.path.dirname(ROOT), "notes", "decisions")
    if "--all" in args and os.path.isdir(dec_dir):
        decisions = [
            os.path.join(dec_dir, f) for f in sorted(os.listdir(dec_dir))
            if f.startswith("DEC-")
        ]

    print("  clears:")
    for board, n in boards:
        print(f"    {board.ledger} board — {n} task line(s)")
    print(f"    history.tsv — {rows} row(s)")
    print(f"    sidecars — {len(sidecars)} file(s)")
    if decisions:
        print(f"    decisions — {len(decisions)} file(s)")
    print("\n  keeps: ontology, principles, templates, tm, hooks" +
          ("" if decisions else ", decisions"))
    if not decisions:
        print("    (decisions explain why the design is what it is — `--all` to drop them too)")

    if "--yes" not in args:
        print("\n  dry run. pass --yes to apply.")
        return

    for board, _ in boards:
        board.doing, board.open, board.recent = [], [], []
        board.save()
    with open(HISTORY, "w") as fh:
        fh.write("#date\tid\tledger\ttitle\n")
    for path in sidecars + decisions:
        os.remove(path)
    if os.path.exists(marker_path()):
        os.remove(marker_path())
    print("\n  ✓ reset. the boards are yours now.")


# --------------------------------------------------------------------- checks
#
# `check` is not a fifth skill — it mutates nothing. It is the validator the
# hooks and CI both call, so the same rules run everywhere (PLT-001).


class Report:
    def __init__(self):
        self.errors, self.warnings = [], []

    def error(self, msg):
        self.errors.append(msg)

    def warn(self, msg):
        self.warnings.append(msg)

    def emit(self):
        for w in self.warnings:
            print(f"  ~ {w}")
        for e in self.errors:
            print(f"  ! {e}", file=sys.stderr)
        return 1 if self.errors else 0


def git(*args, cwd=None):
    try:
        out = subprocess.run(
            ["git", *args], cwd=cwd or os.path.dirname(ROOT),
            capture_output=True, text=True, timeout=10,
        )
        return out.stdout if out.returncode == 0 else ""
    except Exception:
        return ""


def check_boards(rep):
    seen = {}
    for row in history_rows():
        if row["id"] in seen:
            rep.error(f"{row['id']} appears twice in history.tsv")
        seen[row["id"]] = "history"
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail as exc:
            rep.error(str(exc))
            continue
        if len(board.doing) > 1:
            ids = ", ".join(t.id for t in board.doing)
            rep.error(f"{ledger}: {len(board.doing)} tasks in doing ({ids}) — WIP is 1")
        if len(board.recent) > WINDOW:
            rep.error(f"{ledger}: recent holds {len(board.recent)}, max is {WINDOW}")
        dates = [t.done_on for t in board.recent]
        if dates != sorted(dates, reverse=True):
            rep.error(f"{ledger}: recent is not newest-first")
        live = {t.id for t in board.doing + board.open}
        for task in board.doing + board.open + board.recent:
            if not ID_RE.match(task.id):
                rep.error(f"{ledger}: malformed id {task.id!r}")
            where = seen.get(task.id)
            if where and not (where == "history" and task in board.recent):
                rep.error(
                    f"{task.id} appears twice on the {ledger} board"
                    if where.endswith("board")
                    else f"{task.id} is on the {ledger} board but already in {where}"
                )
            elif where is None:
                seen[task.id] = f"{ledger} board"
            b = task.blocker
            if b and b not in live and b not in seen:
                rep.error(f"{task.id} is blocked by {b}, which does not exist")
            if task.has_detail and not sidecar_path(ledger, task.id):
                rep.error(f"{task.id} is tagged detail but has no sidecar")


def check_sidecars(rep):
    for ledger in LEDGERS:
        d = os.path.join(ROOT, ledger, "tasks")
        if not os.path.isdir(d):
            continue
        try:
            board = Board(ledger)
        except Fail:
            continue
        tagged = {t.id for t in board.doing + board.open if t.has_detail}
        closed = {t.id for t in board.recent} | {r["id"] for r in history_rows()}
        for name in sorted(os.listdir(d)):
            if not name.endswith(".md") or name.startswith("_"):
                continue
            tid = name.split("-")[0] + "-" + name.split("-")[1]
            with open(os.path.join(d, name)) as fh:
                head = fh.read(400)
            m = re.search(r"^id:\s*(\S+)", head, re.M)
            if m and m.group(1) != tid:
                rep.error(f"{name}: frontmatter id {m.group(1)} does not match filename")
            if tid not in tagged and tid not in closed:
                rep.error(f"{name}: no board line tagged detail, and not completed")


def frontmatter_field(text, field):
    m = re.search(rf"^{field}:\s*(.*)$", text, re.M)
    return m.group(1).strip() if m else ""


def check_decisions(rep, root):
    """A decision is superseded, never rewritten. Typo-level edits pass; the
    threshold is deliberately generous — this catches rewrites, not tidying."""
    import difflib

    changed = git("diff", "--cached", "--name-only", "--", "notes/decisions/").split()
    for path in changed:
        old = git("show", f"HEAD:{path}")
        if not old:
            continue  # newly added
        full = os.path.join(root, path)
        if not os.path.exists(full):
            continue
        with open(full) as fh:
            new = fh.read()
        if frontmatter_field(old, "superseded_by") != frontmatter_field(new, "superseded_by"):
            continue
        if frontmatter_field(old, "status") != frontmatter_field(new, "status"):
            continue
        a, b = old.split(), new.split()
        sm = difflib.SequenceMatcher(None, a, b)
        moved = sum(
            max(i2 - i1, j2 - j1)
            for tag, i1, i2, j1, j2 in sm.get_opcodes() if tag != "equal"
        )
        if moved > 25:
            rep.error(
                f"{path}: {moved} words changed without superseding it. "
                "Write a new decision that supersedes this one."
            )


def check_ontology_currency(rep, root):
    """New files under platform/ suggest a new concept. Only *added* files are
    considered — warning on every modification would be noise, and a noisy hook
    gets bypassed, taking every other check with it. Warns, never blocks."""
    added = git("diff", "--cached", "--name-only", "--diff-filter=A", "--", "platform/").split()
    if not added:
        return
    touched = git("diff", "--cached", "--name-only", "--", "ontology/domain/").split()
    if touched:
        return
    rep.warn(
        f"{len(added)} new file(s) under platform/ but ontology/domain/ is unchanged — "
        "add or update the concept if this introduced one"
    )


def check_untracked_work(rep, root):
    """Work landing with no task is the drift that makes the board useless.

    Warns rather than blocks, because commit time is already too late — the
    work is done. The real catch is the agent creating the task when the user
    says "let's build X". This is only the backstop."""
    touched = git("diff", "--cached", "--name-only", "--", "platform/").split()
    if not touched:
        return
    for ledger in LEDGERS:
        try:
            if Board(ledger).doing:
                return
        except Fail:
            pass
    rep.warn(
        f"{len(touched)} file(s) under platform/ changed with no task in doing — "
        "`tm add <title>` then `tm go` if this was real work"
    )


def check_trailer(rep, msg_path):
    with open(msg_path) as fh:
        msg = fh.read()
    known = {r["id"] for r in history_rows()}
    for ledger in LEDGERS:
        try:
            known |= Board(ledger).all_ids()
        except Fail:
            pass
    for tid in re.findall(r"\bcloses\s+([A-Z]{3}-\S+)", msg):
        if tid.rstrip(".,;") not in known:
            rep.error(
                f'commit message says "closes {tid}" but no such task exists — '
                "the trailer is the only link between task and commit"
            )


def check_nudge(rep, root):
    for ledger in LEDGERS:
        try:
            board = Board(ledger)
        except Fail:
            continue
        for task in board.doing:
            rep.warn(f"{task.id} still in doing — run `tm done {task.id}` if that finished it")


# `--no-verify` skips pre-commit and commit-msg but NOT post-commit. So the
# trace cannot be "post-commit records success" — that would run on bypassed
# commits too, erasing the evidence. Instead pre-commit drops a token and
# post-commit checks whether it is there and fresh. Freshness rather than
# sha-matching, because --amend and merges legitimately change the parent.
TOKEN = "tm-precommit"
BYPASSED = "tm-bypassed"
TOKEN_TTL = 120  # seconds


def _gitpath(root, name):
    gitdir = (git("rev-parse", "--git-dir") or "").strip()
    return os.path.join(root, gitdir, name) if gitdir else None


def check_bypass(rep, root):
    """Report the standing trace, then arm the token for this commit."""
    log = _gitpath(root, BYPASSED)
    if log and os.path.exists(log):
        with open(log) as fh:
            shas = [s for s in fh.read().split() if s]
        if shas:
            recent = " ".join(s[:7] for s in shas[-3:])
            rep.warn(
                f"{len(shas)} commit(s) bypassed these checks ({recent}) — "
                f"run `tm check`, then clear .git/{BYPASSED}"
            )
    token = _gitpath(root, TOKEN)
    if token:
        with open(token, "w") as fh:
            fh.write((git("rev-parse", "HEAD") or "root").strip())


def record_verified(root):
    """post-commit: was this commit validated, or did it skip the gate?"""
    import time

    token, log = _gitpath(root, TOKEN), _gitpath(root, BYPASSED)
    if not token:
        return
    fresh = os.path.exists(token) and os.path.getmtime(token) > time.time() - TOKEN_TTL
    if os.path.exists(token):
        os.remove(token)
    if not fresh and log:
        head = (git("rev-parse", "HEAD") or "").strip()
        if head:
            with open(log, "a") as fh:
                fh.write(head + "\n")
            print(f"  ~ this commit skipped validation — recorded in .git/{BYPASSED}")


def check_telegram():
    """Setup helper. Walks the two-step configuration rather than just failing,
    because the chat id is the part nobody can guess."""
    import json

    load_env()
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat = os.environ.get("TELEGRAM_CHAT_ID")
    env = os.path.join(os.path.dirname(ROOT), ".env")

    if not token:
        print("  no TELEGRAM_BOT_TOKEN set.\n")
        print("  1. message @BotFather in Telegram, send /newbot")
        print("  2. pick a display name, then a username ending in 'bot'")
        print(f"  3. put the token it gives you in {env}:\n")
        print("       TELEGRAM_BOT_TOKEN=8123456789:AAH...")
        return 1

    try:
        with urllib.request.urlopen(
            f"https://api.telegram.org/bot{token}/getUpdates", timeout=10
        ) as fh:
            data = json.load(fh)
    except (urllib.error.URLError, OSError) as exc:
        print(f"  ! could not reach Telegram: {exc}")
        return 1
    if not data.get("ok"):
        print(f"  ! Telegram rejected the token: {data.get('description')}")
        return 1

    chats = {}
    for upd in data.get("result", []):
        c = (upd.get("message") or upd.get("channel_post") or {}).get("chat")
        if c:
            chats[c["id"]] = c.get("title") or c.get("username") or c.get("first_name", "?")

    if not chat:
        print("  token works. no TELEGRAM_CHAT_ID set yet.\n")
        if chats:
            print("  chats that have messaged this bot:")
            for cid, name in chats.items():
                print(f"    {cid:<16} {name}")
            print(f"\n  add the one you want to {env}:\n")
            print(f"       TELEGRAM_CHAT_ID={list(chats)[0]}")
        else:
            print("  no messages seen yet. Add the bot to your group and send")
            print("  /start@yourbotname — group privacy hides ordinary messages")
            print("  from bots until they are addressed. Then run this again.")
        return 1

    task = Task("TEST", "taskman is wired up", done_on=date.today().isoformat())
    if notify(task, "setup"):
        print(f"  ✓ sent a test message to {chats.get(int(chat), chat)}")
        return 0
    print("  ! send failed — check TELEGRAM_CHAT_ID is right")
    return 1


def cmd_check(args):
    if "--telegram" in args:
        sys.exit(check_telegram())
    root = os.path.dirname(ROOT)
    rep = Report()
    if "--msg" in args:
        check_trailer(rep, args[args.index("--msg") + 1])
    elif "--nudge" in args:
        check_nudge(rep, root)
        record_verified(root)
    else:
        check_boards(rep)
        check_sidecars(rep)
        if "--staged" in args:
            check_bypass(rep, root)
            check_decisions(rep, root)
            check_untracked_work(rep, root)
            check_ontology_currency(rep, root)
    code = rep.emit()
    if code == 0 and not rep.warnings and "--quiet" not in args:
        print("  ✓ records consistent")
    sys.exit(code)


USAGE = """tm — taskman

  tm add [-b] [-n] <title...>   create a task (-b business, -n top of order)
  tm go [id]                    show the current task, or start the next one
  tm done [id] [--force]        complete it, then commit with "closes <id>"
  tm find <term>                search every task ever completed

  tm inbox                      pull /add messages from Telegram into tasks
  tm check [--staged]           validate records; used by hooks and CI
  tm check --telegram           test/announce notification setup
  tm reset [--yes] [--all]      clear task records when adopting the skeleton

Listing is reading the board; reordering is moving a line in it.
Model: taskman/ontology.md"""


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    commands = {
        "add": cmd_add, "go": cmd_go, "done": cmd_done, "find": cmd_find,
        "check": cmd_check, "reset": cmd_reset, "inbox": cmd_inbox,
    }
    cmd = commands.get(argv[0])
    if not cmd:
        print(f"unknown command: {argv[0]}\n\n{USAGE}", file=sys.stderr)
        return 2
    try:
        cmd(argv[1:])
    except Fail as exc:
        print(f"  ! {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
